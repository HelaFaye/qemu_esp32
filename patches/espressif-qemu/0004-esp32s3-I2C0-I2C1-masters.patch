diff --git a/include/hw/i2c/esp32s3_i2c.h b/include/hw/i2c/esp32s3_i2c.h
new file mode 100644
index 0000000..b070e05
--- /dev/null
+++ b/include/hw/i2c/esp32s3_i2c.h
@@ -0,0 +1,39 @@
+/*
+ * ESP32-S3 I2C controllers (I2C0 at 0x60013000, I2C1 at 0x60027000), master mode.
+ * Each has an I2C bus, "i2c0" or "i2c1": -device <model>,bus=i2c0,address=0x..
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/i2c/i2c.h"
+
+#define TYPE_ESP32S3_I2C "esp32s3.i2c"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3I2CState, ESP32S3_I2C)
+
+#define ESP32S3_I2C_REGS        0x200
+#define ESP32S3_I2C_FIFO_LEN    32
+#define ESP32S3_I2C_CMDS        8
+
+struct ESP32S3I2CState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    I2CBus *bus;
+    qemu_irq irq;
+    QEMUTimer *timer;
+    uint32_t port;
+
+    uint32_t regs[0x100 / 4];   /* Timing registers, kept as written */
+    uint32_t scl_low, ctr, to, slave_addr, fifo_conf, scl_high, clk_conf;
+    uint32_t int_raw, int_ena, pending_int;
+    uint32_t comd[ESP32S3_I2C_CMDS];
+    uint8_t tx_fifo[ESP32S3_I2C_FIFO_LEN], rx_fifo[ESP32S3_I2C_FIFO_LEN];
+    uint32_t tx_head, tx_count, rx_head, rx_count;
+    uint32_t next_cmd;
+    bool in_transfer, reading, running, want_address;
+    int last_ack;               /* SR.RESP_REC: the last ACK level seen */
+};
diff --git a/tests/qtest/esp32s3-i2c-test.c b/tests/qtest/esp32s3-i2c-test.c
new file mode 100644
index 0000000..1e301c4
--- /dev/null
+++ b/tests/qtest/esp32s3-i2c-test.c
@@ -0,0 +1,155 @@
+/*
+ * QTest for the ESP32-S3 I2C controller: a TMP105 and an AT24C EEPROM on i2c0, driven as
+ * ESP-IDF's i2c_master driver does (command list, FIFO, interrupts).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qapi/qmp/qdict.h"
+#include "libqtest.h"
+
+#define I2C0            0x60013000
+#define I2C_SCL_LOW     (I2C0 + 0x00)
+#define I2C_CTR         (I2C0 + 0x04)
+#define I2C_SR          (I2C0 + 0x08)
+#define I2C_FIFO_CONF   (I2C0 + 0x18)
+#define I2C_DATA        (I2C0 + 0x1C)
+#define I2C_INT_RAW     (I2C0 + 0x20)
+#define I2C_INT_CLR     (I2C0 + 0x24)
+#define I2C_INT_ENA     (I2C0 + 0x28)
+#define I2C_SCL_HIGH    (I2C0 + 0x38)
+#define I2C_CLK_CONF    (I2C0 + 0x54)
+#define I2C_COMD(n)     (I2C0 + 0x58 + 4 * (n))
+
+#define CTR_MS_MODE     BIT(4)
+#define CTR_TRANS_START BIT(5)
+#define CTR_CONF_UPGATE BIT(11)
+
+#define INT_END_DETECT      BIT(3)
+#define INT_TRANS_COMPLETE  BIT(7)
+#define INT_NACK            BIT(10)
+
+#define INTMATRIX_STATUS1   0x600C2190      /* Sources 32-63 */
+#define I2C0_SOURCE         42
+
+#define CMD(op, n, ack_check, ack_val) ((op) << 11 | (ack_val) << 10 | (ack_check) << 8 | (n))
+#define RSTART          CMD(6, 0, 0, 0)
+#define WRITE(n)        CMD(1, n, 1, 0)
+#define READ(n, last)   CMD(3, n, 0, last)
+#define STOP            CMD(2, 0, 0, 0)
+#define END             CMD(4, 0, 0, 0)
+
+#define TMP105          0x48
+#define EEPROM          0x50
+
+static QTestState *start(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3 "
+                                 "-device tmp105,bus=i2c0,address=0x48,id=temp "
+                                 "-device at24c-eeprom,bus=i2c0,address=0x50,rom-size=256");
+    /* 100 kHz from XTAL: 40 MHz / 1, 200 + 200 cycles */
+    qtest_writel(qts, I2C_CLK_CONF, BIT(21));
+    qtest_writel(qts, I2C_SCL_LOW, 199);
+    qtest_writel(qts, I2C_SCL_HIGH, 199);
+    qtest_writel(qts, I2C_CTR, CTR_MS_MODE | CTR_CONF_UPGATE);
+    qtest_writel(qts, I2C_FIFO_CONF, BIT(12) | BIT(13));     /* Reset both FIFOs */
+    qtest_writel(qts, I2C_FIFO_CONF, 0);
+    return qts;
+}
+
+static uint32_t go(QTestState *qts, const uint32_t *cmds, int n)
+{
+    for (int i = 0; i < n; i++) {
+        qtest_writel(qts, I2C_COMD(i), cmds[i]);
+    }
+    qtest_writel(qts, I2C_INT_CLR, 0x3FFFF);
+    qtest_writel(qts, I2C_CTR, CTR_MS_MODE | CTR_TRANS_START);
+    qtest_clock_step(qts, 50 * 1000 * 1000);
+    return qtest_readl(qts, I2C_INT_RAW);
+}
+
+static void test_tmp105(void)
+{
+    QTestState *qts = start();
+    qobject_unref(qtest_qmp(qts, "{'execute': 'qom-set', 'arguments': {'path': '/machine/peripheral/temp', 'property': 'temperature', 'value': 31250}}"));
+
+    /* i2c_master_transmit_receive: pointer 0, repeated start, 2 bytes */
+    qtest_writel(qts, I2C_DATA, TMP105 << 1);
+    qtest_writel(qts, I2C_DATA, 0x00);
+    qtest_writel(qts, I2C_DATA, TMP105 << 1 | 1);
+    const uint32_t cmds[] = { RSTART, WRITE(2), RSTART, WRITE(1), READ(1, 0), READ(1, 1), STOP };
+    qtest_writel(qts, I2C_INT_ENA, INT_TRANS_COMPLETE | INT_NACK);
+    uint32_t raw = go(qts, cmds, 7);
+    g_assert_cmphex(raw & (INT_TRANS_COMPLETE | INT_NACK), ==, INT_TRANS_COMPLETE);
+    g_assert_true(qtest_readl(qts, INTMATRIX_STATUS1) & BIT(I2C0_SOURCE - 32));
+    g_assert_cmpint((qtest_readl(qts, I2C_SR) >> 8) & 0x3F, ==, 2);
+    uint8_t hi = qtest_readl(qts, I2C_DATA), lo = qtest_readl(qts, I2C_DATA);
+    /* 31.25 C, 12 bits at power-up resolution 9 bits: 0x1F40 masked to 0x1F00 */
+    g_assert_cmphex(hi, ==, 0x1F);
+    g_assert_cmphex(lo & 0x80, ==, 0x00);
+    g_assert_cmphex(qtest_readl(qts, I2C_COMD(6)) >> 31, ==, 1);    /* STOP done */
+    qtest_writel(qts, I2C_INT_CLR, 0x3FFFF);
+    g_assert_false(qtest_readl(qts, INTMATRIX_STATUS1) & BIT(I2C0_SOURCE - 32));
+    qtest_quit(qts);
+}
+
+static void test_nack(void)
+{
+    QTestState *qts = start();
+
+    /* i2c_master_probe of an empty address */
+    qtest_writel(qts, I2C_DATA, 0x3C << 1);
+    const uint32_t cmds[] = { RSTART, WRITE(1), STOP };
+    uint32_t raw = go(qts, cmds, 3);
+    g_assert_cmphex(raw & INT_NACK, ==, INT_NACK);
+    g_assert_cmphex(qtest_readl(qts, I2C_SR) & 1, ==, 1);          /* RESP_REC: NACK */
+
+    /* And one that's there */
+    qtest_writel(qts, I2C_DATA, TMP105 << 1);
+    raw = go(qts, cmds, 3);
+    g_assert_cmphex(raw & (INT_NACK | INT_TRANS_COMPLETE), ==, INT_TRANS_COMPLETE);
+    qtest_quit(qts);
+}
+
+static void test_eeprom_long_write(void)
+{
+    QTestState *qts = start();
+
+    /* 40 bytes at offset 16: more than the FIFO, so END, refill, go on (as the driver does) */
+    qtest_writel(qts, I2C_DATA, EEPROM << 1);
+    qtest_writel(qts, I2C_DATA, 16);
+    for (int i = 0; i < 30; i++) {
+        qtest_writel(qts, I2C_DATA, 0xA0 + i);
+    }
+    const uint32_t first[] = { RSTART, WRITE(32), END };
+    g_assert_cmphex(go(qts, first, 3) & (INT_END_DETECT | INT_NACK), ==, INT_END_DETECT);
+    for (int i = 30; i < 40; i++) {
+        qtest_writel(qts, I2C_DATA, 0xA0 + i);
+    }
+    const uint32_t second[] = { WRITE(10), STOP };
+    g_assert_cmphex(go(qts, second, 2) & (INT_TRANS_COMPLETE | INT_NACK), ==, INT_TRANS_COMPLETE);
+
+    /* Read them back */
+    qtest_writel(qts, I2C_DATA, EEPROM << 1);
+    qtest_writel(qts, I2C_DATA, 16);
+    qtest_writel(qts, I2C_DATA, EEPROM << 1 | 1);
+    const uint32_t rd[] = { RSTART, WRITE(2), RSTART, WRITE(1), READ(29, 0), READ(1, 1), END };
+    g_assert_cmphex(go(qts, rd, 7) & INT_END_DETECT, ==, INT_END_DETECT);
+    for (int i = 0; i < 30; i++) {
+        g_assert_cmphex(qtest_readl(qts, I2C_DATA), ==, 0xA0 + i);
+    }
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/i2c/tmp105", test_tmp105);
+    qtest_add_func("/esp32s3/i2c/nack", test_nack);
+    qtest_add_func("/esp32s3/i2c/eeprom_long_write", test_eeprom_long_write);
+    return g_test_run();
+}
