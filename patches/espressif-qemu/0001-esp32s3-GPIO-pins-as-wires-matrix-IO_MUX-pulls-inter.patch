 #include "hw/sysbus.h"
 #include "hw/hw.h"
 #include "hw/registerfields.h"
-#include "esp32_gpio.h"
 
 #define TYPE_ESP32S3_GPIO "esp32s3.gpio"
-#define ESP32S3_GPIO(obj)           OBJECT_CHECK(ESP32S3GPIOState, (obj), TYPE_ESP32S3_GPIO)
-#define ESP32S3_GPIO_GET_CLASS(obj) OBJECT_GET_CLASS(ESP32S3GPIOClass, obj, TYPE_ESP32S3_GPIO)
-#define ESP32S3_GPIO_CLASS(klass)   OBJECT_CLASS_CHECK(ESP32S3GPIOClass, klass, TYPE_ESP32S3_GPIO)
+#define ESP32S3_GPIO(obj) OBJECT_CHECK(ESP32S3GPIOState, (obj), TYPE_ESP32S3_GPIO)
 
 /* Bootstrap options for ESP32-S3 (4-bit) */
 #define ESP32S3_STRAP_MODE_FLASH_BOOT 0x4   /* SPI Boot */
 
-typedef struct ESP32S3State {
-    Esp32GpioState parent;
-} ESP32S3GPIOState;
+#define ESP32S3_GPIO_PINS         49
+#define ESP32S3_GPIO_SIGNALS      256
+#define ESP32S3_GPIO_OUT_SEL_GPIO 256       /* FUNC_OUT_SEL_CFG: the GPIO_OUT register */
+
+#define ESP32S3_GPIO_PIN_IN   "pin-in"
+#define ESP32S3_GPIO_PIN_OUT  "pin-out"
+#define ESP32S3_GPIO_SIG_OUT  "sig-out"
+
+typedef struct ESP32S3GPIOState {
+    SysBusDevice parent_obj;
 
-typedef struct ESP32S3GPIOClass {
-    Esp32GpioClass parent;
-} ESP32S3GPIOClass;
+    MemoryRegion iomem;
+    MemoryRegion iomux;
+    qemu_irq irq;                               /* ETS_GPIO_INTR_SOURCE */
+    qemu_irq pin_out[ESP32S3_GPIO_PINS];
+
+    uint32_t strap_mode;
+
+    uint64_t out;                               /* OUT (pins 0-31) and OUT1 (32-48) */
+    uint64_t enable;
+    uint64_t status;
+    uint64_t ext_driven;                        /* Pins driven from outside... */
+    uint64_t ext_level;                         /* ...and their levels */
+    uint64_t level;                             /* Each pin's current level */
+    uint8_t sig_out[ESP32S3_GPIO_SIGNALS];      /* Peripheral output signals */
+    uint32_t pin[ESP32S3_GPIO_PINS];            /* PINn: interrupt type and enable, driver */
+    uint32_t func_out_sel[ESP32S3_GPIO_PINS];
+    uint32_t func_in_sel[ESP32S3_GPIO_SIGNALS];
+    uint32_t iomux_regs[ESP32S3_GPIO_PINS];
+    uint32_t iomux_pin_ctrl;
+    uint32_t bt_select, sdio_select, clock_gate;
