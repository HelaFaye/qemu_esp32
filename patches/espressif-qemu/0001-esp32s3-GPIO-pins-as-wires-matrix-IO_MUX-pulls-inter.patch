From daa6af0e44c501821b8b225a20527f7e98e6a57c Mon Sep 17 00:00:00 2001
From: HelaFaye <dilsha21@gmail.com>
Date: Tue, 10 Nov 2026 05:25:03 +0000
Subject: [PATCH 01/12] esp32s3: GPIO pins as wires: matrix, IO_MUX pulls,
 interrupts

The S3's GPIO was register loopback: no pin levels, no IO_MUX (an unimp
device), no interrupt line. Now each of the 49 pins has a level: the
chip's output (GPIO_OUT or a peripheral signal through FUNC_OUT_SEL_CFG,
inverted, push-pull or open drain), else an external drive, else the
IO_MUX pull. IN/IN1 read it (0 with FUN_IE clear). PINn edge and level
interrupts set STATUS, PCPU_INT gates them, and the line goes to
ETS_GPIO_INTR_SOURCE.

Named GPIO lines let boards and tests wire devices to pins: pin-in
(drive a pin), pin-out (a pin's level), sig-out (peripheral signals).
---
 hw/gpio/esp32s3_gpio.c          | 386 +++++++++++++++++++++++++++++++-
 hw/xtensa/esp32s3.c             |   5 +-
 include/hw/gpio/esp32s3_gpio.h  |  58 ++++-
 tests/qtest/esp32s3-gpio-test.c | 196 ++++++++++++++++
 tests/qtest/meson.build         |   2 +-
 5 files changed, 626 insertions(+), 21 deletions(-)
 create mode 100644 tests/qtest/esp32s3-gpio-test.c

diff --git a/hw/gpio/esp32s3_gpio.c b/hw/gpio/esp32s3_gpio.c
index 0a0e477..548c928 100644
--- a/hw/gpio/esp32s3_gpio.c
+++ b/hw/gpio/esp32s3_gpio.c
@@ -1,5 +1,12 @@
 /*
- * ESP32-S3 GPIO emulation
+ * ESP32-S3 GPIO, GPIO matrix and IO_MUX emulation
+ *
+ * Pins 0-48: output and output enable (GPIO_OUT or a peripheral signal through the GPIO
+ * matrix, inverted or not, push-pull or open drain), inputs (driven from outside, looped
+ * back from the output, or the pull resistor's level; read as 0 with the input disabled),
+ * interrupts on edges or levels (PINn), and the IO_MUX's pull and input-enable bits.
+ * Register layout: ESP32-S3 TRM, chapter "IO MUX and GPIO Matrix"; ESP-IDF's
+ * soc/esp32s3/register/soc/gpio_reg.h and io_mux_reg.h.
  *
  * Copyright (c) 2023 Espressif Systems (Shanghai) Co. Ltd.
  *
@@ -10,35 +17,396 @@
 
 #include "qemu/osdep.h"
 #include "qemu/log.h"
-#include "qemu/error-report.h"
 #include "qapi/error.h"
 #include "hw/hw.h"
 #include "hw/sysbus.h"
-#include "hw/registerfields.h"
 #include "hw/irq.h"
 #include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
 #include "hw/gpio/esp32s3_gpio.h"
 
+#define PINS            ESP32S3_GPIO_PINS
+#define PIN_MASK        ((1ULL << PINS) - 1)
+
+/* GPIO registers */
+#define A_BT_SELECT         0x000
+#define A_OUT               0x004
+#define A_OUT_W1TS          0x008
+#define A_OUT_W1TC          0x00C
+#define A_OUT1              0x010
+#define A_OUT1_W1TS         0x014
+#define A_OUT1_W1TC         0x018
+#define A_SDIO_SELECT       0x01C
+#define A_ENABLE            0x020
+#define A_ENABLE_W1TS       0x024
+#define A_ENABLE_W1TC       0x028
+#define A_ENABLE1           0x02C
+#define A_ENABLE1_W1TS      0x030
+#define A_ENABLE1_W1TC      0x034
+#define A_STRAP             0x038
+#define A_IN                0x03C
+#define A_IN1               0x040
+#define A_STATUS            0x044
+#define A_STATUS_W1TS       0x048
+#define A_STATUS_W1TC       0x04C
+#define A_STATUS1           0x050
+#define A_STATUS1_W1TS      0x054
+#define A_STATUS1_W1TC      0x058
+#define A_PCPU_INT          0x05C
+#define A_PCPU_NMI_INT      0x060
+#define A_CPUSDIO_INT       0x064
+#define A_PCPU_INT1         0x068
+#define A_PCPU_NMI_INT1     0x06C
+#define A_CPUSDIO_INT1      0x070
+#define A_PIN0              0x074
+#define A_PIN48             0x134
+#define A_STATUS_NEXT       0x14C
+#define A_STATUS_NEXT1      0x150
+#define A_FUNC0_IN_SEL      0x154
+#define A_FUNC255_IN_SEL    0x550
+#define A_FUNC0_OUT_SEL     0x554
+#define A_FUNC48_OUT_SEL    0x614
+#define A_CLOCK_GATE        0x62C
+#define A_DATE              0x6FC
+#define GPIO_DATE_VALUE     0x1907040
+
+/* PINn */
+#define PIN_PAD_DRIVER      BIT(2)          /* Open drain */
+#define PIN_INT_TYPE(v)     (((v) >> 7) & 0x7)
+#define PIN_INT_ENA(v)      (((v) >> 13) & 0x1F)
+#define INT_ENA_CPU         BIT(0)          /* Both CPUs, through PCPU_INT */
+#define INT_ENA_NMI         BIT(1)
+
+enum { INT_DISABLED, INT_POSEDGE, INT_NEGEDGE, INT_ANYEDGE, INT_LOW_LEVEL, INT_HIGH_LEVEL };
+
+/* FUNCn_OUT_SEL_CFG */
+#define OUT_SEL(v)          ((v) & 0x1FF)
+#define OUT_INV_SEL         BIT(9)
+#define OEN_SEL             BIT(10)         /* Output enable from GPIO_ENABLE, not the peripheral */
+#define OEN_INV_SEL         BIT(11)
+
+/* IO_MUX: GPIOn at 0x04 + 4 * n */
+#define IOMUX_PIN0          0x04
+#define FUN_PD              BIT(7)
+#define FUN_PU              BIT(8)
+#define FUN_IE              BIT(9)
+#define IOMUX_RESET         (FUN_IE | (2 << 10))     /* Input on, drive strength 2 */
+
+static bool pin_output_enabled(ESP32S3GPIOState *s, int n)
+{
+    uint32_t sel = s->func_out_sel[n];
+    bool oe;
+    if (OUT_SEL(sel) == ESP32S3_GPIO_OUT_SEL_GPIO || (sel & OEN_SEL)) {
+        oe = (s->enable >> n) & 1;
+    } else {
+        oe = true;              /* The peripheral drives the pin (it enables its output) */
+    }
+    if (sel & OEN_INV_SEL) {
+        oe = !oe;
+    }
+    return oe;
+}
+
+static int pin_output_value(ESP32S3GPIOState *s, int n)
+{
+    uint32_t sel = s->func_out_sel[n];
+    int v;
+    if (OUT_SEL(sel) == ESP32S3_GPIO_OUT_SEL_GPIO) {
+        v = (s->out >> n) & 1;
+    } else {
+        v = OUT_SEL(sel) < ESP32S3_GPIO_SIGNALS ? s->sig_out[OUT_SEL(sel)] : 0;
+    }
+    if (sel & OUT_INV_SEL) {
+        v = !v;
+    }
+    return v;
+}
+
+/* The level on the pad: the chip's output, else what drives it from outside, else the pull */
+static int pin_level(ESP32S3GPIOState *s, int n)
+{
+    bool open_drain = s->pin[n] & PIN_PAD_DRIVER;
+    if (pin_output_enabled(s, n)) {
+        int v = pin_output_value(s, n);
+        if (!open_drain || v == 0) {
+            return v;
+        }
+    }
+    if ((s->ext_driven >> n) & 1) {
+        return (s->ext_level >> n) & 1;
+    }
+    if (s->iomux_regs[n] & FUN_PU) {
+        return 1;
+    }
+    return 0;           /* Pulled down, or floating */
+}
+
+static uint64_t input_value(ESP32S3GPIOState *s)
+{
+    uint64_t v = 0;
+    for (int n = 0; n < PINS; n++) {
+        if ((s->iomux_regs[n] & FUN_IE) && ((s->level >> n) & 1)) {
+            v |= 1ULL << n;
+        }
+    }
+    return v;
+}
+
+static uint64_t cpu_int_mask(ESP32S3GPIOState *s, uint32_t which)
+{
+    uint64_t m = 0;
+    for (int n = 0; n < PINS; n++) {
+        if (PIN_INT_ENA(s->pin[n]) & which) {
+            m |= 1ULL << n;
+        }
+    }
+    return m;
+}
+
+static void update_irq(ESP32S3GPIOState *s)
+{
+    uint64_t pending = s->status & cpu_int_mask(s, INT_ENA_CPU | INT_ENA_NMI);
+    qemu_set_irq(s->irq, pending != 0);
+}
+
+/* Level interrupts stay pending as long as the level holds, even after a clear */
+static void latch_levels(ESP32S3GPIOState *s)
+{
+    for (int n = 0; n < PINS; n++) {
+        int type = PIN_INT_TYPE(s->pin[n]);
+        int l = (s->level >> n) & 1;
+        if ((type == INT_LOW_LEVEL && !l) || (type == INT_HIGH_LEVEL && l)) {
+            s->status |= 1ULL << n;
+        }
+    }
+}
+
+/* Recompute every pin's level: wires out, edge interrupts, then the interrupt line */
+static void update_pins(ESP32S3GPIOState *s)
+{
+    for (int n = 0; n < PINS; n++) {
+        int old = (s->level >> n) & 1;
+        int l = pin_level(s, n);
+        if (l == old) {
+            continue;
+        }
+        s->level = (s->level & ~(1ULL << n)) | ((uint64_t)l << n);
+        int type = PIN_INT_TYPE(s->pin[n]);
+        if ((type == INT_POSEDGE && l) || (type == INT_NEGEDGE && !l) || type == INT_ANYEDGE) {
+            s->status |= 1ULL << n;
+        }
+        qemu_set_irq(s->pin_out[n], l);
+    }
+    latch_levels(s);
+    update_irq(s);
+}
+
+static uint64_t esp32s3_gpio_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+
+    if (addr >= A_PIN0 && addr <= A_PIN48) {
+        return s->pin[(addr - A_PIN0) / 4];
+    }
+    if (addr >= A_FUNC0_IN_SEL && addr <= A_FUNC255_IN_SEL) {
+        return s->func_in_sel[(addr - A_FUNC0_IN_SEL) / 4];
+    }
+    if (addr >= A_FUNC0_OUT_SEL && addr <= A_FUNC48_OUT_SEL) {
+        return s->func_out_sel[(addr - A_FUNC0_OUT_SEL) / 4];
+    }
+    switch (addr) {
+    case A_BT_SELECT:       return s->bt_select;
+    case A_OUT:             return (uint32_t)s->out;
+    case A_OUT1:            return (uint32_t)(s->out >> 32);
+    case A_SDIO_SELECT:     return s->sdio_select;
+    case A_ENABLE:          return (uint32_t)s->enable;
+    case A_ENABLE1:         return (uint32_t)(s->enable >> 32);
+    case A_STRAP:           return s->strap_mode;
+    case A_IN:              return (uint32_t)input_value(s);
+    case A_IN1:             return (uint32_t)(input_value(s) >> 32);
+    case A_STATUS:          return (uint32_t)s->status;
+    case A_STATUS1:         return (uint32_t)(s->status >> 32);
+    case A_PCPU_INT:        return (uint32_t)(s->status & cpu_int_mask(s, INT_ENA_CPU));
+    case A_PCPU_NMI_INT:    return (uint32_t)(s->status & cpu_int_mask(s, INT_ENA_NMI));
+    case A_PCPU_INT1:       return (uint32_t)((s->status & cpu_int_mask(s, INT_ENA_CPU)) >> 32);
+    case A_PCPU_NMI_INT1:   return (uint32_t)((s->status & cpu_int_mask(s, INT_ENA_NMI)) >> 32);
+    case A_CPUSDIO_INT:
+    case A_CPUSDIO_INT1:
+    case A_STATUS_NEXT:
+    case A_STATUS_NEXT1:    return 0;
+    case A_CLOCK_GATE:      return s->clock_gate;
+    case A_DATE:            return GPIO_DATE_VALUE;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s: unimplemented register 0x%" HWADDR_PRIx "\n", __func__, addr);
+        return 0;
+    }
+}
+
+#define LO(v)   ((uint64_t)(uint32_t)(v))
+#define HI(v)   ((uint64_t)((uint32_t)(v) & 0x1FFFFF) << 32)    /* Pins 32-48 */
+
+static void esp32s3_gpio_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+
+    if (addr >= A_PIN0 && addr <= A_PIN48) {
+        s->pin[(addr - A_PIN0) / 4] = value;
+        latch_levels(s);
+        update_irq(s);
+        return;
+    }
+    if (addr >= A_FUNC0_IN_SEL && addr <= A_FUNC255_IN_SEL) {
+        s->func_in_sel[(addr - A_FUNC0_IN_SEL) / 4] = value & 0xFF;
+        return;
+    }
+    if (addr >= A_FUNC0_OUT_SEL && addr <= A_FUNC48_OUT_SEL) {
+        s->func_out_sel[(addr - A_FUNC0_OUT_SEL) / 4] = value & 0xFFF;
+        update_pins(s);
+        return;
+    }
+    switch (addr) {
+    case A_BT_SELECT:       s->bt_select = value; return;
+    case A_SDIO_SELECT:     s->sdio_select = value; return;
+    case A_CLOCK_GATE:      s->clock_gate = value; return;
+    case A_OUT:             s->out = (s->out & ~LO(~0u)) | LO(value); break;
+    case A_OUT_W1TS:        s->out |= LO(value); break;
+    case A_OUT_W1TC:        s->out &= ~LO(value); break;
+    case A_OUT1:            s->out = (s->out & LO(~0u)) | HI(value); break;
+    case A_OUT1_W1TS:       s->out |= HI(value); break;
+    case A_OUT1_W1TC:       s->out &= ~HI(value); break;
+    case A_ENABLE:          s->enable = (s->enable & ~LO(~0u)) | LO(value); break;
+    case A_ENABLE_W1TS:     s->enable |= LO(value); break;
+    case A_ENABLE_W1TC:     s->enable &= ~LO(value); break;
+    case A_ENABLE1:         s->enable = (s->enable & LO(~0u)) | HI(value); break;
+    case A_ENABLE1_W1TS:    s->enable |= HI(value); break;
+    case A_ENABLE1_W1TC:    s->enable &= ~HI(value); break;
+    case A_STATUS:          s->status = (s->status & ~LO(~0u)) | LO(value); break;
+    case A_STATUS_W1TS:     s->status |= LO(value); break;
+    case A_STATUS_W1TC:     s->status &= ~LO(value); break;
+    case A_STATUS1:         s->status = (s->status & LO(~0u)) | HI(value); break;
+    case A_STATUS1_W1TS:    s->status |= HI(value); break;
+    case A_STATUS1_W1TC:    s->status &= ~HI(value); break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s: unimplemented register 0x%" HWADDR_PRIx "\n", __func__, addr);
+        return;
+    }
+    update_pins(s);
+}
+
+static const MemoryRegionOps esp32s3_gpio_ops = {
+    .read = esp32s3_gpio_read,
+    .write = esp32s3_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static uint64_t esp32s3_iomux_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+    if (addr == 0) {
+        return s->iomux_pin_ctrl;
+    }
+    int n = (addr - IOMUX_PIN0) / 4;
+    return (addr >= IOMUX_PIN0 && n < PINS) ? s->iomux_regs[n] : 0;
+}
+
+static void esp32s3_iomux_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+    if (addr == 0) {
+        s->iomux_pin_ctrl = value;
+        return;
+    }
+    int n = (addr - IOMUX_PIN0) / 4;
+    if (addr >= IOMUX_PIN0 && n < PINS) {
+        s->iomux_regs[n] = value;
+        update_pins(s);         /* A pull changes an undriven pin's level */
+    }
+}
+
+static const MemoryRegionOps esp32s3_iomux_ops = {
+    .read = esp32s3_iomux_read,
+    .write = esp32s3_iomux_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+/* A level driven onto pin n from outside; anything but 0 or 1 releases the pin */
+static void esp32s3_gpio_pin_in(void *opaque, int n, int level)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+    if (level == 0 || level == 1) {
+        s->ext_driven |= 1ULL << n;
+        s->ext_level = (s->ext_level & ~(1ULL << n)) | ((uint64_t)level << n);
+    } else {
+        s->ext_driven &= ~(1ULL << n);
+    }
+    update_pins(s);
+}
+
+/* A peripheral's output signal (index: the signal number in FUNC_OUT_SEL_CFG) */
+static void esp32s3_gpio_sig_out(void *opaque, int sig, int level)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+    s->sig_out[sig] = level ? 1 : 0;
+    update_pins(s);
+}
+
+static void esp32s3_gpio_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(obj);
+
+    s->out = s->enable = s->status = 0;
+    s->bt_select = s->sdio_select = s->clock_gate = 0;
+    s->iomux_pin_ctrl = 0x7FF;
+    memset(s->pin, 0, sizeof(s->pin));
+    memset(s->func_in_sel, 0, sizeof(s->func_in_sel));
+    for (int n = 0; n < PINS; n++) {
+        s->func_out_sel[n] = ESP32S3_GPIO_OUT_SEL_GPIO;
+        s->iomux_regs[n] = IOMUX_RESET;
+    }
+    /* External drives and peripheral signals are wires: they survive a chip reset */
+    update_pins(s);
+}
 
 static void esp32s3_gpio_init(Object *obj)
 {
-    /* Set the default value for the property */
-    object_property_set_int(obj, "strap_mode", ESP32S3_STRAP_MODE_FLASH_BOOT, &error_fatal);
+    ESP32S3GPIOState *s = ESP32S3_GPIO(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32s3_gpio_ops, s, TYPE_ESP32S3_GPIO, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    memory_region_init_io(&s->iomux, obj, &esp32s3_iomux_ops, s, TYPE_ESP32S3_GPIO ".iomux", 0x2000);
+    sysbus_init_mmio(sbd, &s->iomux);
+    sysbus_init_irq(sbd, &s->irq);
+
+    qdev_init_gpio_in_named(DEVICE(s), esp32s3_gpio_pin_in, ESP32S3_GPIO_PIN_IN, PINS);
+    qdev_init_gpio_out_named(DEVICE(s), s->pin_out, ESP32S3_GPIO_PIN_OUT, PINS);
+    qdev_init_gpio_in_named(DEVICE(s), esp32s3_gpio_sig_out, ESP32S3_GPIO_SIG_OUT, ESP32S3_GPIO_SIGNALS);
 }
 
-/* If we need to override any function from the parent (reset, realize, ...), it shall be done
- * in this class_init function */
+static Property esp32s3_gpio_properties[] = {
+    DEFINE_PROP_UINT32("strap_mode", ESP32S3GPIOState, strap_mode, ESP32S3_STRAP_MODE_FLASH_BOOT),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
 static void esp32s3_gpio_class_init(ObjectClass *klass, void *data)
 {
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    rc->phases.hold = esp32s3_gpio_reset_hold;
+    device_class_set_props(dc, esp32s3_gpio_properties);
 }
 
 static const TypeInfo esp32s3_gpio_info = {
     .name = TYPE_ESP32S3_GPIO,
-    .parent = TYPE_ESP32_GPIO,
+    .parent = TYPE_SYS_BUS_DEVICE,
     .instance_size = sizeof(ESP32S3GPIOState),
     .instance_init = esp32s3_gpio_init,
     .class_init = esp32s3_gpio_class_init,
-    .class_size = sizeof(ESP32S3GPIOClass),
 };
 
 static void esp32s3_gpio_register_types(void)
