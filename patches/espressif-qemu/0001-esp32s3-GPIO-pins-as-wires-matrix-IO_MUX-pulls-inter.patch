diff --git a/tests/qtest/esp32s3-gpio-test.c b/tests/qtest/esp32s3-gpio-test.c
new file mode 100644
index 0000000..c1152ae
--- /dev/null
+++ b/tests/qtest/esp32s3-gpio-test.c
@@ -0,0 +1,196 @@
+/*
+ * QTest for the ESP32-S3 GPIO, GPIO matrix and IO_MUX
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "libqtest.h"
+
+#define GPIO            0x60004000
+#define IO_MUX          0x60009000
+#define OUT             (GPIO + 0x04)
+#define OUT_W1TS        (GPIO + 0x08)
+#define OUT_W1TC        (GPIO + 0x0C)
+#define OUT1_W1TS       (GPIO + 0x14)
+#define ENABLE_W1TS     (GPIO + 0x24)
+#define ENABLE_W1TC     (GPIO + 0x28)
+#define ENABLE1_W1TS    (GPIO + 0x30)
+#define STRAP           (GPIO + 0x38)
+#define IN              (GPIO + 0x3C)
+#define IN1             (GPIO + 0x40)
+#define STATUS          (GPIO + 0x44)
+#define STATUS_W1TC     (GPIO + 0x4C)
+#define STATUS1         (GPIO + 0x50)
+#define PCPU_INT        (GPIO + 0x5C)
+#define PCPU_INT1       (GPIO + 0x68)
+#define PIN(n)          (GPIO + 0x74 + 4 * (n))
+#define OUT_SEL(n)      (GPIO + 0x554 + 4 * (n))
+#define DATE            (GPIO + 0x6FC)
+#define IOMUX(n)        (IO_MUX + 0x04 + 4 * (n))
+
+#define PAD_DRIVER      BIT(2)
+#define INT_TYPE(t)     ((t) << 7)
+#define INT_ENA_CPU     BIT(13)
+#define FUN_PD          BIT(7)
+#define FUN_PU          BIT(8)
+#define FUN_IE          BIT(9)
+
+#define INTMATRIX_CORE0_STATUS  0x600C218C
+#define GPIO_SOURCE             16
+
+static void drive(QTestState *qts, int pin, int level)
+{
+    qtest_set_irq_in(qts, "/machine/soc/gpio", "pin-in", pin, level);
+}
+
+static void sig_out(QTestState *qts, int sig, int level)
+{
+    qtest_set_irq_in(qts, "/machine/soc/gpio", "sig-out", sig, level);
+}
+
+static bool gpio_irq(QTestState *qts)
+{
+    return qtest_readl(qts, INTMATRIX_CORE0_STATUS) & BIT(GPIO_SOURCE);
+}
+
+static void test_reset(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+
+    g_assert_cmphex(qtest_readl(qts, STRAP), ==, 0x4);
+    g_assert_cmphex(qtest_readl(qts, DATE), ==, 0x1907040);
+    g_assert_cmphex(qtest_readl(qts, OUT_SEL(5)), ==, 0x100);
+    g_assert_cmphex(qtest_readl(qts, IOMUX(5)), ==, FUN_IE | (2 << 10));
+    g_assert_cmphex(qtest_readl(qts, IN), ==, 0);
+    g_assert_false(gpio_irq(qts));
+    qtest_quit(qts);
+}
+
+static void test_output_loopback(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+
+    /* An output that isn't enabled doesn't reach the pad */
+    qtest_writel(qts, OUT_W1TS, BIT(4));
+    g_assert_cmphex(qtest_readl(qts, OUT), ==, BIT(4));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(4), ==, 0);
+
+    /* Enabled: the input reads the pad back */
+    qtest_writel(qts, ENABLE_W1TS, BIT(4));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(4), ==, BIT(4));
+    qtest_writel(qts, OUT_W1TC, BIT(4));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(4), ==, 0);
+
+    /* Pins 32-48 */
+    qtest_writel(qts, ENABLE1_W1TS, BIT(48 - 32));
+    qtest_writel(qts, OUT1_W1TS, BIT(48 - 32));
+    g_assert_cmphex(qtest_readl(qts, IN1), ==, BIT(48 - 32));
+
+    /* The input disabled in the IO_MUX reads 0 */
+    qtest_writel(qts, IOMUX(48), 0);
+    g_assert_cmphex(qtest_readl(qts, IN1), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_external_and_pulls(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+
+    drive(qts, 15, 1);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(15), ==, BIT(15));
+    drive(qts, 15, 0);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(15), ==, 0);
+
+    /* Released: the pull-up decides (a button to ground with INPUT_PULLUP) */
+    drive(qts, 15, -1);
+    qtest_writel(qts, IOMUX(15), FUN_IE | FUN_PU);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(15), ==, BIT(15));
+    qtest_writel(qts, IOMUX(15), FUN_IE | FUN_PD);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(15), ==, 0);
+
+    /* Open drain: the chip can only pull low; an external low wins over a released high */
+    qtest_writel(qts, IOMUX(9), FUN_IE | FUN_PU);
+    qtest_writel(qts, PIN(9), PAD_DRIVER);
+    qtest_writel(qts, ENABLE_W1TS, BIT(9));
+    qtest_writel(qts, OUT_W1TS, BIT(9));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(9), ==, BIT(9));
+    drive(qts, 9, 0);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(9), ==, 0);
+    drive(qts, 9, -1);
+    qtest_writel(qts, OUT_W1TC, BIT(9));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(9), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_matrix(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+
+    /* Peripheral signal 101 to pin 11, inverted; output enable from the peripheral */
+    qtest_writel(qts, OUT_SEL(11), 101 | BIT(9));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(11), ==, BIT(11));
+    sig_out(qts, 101, 1);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(11), ==, 0);
+
+    /* Output enable from GPIO_ENABLE instead (OEN_SEL) */
+    qtest_writel(qts, OUT_SEL(11), 101 | BIT(10));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(11), ==, 0);    /* Not enabled, floating */
+    qtest_writel(qts, ENABLE_W1TS, BIT(11));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(11), ==, BIT(11));
+    qtest_quit(qts);
+}
+
+static void test_interrupts(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+
+    /* Falling edge on pin 17 (a touch controller's PENIRQ) */
+    drive(qts, 17, 1);
+    qtest_writel(qts, PIN(17), INT_TYPE(2) | INT_ENA_CPU);
+    g_assert_cmphex(qtest_readl(qts, STATUS), ==, 0);
+    drive(qts, 17, 0);
+    g_assert_cmphex(qtest_readl(qts, STATUS), ==, BIT(17));
+    g_assert_cmphex(qtest_readl(qts, PCPU_INT), ==, BIT(17));
+    g_assert_true(gpio_irq(qts));
+    qtest_writel(qts, STATUS_W1TC, BIT(17));
+    g_assert_cmphex(qtest_readl(qts, STATUS), ==, 0);
+    g_assert_false(gpio_irq(qts));
+    drive(qts, 17, 1);                  /* Rising edge: not this type */
+    g_assert_cmphex(qtest_readl(qts, STATUS), ==, 0);
+
+    /* Low level on pin 36 (an expander's INT): stays pending while low */
+    drive(qts, 36, 0);
+    qtest_writel(qts, PIN(36), INT_TYPE(4) | INT_ENA_CPU);
+    g_assert_cmphex(qtest_readl(qts, STATUS1), ==, BIT(36 - 32));
+    g_assert_cmphex(qtest_readl(qts, PCPU_INT1), ==, BIT(36 - 32));
+    g_assert_true(gpio_irq(qts));
+    qtest_writel(qts, GPIO + 0x58, BIT(36 - 32));
+    g_assert_cmphex(qtest_readl(qts, STATUS1), ==, BIT(36 - 32));
+    drive(qts, 36, 1);
+    qtest_writel(qts, GPIO + 0x58, BIT(36 - 32));
+    g_assert_cmphex(qtest_readl(qts, STATUS1), ==, 0);
+    g_assert_false(gpio_irq(qts));
+
+    /* Status without an enable doesn't interrupt */
+    qtest_writel(qts, PIN(5), INT_TYPE(3));
+    drive(qts, 5, 1);
+    g_assert_cmphex(qtest_readl(qts, STATUS), ==, BIT(5));
+    g_assert_cmphex(qtest_readl(qts, PCPU_INT), ==, 0);
+    g_assert_false(gpio_irq(qts));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/gpio/reset", test_reset);
+    qtest_add_func("/esp32s3/gpio/output_loopback", test_output_loopback);
+    qtest_add_func("/esp32s3/gpio/external_and_pulls", test_external_and_pulls);
+    qtest_add_func("/esp32s3/gpio/matrix", test_matrix);
+    qtest_add_func("/esp32s3/gpio/interrupts", test_interrupts);
+    return g_test_run();
+}
