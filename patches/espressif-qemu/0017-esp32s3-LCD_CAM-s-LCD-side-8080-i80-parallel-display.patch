diff --git a/hw/display/esp32s3_lcd_cam.c b/hw/display/esp32s3_lcd_cam.c
new file mode 100644
index 0000000..6ab65eb
--- /dev/null
+++ b/hw/display/esp32s3_lcd_cam.c
@@ -0,0 +1,230 @@
+/*
+ * ESP32-S3 LCD_CAM: the LCD side in i80 (8080 parallel) mode, as ESP-IDF's esp_lcd i80
+ * driver uses it.
+ *
+ * A transaction (LCD_USER.LCD_START) is a command phase (1 or 2 cycles: LCD_CMD_VAL, low
+ * byte first), a dummy phase (no data) and a data phase, from the GDMA's LCD_CAM OUT
+ * channel: LCD_DOUT_CYCLELEN+1 cycles, or with LCD_ALWAYS_OUT_EN until the DMA chain's
+ * EOF. The bytes go to the panel on this device's "lcd" bus (-device st7789,bus=lcd), so
+ * the SPI panel models serve: the D/C level of each phase (LCD_MISC: idle level, and per
+ * phase whether it differs) goes out on LCD_DC, and the transaction is framed by LCD_CS,
+ * both through the GPIO matrix to whichever pins the firmware routed them to, where
+ * esp32s3.pin-link takes them to the panel's dc and CS lines. LCD_8BITS_ORDER swaps
+ * adjacent data bytes, LCD_BIT_ORDER reverses each byte's bits. Done: LCD_TRANS_DONE
+ * (LC_DMA_INT_RAW bit 1) and the interrupt. The camera, RGB mode and the clock's timing
+ * aren't modelled (a transaction completes at once).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/display/esp32s3_lcd_cam.h"
+
+#define LCD_CLOCK         0x00
+#define LCD_USER          0x14
+#define LCD_MISC          0x18
+#define LCD_CTRL          0x1c
+#define LCD_CTRL1         0x20
+#define LCD_CTRL2         0x24
+#define LCD_CMD_VAL       0x28
+#define LCD_DLY_MODE      0x30
+#define LCD_DATA_DOUT     0x38
+#define LC_DMA_INT_ENA    0x64
+#define LC_DMA_INT_RAW    0x68
+#define LC_DMA_INT_ST     0x6c
+#define LC_DMA_INT_CLR    0x70
+#define LC_REG_DATE       0xfc
+
+#define USER_CYCLELEN     0x1fff
+#define USER_ALWAYS_OUT   BIT(13)
+#define USER_8BITS_ORDER  BIT(19)
+#define USER_UPDATE       BIT(20)
+#define USER_BIT_ORDER    BIT(21)
+#define USER_2BYTE_EN     BIT(23)
+#define USER_DOUT         BIT(24)
+#define USER_DUMMY        BIT(25)
+#define USER_CMD          BIT(26)
+#define USER_START        BIT(27)
+#define USER_RESET        BIT(28)
+#define USER_CMD_2_CYCLE  BIT(31)
+
+#define MISC_AFIFO_RESET  BIT(27)
+#define MISC_CD_DATA_SET  BIT(28)
+#define MISC_CD_DUMMY_SET BIT(29)
+#define MISC_CD_CMD_SET   BIT(30)
+#define MISC_CD_IDLE_EDGE BIT(31)
+
+#define CTRL_RGB_MODE_EN  BIT(31)
+#define INT_TRANS_DONE    BIT(1)
+
+#define MAX_DATA          (1024 * 1024)
+
+static void update_irq(ESP32S3LcdCamState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+static bool dc_level(ESP32S3LcdCamState *s, uint32_t set_bit)
+{
+    bool idle = s->misc & MISC_CD_IDLE_EDGE;
+    return idle ^ !!(s->misc & set_bit);
+}
+
+static void lcd_send(ESP32S3LcdCamState *s, uint8_t b)
+{
+    ssi_transfer(s->bus, b);
+    s->bytes++;
+}
+
+static void transaction(ESP32S3LcdCamState *s)
+{
+    if (s->ctrl & CTRL_RGB_MODE_EN) {
+        qemu_log_mask(LOG_UNIMP, "esp32s3.lcd_cam: RGB mode isn't modelled\n");
+        return;
+    }
+    qemu_set_irq(s->cs, 0);
+    if (s->user & USER_CMD) {
+        qemu_set_irq(s->dc, dc_level(s, MISC_CD_CMD_SET));
+        lcd_send(s, s->cmd_val & 0xff);
+        if (s->user & USER_CMD_2_CYCLE) {
+            lcd_send(s, (s->cmd_val >> 8) & 0xff);
+        }
+    }
+    if (s->user & USER_DUMMY) {
+        qemu_set_irq(s->dc, dc_level(s, MISC_CD_DUMMY_SET));
+    }
+    if (s->user & USER_DOUT) {
+        uint32_t chan, n;
+        if (!s->gdma || !esp_gdma_get_channel_periph(s->gdma, GDMA_LCDCAM, ESP_GDMA_OUT_IDX, &chan)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "esp32s3.lcd_cam: data phase, but no GDMA channel\n");
+        } else {
+            if (s->user & USER_ALWAYS_OUT) {
+                n = esp_gdma_out_chain_length(s->gdma, chan);
+            } else {
+                n = ((s->user & USER_CYCLELEN) + 1) * ((s->user & USER_2BYTE_EN) ? 2 : 1);
+            }
+            n = MIN(n, MAX_DATA);
+            g_autofree uint8_t *buf = g_malloc(n ? n : 1);
+            if (n && esp_gdma_read_channel(s->gdma, chan, buf, n)) {
+                qemu_set_irq(s->dc, dc_level(s, MISC_CD_DATA_SET));
+                for (uint32_t i = 0; i < n; i++) {
+                    uint32_t j = ((s->user & USER_8BITS_ORDER) && (i ^ 1) < n) ? (i ^ 1) : i;
+                    uint8_t b = buf[j];
+                    if (s->user & USER_BIT_ORDER) {
+                        b = revbit8(b);
+                    }
+                    lcd_send(s, b);
+                }
+            }
+        }
+    }
+    qemu_set_irq(s->cs, 1);
+    qemu_set_irq(s->dc, !!(s->misc & MISC_CD_IDLE_EDGE));
+    s->user &= ~(USER_START | USER_UPDATE);
+    s->int_raw |= INT_TRANS_DONE;
+    update_irq(s);
+}
+
+static uint64_t lcd_cam_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3LcdCamState *s = opaque;
+    switch (addr) {
+    case LCD_CLOCK:      return s->clock;
+    case LCD_USER:       return s->user;
+    case LCD_MISC:       return s->misc;
+    case LCD_CTRL:       return s->ctrl;
+    case LCD_CTRL1:      return s->ctrl1;
+    case LCD_CTRL2:      return s->ctrl2;
+    case LCD_CMD_VAL:    return s->cmd_val;
+    case LCD_DLY_MODE:   return s->dly_mode;
+    case LCD_DATA_DOUT:  return s->dout_mode;
+    case LC_DMA_INT_ENA: return s->int_ena;
+    case LC_DMA_INT_RAW: return s->int_raw;
+    case LC_DMA_INT_ST:  return s->int_raw & s->int_ena;
+    case LC_REG_DATE:    return 0x2101040;
+    }
+    return 0;
+}
+
+static void lcd_cam_write(void *opaque, hwaddr addr, uint64_t v, unsigned size)
+{
+    ESP32S3LcdCamState *s = opaque;
+    switch (addr) {
+    case LCD_CLOCK:      s->clock = v; break;
+    case LCD_USER:
+        s->user = v & ~USER_RESET;
+        if (v & USER_START) {
+            transaction(s);
+        }
+        break;
+    case LCD_MISC:
+        s->misc = v & ~MISC_AFIFO_RESET;
+        qemu_set_irq(s->dc, !!(s->misc & MISC_CD_IDLE_EDGE));
+        break;
+    case LCD_CTRL:       s->ctrl = v; break;
+    case LCD_CTRL1:      s->ctrl1 = v; break;
+    case LCD_CTRL2:      s->ctrl2 = v; break;
+    case LCD_CMD_VAL:    s->cmd_val = v; break;
+    case LCD_DLY_MODE:   s->dly_mode = v; break;
+    case LCD_DATA_DOUT:  s->dout_mode = v; break;
+    case LC_DMA_INT_ENA: s->int_ena = v; update_irq(s); break;
+    case LC_DMA_INT_CLR: s->int_raw &= ~v; update_irq(s); break;
+    }
+}
+
+static const MemoryRegionOps lcd_cam_ops = {
+    .read = lcd_cam_read,
+    .write = lcd_cam_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void lcd_cam_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3LcdCamState *s = ESP32S3_LCD_CAM(obj);
+    s->clock = s->user = s->misc = s->ctrl = s->ctrl1 = s->ctrl2 = 0;
+    s->cmd_val = s->dly_mode = s->dout_mode = s->int_ena = s->int_raw = 0;
+    update_irq(s);
+}
+
+static void lcd_cam_init(Object *obj)
+{
+    ESP32S3LcdCamState *s = ESP32S3_LCD_CAM(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &lcd_cam_ops, s, TYPE_ESP32S3_LCD_CAM, 0x100);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->cs, ESP32S3_LCD_CAM_CS_OUT, 1);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->dc, ESP32S3_LCD_CAM_DC_OUT, 1);
+    s->bus = ssi_create_bus(DEVICE(obj), "lcd");
+    object_property_add_uint64_ptr(obj, "bytes", &s->bytes, OBJ_PROP_FLAG_READ);
+}
+
+static void lcd_cam_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = lcd_cam_reset_hold;
+}
+
+static const TypeInfo lcd_cam_info = {
+    .name = TYPE_ESP32S3_LCD_CAM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3LcdCamState),
+    .instance_init = lcd_cam_init,
+    .class_init = lcd_cam_class_init,
+};
+
+static void lcd_cam_register_types(void)
+{
+    type_register_static(&lcd_cam_info);
+}
+
+type_init(lcd_cam_register_types)
