+/*
+ * ESP32-S3 LCD_CAM, its LCD side in i80 (8080 parallel) mode
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#ifndef HW_DISPLAY_ESP32S3_LCD_CAM_H
+#define HW_DISPLAY_ESP32S3_LCD_CAM_H
+
+#include "hw/sysbus.h"
+#include "hw/ssi/ssi.h"
+#include "hw/dma/esp_gdma.h"
+
+#define TYPE_ESP32S3_LCD_CAM "esp32s3.lcd_cam"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3LcdCamState, ESP32S3_LCD_CAM)
+
+#define ESP32S3_LCD_CAM_CS_OUT "lcd-cs"     /* To the GPIO matrix: LCD_CS (132) */
+#define ESP32S3_LCD_CAM_DC_OUT "lcd-dc"     /* LCD_DC (153) */
+
+struct ESP32S3LcdCamState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    qemu_irq cs;
+    qemu_irq dc;
+    SSIBus *bus;                            /* "lcd": the panel, as on a SPI bus */
+    ESPGdmaState *gdma;
+
+    uint32_t clock, user, misc, ctrl, ctrl1, ctrl2, cmd_val, dly_mode, dout_mode;
+    uint32_t int_ena, int_raw;
+    uint64_t bytes;                         /* Sent to the panel, for tests */
+};
+
+#endif
