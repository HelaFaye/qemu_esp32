+        sysbus_connect_irq(SYS_BUS_DEVICE(&ss->lcd_cam), 0,
+                           qdev_get_gpio_in(intmatrix_dev, ETS_LCD_CAM_INTR_SOURCE));
+        qdev_connect_gpio_out_named(DEVICE(&ss->lcd_cam), ESP32S3_LCD_CAM_CS_OUT, 0,
+                                    qdev_get_gpio_in_named(DEVICE(&ss->gpio), ESP32S3_GPIO_SIG_OUT, 132));
+        qdev_connect_gpio_out_named(DEVICE(&ss->lcd_cam), ESP32S3_LCD_CAM_DC_OUT, 0,
+                                    qdev_get_gpio_in_named(DEVICE(&ss->gpio), ESP32S3_GPIO_SIG_OUT, 153));
