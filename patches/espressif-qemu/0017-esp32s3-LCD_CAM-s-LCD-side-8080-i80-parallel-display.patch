diff --git a/tests/qtest/esp32s3-lcd-cam-test.c b/tests/qtest/esp32s3-lcd-cam-test.c
new file mode 100644
index 0000000..32a9013
--- /dev/null
+++ b/tests/qtest/esp32s3-lcd-cam-test.c
@@ -0,0 +1,199 @@
+/*
+ * QTest for the ESP32-S3's LCD_CAM (its LCD side, the 8080/i80 mode), wired as LilyGO's
+ * T-Display-S3: an ST7789 (170x320 glass at column 35) on LCD_CAM's bus, its CS on GPIO6
+ * and D/C on GPIO7 through the GPIO matrix (LCD_CS 132, LCD_DC 153). Transactions as
+ * ESP-IDF's esp_lcd i80 driver makes them: a command phase, then data from the GDMA,
+ * its length from the descriptors (ALWAYS_OUT) or from CYCLELEN.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qapi/qmp/qdict.h"
+#include "libqtest.h"
+
+#define LCD_CAM         0x60041000
+#define LCD_USER        (LCD_CAM + 0x14)
+#define LCD_MISC        (LCD_CAM + 0x18)
+#define LCD_CMD_VAL     (LCD_CAM + 0x28)
+#define LC_INT_ENA      (LCD_CAM + 0x64)
+#define LC_INT_RAW      (LCD_CAM + 0x68)
+#define LC_INT_CLR      (LCD_CAM + 0x70)
+
+#define USER_ALWAYS_OUT BIT(13)
+#define USER_8BITS_ORDER BIT(19)
+#define USER_UPDATE     BIT(20)
+#define USER_DOUT       BIT(24)
+#define USER_CMD        BIT(26)
+#define USER_START      BIT(27)
+#define MISC_CD_DATA_SET BIT(28)
+#define INT_TRANS_DONE  BIT(1)
+
+#define GDMA            0x6003F000
+#define GDMA_OUT(ch, r) (GDMA + (ch) * 0xC0 + 0x60 + (r))
+#define LINK            0x20
+#define PERI_SEL        0x48
+#define OUT_LINK_START  BIT(21)
+#define PERI_LCDCAM     5
+
+#define GPIO            0x60004000
+#define IN              (GPIO + 0x3C)
+#define OUT_SEL(n)      (GPIO + 0x554 + 4 * (n))
+
+#define DESC            0x3FCA0000
+#define BUF             0x3FCA0100
+
+#define BOARD \
+    "-machine esp32s3 " \
+    "-device st7789,bus=lcd,id=lcd,width=170,height=320,x-offset=35 " \
+    "-device esp32s3.pin-link,pin=6,dev=lcd,line=ssi-gpio-cs,pull=up " \
+    "-device esp32s3.pin-link,pin=7,dev=lcd,line=dc "
+
+static void board_init(QTestState *qts)
+{
+    qtest_writel(qts, OUT_SEL(6), 132);             /* LCD_CS, enabled by LCD_CAM */
+    qtest_writel(qts, OUT_SEL(7), 153);             /* LCD_DC */
+    /* D/C: low for commands and idle, high for data (esp_lcd's dc_levels) */
+    qtest_writel(qts, LCD_MISC, MISC_CD_DATA_SET);
+    qtest_writel(qts, GDMA_OUT(0, PERI_SEL), PERI_LCDCAM);
+}
+
+/* One transaction: cmd, then n bytes from memory through the GDMA (n 0: none) */
+static void lcd_tx(QTestState *qts, uint8_t cmd, const uint8_t *data, size_t n, uint32_t flags)
+{
+    uint32_t user = USER_CMD | USER_UPDATE | USER_START | flags;
+    if (n) {
+        g_assert_cmpuint(n, <, 4096);
+        qtest_memwrite(qts, BUF, data, n);
+        qtest_writel(qts, DESC, BIT(31) | BIT(30) | (n << 12) | n);     /* owner, EOF */
+        qtest_writel(qts, DESC + 4, BUF);
+        qtest_writel(qts, DESC + 8, 0);
+        qtest_writel(qts, GDMA_OUT(0, LINK), (DESC & 0xFFFFF) | OUT_LINK_START);
+        user |= USER_DOUT;
+        if (!(flags & USER_ALWAYS_OUT)) {
+            user |= n - 1;                          /* CYCLELEN: n bytes, one a cycle */
+        }
+    }
+    qtest_writel(qts, LC_INT_CLR, INT_TRANS_DONE);
+    qtest_writel(qts, LCD_CMD_VAL, cmd);
+    qtest_writel(qts, LCD_USER, user);
+    g_assert_cmphex(qtest_readl(qts, LC_INT_RAW) & INT_TRANS_DONE, ==, INT_TRANS_DONE);
+    g_assert_cmphex(qtest_readl(qts, LCD_USER) & USER_START, ==, 0);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(6), ==, BIT(6));     /* CS released */
+}
+
+static void lcd_param(QTestState *qts, uint8_t cmd, const uint8_t *p, size_t n)
+{
+    lcd_tx(qts, cmd, p, n, 0);
+}
+
+/* The panel's glass, from QMP screendump (PPM, P6) */
+static uint8_t *screendump(QTestState *qts, int *w, int *h)
+{
+    g_autofree char *path = g_strdup_printf("%s/qtest-lcdcam-%d.ppm", g_get_tmp_dir(), getpid());
+    QDict *resp = qtest_qmp(qts, "{'execute': 'screendump', 'arguments': {'filename': %s, 'device': 'lcd'}}",
+                            path);
+    g_assert(qdict_haskey(resp, "return"));
+    qobject_unref(resp);
+    gchar *data;
+    gsize len;
+    g_assert(g_file_get_contents(path, &data, &len, NULL));
+    unlink(path);
+    int maxval, off;
+    g_assert_cmpint(sscanf(data, "P6 %d %d %d%n", w, h, &maxval, &off), ==, 3);
+    /* Exactly its rows: 170 isn't a multiple of 4, so padded rows would show here */
+    g_assert_cmpuint(len, ==, off + 1 + (size_t)*w * *h * 3);
+    uint8_t *px = g_memdup2(data + off + 1, (size_t)*w * *h * 3);
+    g_free(data);
+    return px;
+}
+
+static uint32_t pixel(const uint8_t *px, int w, int x, int y)
+{
+    const uint8_t *p = px + (y * w + x) * 3;
+    return p[0] << 16 | p[1] << 8 | p[2];
+}
+
+static void panel_on(QTestState *qts)
+{
+    static const uint8_t colmod[] = { 0x55 };       /* 16 bits a pixel */
+    lcd_tx(qts, 0x11, NULL, 0, 0);                  /* SLPOUT */
+    lcd_param(qts, 0x3A, colmod, 1);
+    lcd_tx(qts, 0x21, NULL, 0, 0);                  /* INVON: an IPS panel's colors */
+    lcd_tx(qts, 0x29, NULL, 0, 0);                  /* DISPON */
+}
+
+/* A 2x2 window at the glass's top left (RAM column 35), then four pixels */
+static void window(QTestState *qts)
+{
+    static const uint8_t caset[] = { 0, 35, 0, 36 }, raset[] = { 0, 0, 0, 1 };
+    lcd_param(qts, 0x2A, caset, 4);
+    lcd_param(qts, 0x2B, raset, 4);
+}
+
+static void check_square(QTestState *qts)
+{
+    int w, h;
+    g_autofree uint8_t *px = screendump(qts, &w, &h);
+    g_assert_cmpint(w, ==, 170);
+    g_assert_cmpint(h, ==, 320);
+    g_assert_cmphex(pixel(px, w, 0, 0), ==, 0xFF0000);
+    g_assert_cmphex(pixel(px, w, 1, 0), ==, 0x00FF00);
+    g_assert_cmphex(pixel(px, w, 0, 1), ==, 0x0000FF);
+    g_assert_cmphex(pixel(px, w, 1, 1), ==, 0xFFFFFF);
+    g_assert_cmphex(pixel(px, w, 2, 0), ==, 0x000000);
+    g_assert_cmphex(pixel(px, w, 169, 319), ==, 0x000000);
+}
+
+/* Commands with parameters by CYCLELEN, pixels by the descriptors' length (ALWAYS_OUT) */
+static void test_pixels(void)
+{
+    QTestState *qts = qtest_init(BOARD);
+    board_init(qts);
+    panel_on(qts);
+    window(qts);
+    static const uint8_t px[] = { 0xF8, 0x00, 0x07, 0xE0, 0x00, 0x1F, 0xFF, 0xFF };
+    lcd_tx(qts, 0x2C, px, sizeof(px), USER_ALWAYS_OUT);
+    check_square(qts);
+    qtest_quit(qts);
+}
+
+/* 8BITS_ORDER swaps each pair of bytes: little-endian pixels from memory, as LVGL keeps
+ * them, reach the panel high byte first */
+static void test_byte_order(void)
+{
+    QTestState *qts = qtest_init(BOARD);
+    board_init(qts);
+    panel_on(qts);
+    window(qts);
+    static const uint8_t px[] = { 0x00, 0xF8, 0xE0, 0x07, 0x1F, 0x00, 0xFF, 0xFF };
+    lcd_tx(qts, 0x2C, px, sizeof(px), USER_ALWAYS_OUT | USER_8BITS_ORDER);
+    check_square(qts);
+    qtest_quit(qts);
+}
+
+/* The done interrupt reaches the interrupt matrix's status only when enabled */
+static void test_interrupt(void)
+{
+    QTestState *qts = qtest_init(BOARD);
+    board_init(qts);
+    lcd_tx(qts, 0x00, NULL, 0, 0);                  /* NOP */
+    g_assert_cmphex(qtest_readl(qts, LCD_CAM + 0x6C) & INT_TRANS_DONE, ==, 0);
+    qtest_writel(qts, LC_INT_ENA, INT_TRANS_DONE);
+    g_assert_cmphex(qtest_readl(qts, LCD_CAM + 0x6C) & INT_TRANS_DONE, ==, INT_TRANS_DONE);
+    qtest_writel(qts, LC_INT_CLR, INT_TRANS_DONE);
+    g_assert_cmphex(qtest_readl(qts, LCD_CAM + 0x6C) & INT_TRANS_DONE, ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/lcd-cam/pixels", test_pixels);
+    qtest_add_func("/esp32s3/lcd-cam/byte-order", test_byte_order);
+    qtest_add_func("/esp32s3/lcd-cam/interrupt", test_interrupt);
+    return g_test_run();
+}
