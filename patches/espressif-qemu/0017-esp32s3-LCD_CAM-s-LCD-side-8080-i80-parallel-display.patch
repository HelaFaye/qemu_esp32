diff --git a/hw/dma/esp_gdma.c b/hw/dma/esp_gdma.c
index 5b778dd..4680d9a 100644
--- a/hw/dma/esp_gdma.c
+++ b/hw/dma/esp_gdma.c
@@ -298,6 +298,31 @@ bool esp_gdma_get_channel_periph(ESPGdmaState *s, GdmaPeripheral periph, int dir
  * @brief Read data from guest RAM pointed by the linked list configured in the given DmaConfigState index.
  *        `size` bytes will be read and stored in `buffer`.
  */
+/*
+ * The number of bytes an OUT channel's descriptor chain holds, up to the descriptor with
+ * suc_eof (or the end of the chain), without consuming it: for a peripheral whose
+ * transfer lasts as long as the DMA's data (LCD_CAM with always_out_en).
+ */
+uint32_t esp_gdma_out_chain_length(ESPGdmaState *s, uint32_t chan)
+{
+    DmaConfigState *state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+    uint32_t base = (ESP_GDMA_GET_CLASS(s)->ram_addr >> 20) << 20;
+    uint32_t addr = base | FIELD_EX32(state->link, GDMA_OUT_LINK, ADDR);
+    uint32_t total = 0;
+    for (int n = 0; n < 4096 && addr; n++) {
+        GdmaLinkedList node;
+        if (!esp_gdma_read_descr(s, addr, &node)) {
+            break;
+        }
+        total += node.config.length;
+        if (node.config.suc_eof) {
+            break;
+        }
+        addr = node.next_addr;
+    }
+    return total;
+}
+
 bool esp_gdma_read_channel(ESPGdmaState *s, uint32_t chan, uint8_t* buffer, uint32_t size)
 {
     DmaConfigState* state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
