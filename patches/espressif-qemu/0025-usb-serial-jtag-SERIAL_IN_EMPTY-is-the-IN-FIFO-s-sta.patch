From 8273f54e7aa60d907ee60b5cd491b6c18b605029 Mon Sep 17 00:00:00 2001
From: HelaFaye <dilsha21@gmail.com>
Date: Tue, 17 Nov 2026 02:21:18 +0000
Subject: [PATCH 25/29] usb-serial-jtag: SERIAL_IN_EMPTY is the IN FIFO's state

On the chip, SERIAL_IN_EMPTY is set while the IN FIFO is empty: from reset,
and again at once if cleared while it's still empty. The model set it only
after a packet went out. Arduino 3's HWCDC enables the interrupt and waits for
it as its only sign of a host. Here it never fired, so HWCDC never saw a host:
each write waited out its 100 ms timeout and was dropped. ESP-IDF's driver,
written for the chip's behavior, disables the interrupt when it has nothing to
send.

Test: esp32s3-usb-serial-jtag-test (set at start, back at once after a clear
while empty, clear once a byte is queued, set again when it's sent).
---
 hw/misc/esp32c3_jtag.c                     |  8 ++++++++
 tests/qtest/esp32s3-usb-serial-jtag-test.c | 16 ++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/hw/misc/esp32c3_jtag.c b/hw/misc/esp32c3_jtag.c
index 85d09fa..e7b14d3 100644
--- a/hw/misc/esp32c3_jtag.c
+++ b/hw/misc/esp32c3_jtag.c
@@ -61,6 +61,13 @@ static bool host_attached(ESP32C3UsbJtagState *s)
 
 static void update_irq(ESP32C3UsbJtagState *s)
 {
+    /* SERIAL_IN_EMPTY is the IN FIFO's state: set while it's empty (from reset, and
+     * again at once if cleared while still empty), as the chip has it. Drivers that
+     * enable it to be told when they can write (Arduino 3's HWCDC: its only sign of
+     * a host) rely on it; ESP-IDF's disables it when it has nothing to send. */
+    if (!s->in_len) {
+        s->int_raw |= INT_SERIAL_IN_EMPTY;
+    }
     qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
 }
 
@@ -135,6 +142,7 @@ static void esp32c3_jtag_write(void *opaque, hwaddr addr, uint64_t value, unsign
     case A_EP1:
         if (s->in_len < ESP32C3_JTAG_EP1_SIZE) {
             s->in_fifo[s->in_len++] = value;
+            s->int_raw &= ~INT_SERIAL_IN_EMPTY;
         }
         break;
     case A_EP1_CONF:
diff --git a/tests/qtest/esp32s3-usb-serial-jtag-test.c b/tests/qtest/esp32s3-usb-serial-jtag-test.c
index 2c2a8ec..c27ca01 100644
--- a/tests/qtest/esp32s3-usb-serial-jtag-test.c
+++ b/tests/qtest/esp32s3-usb-serial-jtag-test.c
@@ -56,6 +56,22 @@ static void test_with_host(void)
     g_assert_cmpint((qtest_readl(qts, FRAM_NUM) - f0) & 0x7FF, ==, 3);
     g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_SOF, ==, INT_SOF);
 
+    /* IN_EMPTY is the IN FIFO's state: set while it's empty, again at once if cleared
+     * while still empty (Arduino 3's HWCDC enables it to learn there's a host) */
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_IN_EMPTY, ==, INT_IN_EMPTY);
+    qtest_writel(qts, INT_CLR, INT_IN_EMPTY);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_IN_EMPTY, ==, INT_IN_EMPTY);
+    qtest_writel(qts, INT_ENA, INT_IN_EMPTY);
+    g_assert_true(qtest_readl(qts, INTMATRIX_STATUS3) & BIT(USJ_SOURCE - 96));
+    qtest_writel(qts, INT_ENA, 0);
+    qtest_writel(qts, EP1, '-');                        /* Not empty: clear stays clear */
+    qtest_writel(qts, INT_CLR, INT_IN_EMPTY);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_IN_EMPTY, ==, 0);
+    qtest_writel(qts, EP1_CONF, WR_DONE);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_IN_EMPTY, ==, INT_IN_EMPTY);
+    char dash;
+    g_assert_cmpint(read(host, &dash, 1), ==, 1);
+
     /* To the host: bytes, then WR_DONE */
     g_assert_cmphex(qtest_readl(qts, EP1_CONF) & IN_FREE, ==, IN_FREE);
     const char *msg = "I (312) main_task: Calling app_main()\n";
