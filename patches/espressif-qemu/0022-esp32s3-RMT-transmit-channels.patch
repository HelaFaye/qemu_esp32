diff --git a/hw/misc/esp32s3_rmt.c b/hw/misc/esp32s3_rmt.c
new file mode 100644
index 0000000..d58cc42
--- /dev/null
+++ b/hw/misc/esp32s3_rmt.c
@@ -0,0 +1,318 @@
+/*
+ * ESP32-S3 RMT (remote control transceiver): the transmit side
+ *
+ * Enough of the RMT for ESP-IDF's rmt_tx driver (and Arduino's rmtWrite, behind
+ * neopixelWrite and digitalWrite on an RGB_BUILTIN LED) to send and finish: the
+ * registers keep what is written, the channel memory (RMTMEM) holds symbols, and a
+ * transmission started with TX_START walks its symbols in virtual time, raising
+ * TX_THR_EVENT every TX_LIM symbols (so a driver can refill a ping-pong buffer) and
+ * TX_END at the end marker (a zero duration). The pin is not driven; what was sent is
+ * kept, decoded, in the `last-frame` property.
+ *
+ * Timing: a tick is one APB cycle (80 MHz) times the channel's DIV_CNT. The group
+ * clock divider (RMT_SYS_CONF) is ignored, so durations are approximate.
+ *
+ * Not modelled: receive channels, carrier, loop counting, DMA access.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32s3_rmt.h"
+
+#define R_CH0CONF0      (0x20 / 4)  /* TX channels 0-3: CHnCONF0 */
+#define R_INT_RAW       (0x70 / 4)
+#define R_INT_ST        (0x74 / 4)
+#define R_INT_ENA       (0x78 / 4)
+#define R_INT_CLR       (0x7c / 4)
+#define R_CH0_TX_LIM    (0xa0 / 4)
+#define R_DATE          (0xcc / 4)
+
+#define CONF0_TX_START      (1u << 0)
+#define CONF0_MEM_RD_RST    (1u << 1)
+#define CONF0_TX_CONTI      (1u << 3)
+#define CONF0_MEM_WRAP      (1u << 4)
+#define CONF0_TX_STOP       (1u << 7)
+#define CONF0_DIV_SHIFT     8
+#define CONF0_MEM_SIZE_SHIFT 16
+
+#define INT_TX_END(ch)  (1u << (ch))
+#define INT_TX_ERR(ch)  (1u << (4 + (ch)))
+#define INT_TX_THR(ch)  (1u << (8 + (ch)))
+
+#define APB_NS_PER_TICK 12.5
+
+static void esp32s3_rmt_update_irq(ESP32S3RmtState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+static uint32_t conf0(ESP32S3RmtState *s, int ch)
+{
+    return s->regs[R_CH0CONF0 + ch];
+}
+
+static void esp32s3_rmt_finish_frame(ESP32S3RmtState *s, ESP32S3RmtTx *tx)
+{
+    const uint32_t bytes = tx->bits / 8;
+    GString *hex = g_string_new(NULL);
+    for (uint32_t i = 0; i < bytes && i < ESP32S3_RMT_FRAME_MAX; i++) {
+        g_string_append_printf(hex, "%02x", tx->frame[i]);
+    }
+    g_free(s->last_frame);
+    s->last_frame = g_string_free(hex, false);
+    s->frames++;
+}
+
+/* Send symbols from where the channel is until an event: the end marker, the
+ * threshold, or the end of its memory. Raise the event when the time they take
+ * has passed. */
+static void esp32s3_rmt_run(ESP32S3RmtState *s, int ch)
+{
+    ESP32S3RmtTx *tx = &s->tx[ch];
+    const uint32_t c0 = conf0(s, ch);
+    uint32_t blocks = (c0 >> CONF0_MEM_SIZE_SHIFT) & 0xf;
+    uint32_t div = (c0 >> CONF0_DIV_SHIFT) & 0xff;
+    const uint32_t lim = s->regs[R_CH0_TX_LIM + ch] & 0x1ff;
+    if (blocks == 0) {
+        blocks = 1;
+    }
+    if (div == 0) {
+        div = 256;
+    }
+    uint32_t words = blocks * ESP32S3_RMT_WORDS_PER_BLOCK;
+    if (ch * ESP32S3_RMT_WORDS_PER_BLOCK + words > ARRAY_SIZE(s->mem)) {
+        words = ARRAY_SIZE(s->mem) - ch * ESP32S3_RMT_WORDS_PER_BLOCK;
+    }
+
+    uint64_t ticks = 0;
+    tx->pending = 0;
+    tx->finished = false;
+    for (;;) {
+        if (tx->pos >= words) {
+            if (c0 & CONF0_MEM_WRAP) {
+                tx->pos = 0;
+            } else {
+                /* Ran off the end of its memory with no end marker */
+                tx->pending = INT_TX_ERR(ch);
+                tx->finished = true;
+                break;
+            }
+        }
+        const uint32_t w = s->mem[ch * ESP32S3_RMT_WORDS_PER_BLOCK + tx->pos++];
+        const uint32_t d0 = w & 0x7fff, d1 = (w >> 16) & 0x7fff;
+        if (d0 == 0 || d1 == 0) {
+            ticks += d0;                  /* An end marker may carry one last level */
+            tx->pending = INT_TX_END(ch);
+            tx->finished = true;
+            break;
+        }
+        ticks += d0 + d1;
+        if (tx->bits < ESP32S3_RMT_FRAME_MAX * 8) {
+            if (d0 > d1) {
+                tx->frame[tx->bits / 8] |= 0x80 >> (tx->bits % 8);
+            }
+            tx->bits++;
+        }
+        tx->sent++;
+        if (lim && (tx->sent % lim) == 0) {
+            tx->pending = INT_TX_THR(ch);
+            break;
+        }
+        if (tx->sent > 1000000) {         /* A runaway: no end marker in sight */
+            tx->pending = INT_TX_ERR(ch);
+            tx->finished = true;
+            break;
+        }
+    }
+    const int64_t ns = (int64_t) (ticks * div * APB_NS_PER_TICK) + 1;
+    timer_mod(&tx->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns);
+}
+
+static void esp32s3_rmt_timer_ch(ESP32S3RmtState *s, int ch)
+{
+    ESP32S3RmtTx *tx = &s->tx[ch];
+    if (!tx->active) {
+        return;
+    }
+    s->int_raw |= tx->pending;
+    if (tx->finished) {
+        tx->active = false;
+        esp32s3_rmt_finish_frame(s, tx);
+        if ((conf0(s, ch) & CONF0_TX_CONTI) && (tx->pending & INT_TX_END(ch))) {
+            /* Continuous mode: send the same symbols again */
+            tx->active = true;
+            tx->pos = 0;
+            tx->bits = 0;
+            memset(tx->frame, 0, sizeof(tx->frame));
+            esp32s3_rmt_update_irq(s);
+            esp32s3_rmt_run(s, ch);
+            return;
+        }
+    }
+    esp32s3_rmt_update_irq(s);
+    if (tx->active) {
+        esp32s3_rmt_run(s, ch);         /* Past the threshold: carry on */
+    }
+}
+
+#define RMT_TIMER_CB(n) \
+    static void esp32s3_rmt_timer##n(void *opaque) { esp32s3_rmt_timer_ch(opaque, n); }
+RMT_TIMER_CB(0)
+RMT_TIMER_CB(1)
+RMT_TIMER_CB(2)
+RMT_TIMER_CB(3)
+static void (*const timer_cb[ESP32S3_RMT_TX_CHANNELS])(void *) = {
+    esp32s3_rmt_timer0, esp32s3_rmt_timer1, esp32s3_rmt_timer2, esp32s3_rmt_timer3,
+};
+
+static void esp32s3_rmt_start(ESP32S3RmtState *s, int ch)
+{
+    ESP32S3RmtTx *tx = &s->tx[ch];
+    timer_del(&tx->timer);
+    tx->active = true;
+    tx->pos = 0;
+    tx->sent = 0;
+    tx->bits = 0;
+    memset(tx->frame, 0, sizeof(tx->frame));
+    esp32s3_rmt_run(s, ch);
+}
+
+static uint64_t esp32s3_rmt_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3RmtState *s = ESP32S3_RMT(opaque);
+    if (addr >= ESP32S3_RMT_MEM_OFFSET) {
+        const hwaddr i = (addr - ESP32S3_RMT_MEM_OFFSET) / 4;
+        return i < ARRAY_SIZE(s->mem) ? s->mem[i] : 0;
+    }
+    const hwaddr r = addr / 4;
+    switch (r) {
+    case R_INT_RAW:
+        return s->int_raw;
+    case R_INT_ST:
+        return s->int_raw & s->int_ena;
+    case R_INT_ENA:
+        return s->int_ena;
+    case R_INT_CLR:
+        return 0;
+    case R_DATE:
+        return 0x2101181;               /* RMT_DATE's reset value */
+    default:
+        return r < ARRAY_SIZE(s->regs) ? s->regs[r] : 0;
+    }
+}
+
+static void esp32s3_rmt_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32S3RmtState *s = ESP32S3_RMT(opaque);
+    if (addr >= ESP32S3_RMT_MEM_OFFSET) {
+        const hwaddr i = (addr - ESP32S3_RMT_MEM_OFFSET) / 4;
+        if (i < ARRAY_SIZE(s->mem)) {
+            s->mem[i] = value;
+        }
+        return;
+    }
+    const hwaddr r = addr / 4;
+    switch (r) {
+    case R_INT_RAW:
+    case R_INT_ST:
+        break;                          /* Read-only */
+    case R_INT_ENA:
+        s->int_ena = value;
+        esp32s3_rmt_update_irq(s);
+        break;
+    case R_INT_CLR:
+        s->int_raw &= ~value;
+        esp32s3_rmt_update_irq(s);
+        break;
+    case R_CH0CONF0 ... R_CH0CONF0 + ESP32S3_RMT_TX_CHANNELS - 1: {
+        const int ch = r - R_CH0CONF0;
+        /* TX_START, MEM_RD_RST and TX_STOP act and read back as 0 */
+        s->regs[r] = value & ~(CONF0_TX_START | CONF0_MEM_RD_RST | CONF0_TX_STOP);
+        if (value & CONF0_MEM_RD_RST) {
+            s->tx[ch].pos = 0;
+        }
+        if (value & CONF0_TX_STOP) {
+            timer_del(&s->tx[ch].timer);
+            s->tx[ch].active = false;
+        }
+        if (value & CONF0_TX_START) {
+            esp32s3_rmt_start(s, ch);
+        }
+        break;
+    }
+    default:
+        if (r < ARRAY_SIZE(s->regs)) {
+            s->regs[r] = value;
+        }
+        break;
+    }
+}
+
+static const MemoryRegionOps esp32s3_rmt_ops = {
+    .read = esp32s3_rmt_read,
+    .write = esp32s3_rmt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static char *esp32s3_rmt_get_last_frame(Object *obj, Error **errp)
+{
+    ESP32S3RmtState *s = ESP32S3_RMT(obj);
+    return g_strdup(s->last_frame ? s->last_frame : "");
+}
+
+static void esp32s3_rmt_reset(DeviceState *dev)
+{
+    ESP32S3RmtState *s = ESP32S3_RMT(dev);
+    for (int ch = 0; ch < ESP32S3_RMT_TX_CHANNELS; ch++) {
+        timer_del(&s->tx[ch].timer);
+        s->tx[ch].active = false;
+    }
+    memset(s->regs, 0, sizeof(s->regs));
+    s->int_raw = 0;
+    s->int_ena = 0;
+    qemu_irq_lower(s->irq);
+}
+
+static void esp32s3_rmt_init(Object *obj)
+{
+    ESP32S3RmtState *s = ESP32S3_RMT(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32s3_rmt_ops, s, TYPE_ESP32S3_RMT, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    for (int ch = 0; ch < ESP32S3_RMT_TX_CHANNELS; ch++) {
+        timer_init_ns(&s->tx[ch].timer, QEMU_CLOCK_VIRTUAL, timer_cb[ch], s);
+    }
+    object_property_add_str(obj, "last-frame", esp32s3_rmt_get_last_frame, NULL);
+    object_property_add_uint32_ptr(obj, "frames", &s->frames, OBJ_PROP_FLAG_READ);
+}
+
+static void esp32s3_rmt_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, esp32s3_rmt_reset);
+}
+
+static const TypeInfo esp32s3_rmt_info = {
+    .name = TYPE_ESP32S3_RMT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3RmtState),
+    .instance_init = esp32s3_rmt_init,
+    .class_init = esp32s3_rmt_class_init,
+};
+
+static void esp32s3_rmt_register_types(void)
+{
+    type_register_static(&esp32s3_rmt_info);
+}
+
+type_init(esp32s3_rmt_register_types)
