diff --git a/include/hw/misc/esp32s3_rmt.h b/include/hw/misc/esp32s3_rmt.h
new file mode 100644
index 0000000..c1d0eb0
--- /dev/null
+++ b/include/hw/misc/esp32s3_rmt.h
@@ -0,0 +1,51 @@
+/*
+ * ESP32-S3 RMT (remote control transceiver): the transmit side
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESP32S3_RMT "esp32s3.rmt"
+#define ESP32S3_RMT(obj) OBJECT_CHECK(ESP32S3RmtState, (obj), TYPE_ESP32S3_RMT)
+
+#define ESP32S3_RMT_TX_CHANNELS     4
+#define ESP32S3_RMT_CHANNELS        8
+#define ESP32S3_RMT_WORDS_PER_BLOCK 48      /* SOC_RMT_MEM_WORDS_PER_CHANNEL */
+#define ESP32S3_RMT_REGS_SIZE       0xd0
+#define ESP32S3_RMT_MEM_OFFSET      0x800   /* RMTMEM, 0x60016800 */
+#define ESP32S3_RMT_FRAME_MAX       256     /* Decoded bytes kept per transmission */
+
+typedef struct ESP32S3RmtTx {
+    bool active;
+    uint32_t pos;           /* Word being sent, relative to the channel's memory */
+    uint32_t sent;          /* Symbols sent in this transmission */
+    uint32_t bits;          /* Decoded bits so far */
+    uint8_t frame[ESP32S3_RMT_FRAME_MAX];
+    QEMUTimer timer;
+    uint32_t pending;       /* Interrupt bits to raise when the timer fires */
+    bool finished;          /* The transmission ends when the timer fires */
+} ESP32S3RmtTx;
+
+typedef struct ESP32S3RmtState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    uint32_t regs[ESP32S3_RMT_REGS_SIZE / 4];
+    uint32_t mem[ESP32S3_RMT_CHANNELS * ESP32S3_RMT_WORDS_PER_BLOCK];
+    uint32_t int_raw;
+    uint32_t int_ena;
+    ESP32S3RmtTx tx[ESP32S3_RMT_TX_CHANNELS];
+
+    /* For tests: what the last finished transmission carried, decoded as
+     * WS2812-style bits (a symbol whose high time is longer than its low time is a 1),
+     * most significant bit first, as hex; and how many transmissions have finished. */
+    char *last_frame;
+    uint32_t frames;
+} ESP32S3RmtState;
diff --git a/tests/qtest/esp32s3-rmt-test.c b/tests/qtest/esp32s3-rmt-test.c
new file mode 100644
index 0000000..c84b346
--- /dev/null
+++ b/tests/qtest/esp32s3-rmt-test.c
@@ -0,0 +1,107 @@
+/*
+ * QTest for the ESP32-S3 RMT's transmit side: symbols written to RMTMEM and started with
+ * TX_START are sent in virtual time; TX_END is raised at the end marker, TX_THR_EVENT
+ * every TX_LIM symbols, and the bits sent (WS2812 timing: a long high is a 1) are kept
+ * in the device's `last-frame` property.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "libqtest.h"
+#include "qapi/qmp/qdict.h"
+
+#define RMT_BASE        0x60016000
+#define RMT_MEM         0x60016800
+#define CH0CONF0        (RMT_BASE + 0x20)
+#define INT_RAW         (RMT_BASE + 0x70)
+#define INT_ENA         (RMT_BASE + 0x78)
+#define INT_CLR         (RMT_BASE + 0x7c)
+#define CH0_TX_LIM      (RMT_BASE + 0xa0)
+#define DATE            (RMT_BASE + 0xcc)
+
+/* One WS2812 bit at 80 ticks per microsecond: a 1 is 0.8 us high, 0.45 us low */
+static uint32_t symbol(bool one)
+{
+    const uint32_t high = one ? 64 : 32, low = one ? 36 : 68;
+    return high | BIT(15) | (low << 16);
+}
+
+static void write_byte(QTestState *qts, uint32_t *word, uint8_t byte)
+{
+    for (int b = 7; b >= 0; b--) {
+        qtest_writel(qts, RMT_MEM + 4 * (*word)++, symbol(byte & BIT(b)));
+    }
+}
+
+static char *last_frame(QTestState *qts)
+{
+    QDict *r = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                              "{'path': '/machine/soc/rmt', 'property': 'last-frame'}}");
+    char *hex = g_strdup(qdict_get_str(r, "return"));
+    qobject_unref(r);
+    return hex;
+}
+
+static void test_frame(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    g_assert_cmphex(qtest_readl(qts, DATE), !=, 0);
+
+    /* G, R, B for one LED, then the end marker */
+    uint32_t w = 0;
+    write_byte(qts, &w, 0x10);
+    write_byte(qts, &w, 0xff);
+    write_byte(qts, &w, 0x01);
+    qtest_writel(qts, RMT_MEM + 4 * w, 0);
+
+    qtest_writel(qts, INT_ENA, BIT(0));
+    qtest_writel(qts, CH0CONF0, (1u << 16) | (1u << 8) | BIT(0));   /* 1 block, div 1, start */
+    g_assert_cmphex(qtest_readl(qts, CH0CONF0) & BIT(0), ==, 0);    /* TX_START reads 0 */
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & BIT(0), ==, 0);     /* Not yet: it takes time */
+
+    qtest_clock_step(qts, 100000);                                   /* 24 bits take ~30 us */
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & BIT(0), ==, BIT(0));
+    g_autofree char *hex = last_frame(qts);
+    g_assert_cmpstr(hex, ==, "10ff01");
+
+    qtest_writel(qts, INT_CLR, BIT(0));
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & BIT(0), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_threshold(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    /* A whole block of 1s with no end marker, wrapping: the driver would refill it at
+     * each threshold. Here nothing refills it, so it keeps going until stopped. */
+    for (uint32_t w = 0; w < 48; w++) {
+        qtest_writel(qts, RMT_MEM + 4 * w, symbol(true));
+    }
+    qtest_writel(qts, CH0_TX_LIM, 24);
+    qtest_writel(qts, INT_ENA, BIT(0) | BIT(8));
+    qtest_writel(qts, CH0CONF0, BIT(4) | (1u << 16) | (1u << 8) | BIT(0));  /* wrap, start */
+    qtest_clock_step(qts, 100000);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & BIT(8), ==, BIT(8));
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & BIT(0), ==, 0);
+
+    /* The driver's last refill puts the end marker in; the channel finishes there */
+    qtest_writel(qts, INT_CLR, BIT(8));
+    for (uint32_t w = 0; w < 48; w++) {
+        qtest_writel(qts, RMT_MEM + 4 * w, 0);
+    }
+    qtest_clock_step(qts, 100000);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & BIT(0), ==, BIT(0));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/rmt/frame", test_frame);
+    qtest_add_func("/esp32s3/rmt/threshold", test_threshold);
+    return g_test_run();
+}
