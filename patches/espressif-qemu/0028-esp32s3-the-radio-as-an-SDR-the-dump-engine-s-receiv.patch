index 652cb89..720636e 100644
--- a/tests/qtest/esp32s3-phy-test.c
+++ b/tests/qtest/esp32s3-phy-test.c
@@ -1,6 +1,7 @@
 /*
  * QTest for what Wi-Fi and Bluetooth start-up polls on the ESP32-S3 with no radio behind
- * it: the analog, SENS, baseband and MAC blocks keep what's written; the PHY's
+ * it: the analog, SENS, baseband and MAC blocks keep what's written (the analog I2C
+ * master's command words address the analog registers, which keep it); the PHY's
  * calibrations (peak detector, TX DC offset, IQ estimation), the temperature sensor, the
  * MAC's reset and SAR ADC conversions read as done. LEDC keeps what's written too.
  *
@@ -16,12 +17,18 @@
 static void test_kept(void)
 {
     QTestState *qts = qtest_init("-machine esp32s3");
-    const uint32_t regs[] = { 0x6000E000, 0x60008800 + 0x40, 0x60006144, 0x60033c34,
+    const uint32_t regs[] = { 0x6000E044, 0x60008800 + 0x40, 0x60006144, 0x60033c34,
                               0x600190A0 /* LEDC timer 0's divider */ };
     for (unsigned i = 0; i < ARRAY_SIZE(regs); i++) {
         qtest_writel(qts, regs[i], 0x12345678);
         g_assert_cmphex(qtest_readl(qts, regs[i]), ==, 0x12345678);
     }
+    /* The analog I2C master's command word (0x6000E000) isn't a plain register: a write
+     * (bit 24) sets the analog register it addresses, a read command finds that
+     * register's value in bits 23:16, and it's never busy (bit 25) */
+    qtest_writel(qts, 0x6000E000, 0x05000000 | 0x5a << 16 | 3 << 8 | 0x67);
+    qtest_writel(qts, 0x6000E000, 0x04000000 | 3 << 8 | 0x67);
+    g_assert_cmphex(qtest_readl(qts, 0x6000E000), ==, 0x04000000 | 0x5a << 16 | 3 << 8 | 0x67);
     qtest_quit(qts);
 }
 
diff --git a/tests/qtest/esp32s3-sdr-test.c b/tests/qtest/esp32s3-sdr-test.c
new file mode 100644
index 0000000..053e51a
--- /dev/null
+++ b/tests/qtest/esp32s3-sdr-test.c
@@ -0,0 +1,253 @@
+/*
+ * QTest for the ESP32-S3 radio as an SDR (esp32s3_sdr.c): the MAC's dump engine, the
+ * SRAM bank it writes, and the LO as the PHY tunes it through the analog I2C master.
+ * The register sequences are ESPARGOS esp-sdr's (main/targets/esp32s3/receiver.c) and
+ * esp-sdr-zephyr's (doc/dev/registers-esp32s3.md).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qemu/bitops.h"
+#include "libqtest.h"
+#include "qapi/qmp/qdict.h"
+
+#define DUMP_CTRL       0x60033d5c
+#define DUMP_INDEX      0x60033d60
+#define DUMP_CONFIG     0x60033d90
+#define SRAM_OWNER      0x600c101c
+#define ANA_CMD         0x6000e000
+#define HOP_REG         0x6000e150
+#define AGC_FORCE       0x6001c02c
+#define BANK2           0x3fcd0000
+
+#define CTRL_RUN        BIT(31)
+#define CTRL_TRIGGER    BIT(19)
+#define CTRL_DONE       BIT(18)
+#define CTRL_RATE_40M   BIT(15)
+#define CTRL_RATE_16M   BIT(16)
+#define LANES_IQ        0x000c2040
+#define MARKER          0xa5a0055a
+
+static void ana_write(QTestState *qts, unsigned block, unsigned reg, unsigned data)
+{
+    qtest_writel(qts, ANA_CMD + 4, 0x05000000 | data << 16 | reg << 8 | block);
+}
+
+static unsigned ana_read(QTestState *qts, unsigned block, unsigned reg)
+{
+    qtest_writel(qts, ANA_CMD + 4, 0x04000000 | reg << 8 | block);
+    uint32_t v = qtest_readl(qts, ANA_CMD + 4);
+    g_assert_cmphex(v & BIT(25), ==, 0);                     /* Not busy */
+    return v >> 16 & 0xff;
+}
+
+static uint32_t qom_u32(QTestState *qts, const char *prop)
+{
+    QDict *r = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                         "{'path': '/machine/soc/sdr', 'property': %s}}", prop);
+    g_assert(qdict_haskey(r, "return"));
+    uint32_t v = qdict_get_int(r, "return");
+    qobject_unref(r);
+    return v;
+}
+
+static void set_scene(QTestState *qts, const char *scene)
+{
+    QDict *r = qtest_qmp(qts, "{'execute': 'qom-set', 'arguments': "
+                         "{'path': '/machine/soc/sdr', 'property': 'scene', 'value': %s}}", scene);
+    g_assert(qdict_haskey(r, "return"));
+    qobject_unref(r);
+}
+
+/* esp-sdr's capture: the marker, the lanes, bank 2 to the engine, RUN, TRIGGER pulsed */
+static void capture(QTestState *qts, uint32_t n, uint32_t rate_bits, uint32_t owner)
+{
+    for (uint32_t k = 0; k < n; k++) {
+        qtest_writel(qts, BANK2 + 4 * k, MARKER);
+    }
+    qtest_writel(qts, DUMP_CTRL, 0);
+    qtest_writel(qts, DUMP_CONFIG, LANES_IQ);
+    qtest_writel(qts, SRAM_OWNER, owner);
+    uint32_t ctrl = CTRL_RUN | rate_bits | n;
+    qtest_writel(qts, DUMP_CTRL, ctrl);
+    qtest_writel(qts, DUMP_CTRL, ctrl | CTRL_TRIGGER);
+    qtest_writel(qts, DUMP_CTRL, ctrl);
+}
+
+static void finish(QTestState *qts)
+{
+    qtest_writel(qts, DUMP_CTRL, 0);
+    qtest_writel(qts, SRAM_OWNER, 0);
+}
+
+/* A word as the host sees it: (I, Q), the word's Q negated (esp-sdr: "(I, -Q)") */
+static void word_iq(uint32_t w, double *i, double *q)
+{
+    int iv = w & 0x3ff, qv = w >> 10 & 0x3ff;
+    *i = iv - (iv & 0x200 ? 1024 : 0);
+    *q = -(qv - (qv & 0x200 ? 1024 : 0));
+}
+
+static double tone_at(QTestState *qts, uint32_t n, double fs, double f)
+{
+    double re = 0, im = 0;
+    for (uint32_t k = 0; k < n; k++) {
+        double i, q;
+        word_iq(qtest_readl(qts, BANK2 + 4 * k), &i, &q);
+        double ph = -2 * M_PI * f * k / fs;
+        re += i * cos(ph) - q * sin(ph);
+        im += i * sin(ph) + q * cos(ph);
+    }
+    return hypot(re, im) / n;
+}
+
+/* The PHY's tunings: the fractional-N divider, the hop register, the LO divider */
+static void test_tuning(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    /* 2432 MHz = 30 MHz x (32 + 49 + 0x11/2^8 + 0x11/2^16) */
+    ana_write(qts, 0x63, 0, 0x07);
+    ana_write(qts, 0x63, 3, 49);
+    ana_write(qts, 0x63, 4, 0x11);
+    ana_write(qts, 0x63, 5, 0x11);
+    g_assert_cmpuint(qom_u32(qts, "tuned-khz"), ==, 2412000);   /* Not loaded yet */
+    ana_write(qts, 0x63, 0, 0x17);
+    g_assert_cmpuint(qom_u32(qts, "tuned-khz"), ==, 2432000);
+    g_assert_cmpuint(ana_read(qts, 0x63, 3), ==, 49);           /* Registers read back */
+    g_assert_cmpuint(ana_read(qts, 0x63, 0), ==, 0x17);
+
+    /* The LO divider (block 0x65 register 0 bit 4): the LO is 5/6 of the PLL */
+    ana_write(qts, 0x65, 0, 0x10);
+    g_assert_cmpuint(qom_u32(qts, "pll-khz"), ==, 2432000);
+    g_assert_cmpuint(qom_u32(qts, "tuned-khz"), ==, 2026667);
+    ana_write(qts, 0x65, 0, 0);
+
+    /* A Wi-Fi channel by the hop register: MHz - 2400 in bits 27:20 */
+    qtest_writel(qts, HOP_REG, 37u << 20);
+    g_assert_cmpuint(qom_u32(qts, "tuned-khz"), ==, 2437000);
+    qtest_quit(qts);
+}
+
+/* A tone 250 kHz above the LO, at each rate: DONE after the capture's time on the chip,
+ * the words in bank 2, the tone at +250 kHz (not -250: the word's Q is negated) */
+static void test_tone(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    qtest_writel(qts, HOP_REG, 37u << 20);                       /* 2437 MHz */
+    set_scene(qts, "tone,f=2437.25,a=200;tone,f=2460,a=300");   /* The second: out of band */
+    static const struct { uint32_t bits; double fs; } rates[] = {
+        { 0, 80e6 }, { CTRL_RATE_40M, 40e6 }, { CTRL_RATE_16M, 16e6 },
+    };
+    for (unsigned r = 0; r < ARRAY_SIZE(rates); r++) {
+        const uint32_t n = 1600;
+        capture(qts, n, rates[r].bits, 4);
+        g_assert_cmphex(qtest_readl(qts, DUMP_CTRL) & CTRL_DONE, ==, 0);
+        qtest_clock_step(qts, (int64_t)(n / rates[r].fs * 1e9) + 1);
+        g_assert_cmphex(qtest_readl(qts, DUMP_CTRL) & CTRL_DONE, ==, CTRL_DONE);
+        g_assert_cmpuint(qtest_readl(qts, DUMP_INDEX), ==, n);
+        finish(qts);
+        g_assert_cmpfloat(fabs(tone_at(qts, n, rates[r].fs, 250e3) - 200), <, 2);
+        g_assert_cmpfloat(tone_at(qts, n, rates[r].fs, -250e3), <, 2);
+    }
+    qtest_quit(qts);
+}
+
+/* Noise: about its rms, the same capture for the same seed; and a forced gain index in
+ * every word's bits 27:20 */
+static void test_noise_and_gain(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    set_scene(qts, "noise,a=20");
+    qtest_writel(qts, AGC_FORCE, 0x2a805200);                    /* Forced, index 42 */
+    capture(qts, 4000, 0, 4);
+    qtest_clock_step(qts, 100000);
+    finish(qts);
+    double sum = 0;
+    for (int k = 0; k < 4000; k++) {
+        uint32_t w = qtest_readl(qts, BANK2 + 4 * k);
+        double i, q;
+        word_iq(w, &i, &q);
+        sum += i * i + q * q;
+        g_assert_cmpuint(w >> 20 & 0xff, ==, 42);
+    }
+    g_assert_cmpfloat(fabs(sqrt(sum / 8000) - 20), <, 1.5);
+    qtest_quit(qts);
+}
+
+/* Captures go only into a bank handed to the engine, and only receive I/Q is modelled */
+static void test_bank_and_lanes(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    set_scene(qts, "noise,a=50");
+    capture(qts, 64, 0, 0);                                      /* No bank: nothing */
+    qtest_clock_step(qts, 10000);
+    finish(qts);
+    for (int k = 0; k < 64; k++) {
+        g_assert_cmphex(qtest_readl(qts, BANK2 + 4 * k), ==, MARKER);
+    }
+    capture(qts, 64, 0, 4);
+    qtest_writel(qts, DUMP_CONFIG, 0x00145105);                  /* Other sources */
+    qtest_writel(qts, DUMP_CTRL, 0);                             /* Again, with them */
+    qtest_writel(qts, DUMP_CTRL, CTRL_RUN | 64);
+    qtest_writel(qts, DUMP_CTRL, CTRL_RUN | CTRL_TRIGGER | 64);
+    qtest_clock_step(qts, 10000);
+    finish(qts);
+    for (int k = 0; k < 64; k++) {
+        g_assert_cmphex(qtest_readl(qts, BANK2 + 4 * k), ==, 0);
+    }
+    qtest_quit(qts);
+}
+
+/* An AM burst with Manchester data, as an AGB-015's: at 80 MS/s a half-bit at 5 Mbit/s
+ * is 8 samples. The envelope gives back the bits, IEEE polarity: a 0 is high then low */
+static void test_am_burst(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    ana_write(qts, 0x63, 3, 49);                                 /* 2432 MHz */
+    ana_write(qts, 0x63, 4, 0x11);
+    ana_write(qts, 0x63, 5, 0x11);
+    ana_write(qts, 0x63, 0, 0x17);
+    int64_t now = qtest_clock_step(qts, 1000);
+    /* The burst starts 1 us after the capture does: 80 samples in */
+    g_autofree char *scene = g_strdup_printf(
+        "am,f=2432.1,a=300,depth=0.6,rate=5e6,bits=a5c3,lead=4,tail=4,period=1,start=%.9f",
+        now * 1e-9 + 1e-6);
+    set_scene(qts, scene);
+    capture(qts, 1000, 0, 4);
+    qtest_clock_step(qts, 20000);
+    finish(qts);
+    double env[1000];
+    for (int k = 0; k < 1000; k++) {
+        double i, q;
+        word_iq(qtest_readl(qts, BANK2 + 4 * k), &i, &q);
+        env[k] = hypot(i, q);
+    }
+    g_assert_cmpfloat(env[40], <, 2);                            /* Before: silence */
+    g_assert_cmpfloat(fabs(env[80 + 32] - 300), <, 2);           /* Lead: the carrier */
+    const unsigned bits = 0xa5c3;
+    for (int b = 0; b < 16; b++) {
+        int first = 80 + 64 + 16 * b + 4, second = first + 8;   /* Mid half-bit */
+        unsigned bit = bits >> (15 - b) & 1;
+        double hi = 300, lo = 300 * 0.4;
+        g_assert_cmpfloat(fabs(env[first] - (bit ? lo : hi)), <, 2);
+        g_assert_cmpfloat(fabs(env[second] - (bit ? hi : lo)), <, 2);
+    }
+    g_assert_cmpfloat(fabs(env[80 + 64 + 256 + 32] - 300), <, 2);   /* Tail */
+    g_assert_cmpfloat(env[80 + 64 + 256 + 64 + 8], <, 2);            /* After */
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/sdr/tuning", test_tuning);
+    qtest_add_func("/esp32s3/sdr/tone", test_tone);
+    qtest_add_func("/esp32s3/sdr/noise-and-gain", test_noise_and_gain);
+    qtest_add_func("/esp32s3/sdr/bank-and-lanes", test_bank_and_lanes);
+    qtest_add_func("/esp32s3/sdr/am-burst", test_am_burst);
+    return g_test_run();
+}
