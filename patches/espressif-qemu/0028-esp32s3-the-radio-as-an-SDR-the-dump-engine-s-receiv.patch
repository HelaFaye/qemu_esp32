diff --git a/include/hw/misc/esp32s3_sdr.h b/include/hw/misc/esp32s3_sdr.h
new file mode 100644
index 0000000..09e7bab
--- /dev/null
+++ b/include/hw/misc/esp32s3_sdr.h
@@ -0,0 +1,57 @@
+/*
+ * ESP32-S3 radio as a software-defined radio: the MAC's debug dump engine (receive)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_SDR "esp32s3.sdr"
+#define ESP32S3_SDR(obj) OBJECT_CHECK(ESP32S3SdrState, (obj), TYPE_ESP32S3_SDR)
+
+#define ESP32S3_SDR_DUMP_BASE   0x60033d5c      /* DUMP_CTRL_REG .. DUMP_CONFIG_REG */
+#define ESP32S3_SDR_DUMP_SIZE   0x38
+#define ESP32S3_SDR_OWNER_REG   0x600c101c      /* SENSITIVE_INTERNAL_SRAM_USAGE_3_REG */
+#define ESP32S3_SDR_AGC_BASE    0x6001c000      /* The AGC: kept (the PHY's gain set-up) */
+#define ESP32S3_SDR_AGC_SIZE    0x1000
+#define ESP32S3_SDR_ANA_BASE    0x6000e000      /* The analog I2C master's two command words */
+#define ESP32S3_SDR_HOP_REG     0x6000e150      /* The PHY's channel hop: MHz - 2400 in 27:20 */
+
+typedef struct ESP32S3SdrSource ESP32S3SdrSource;
+
+typedef struct ESP32S3SdrState {
+    SysBusDevice parent_obj;
+    MemoryRegion dump_mem;
+    MemoryRegion owner_mem;
+    MemoryRegion agc_mem;
+    uint32_t agc[ESP32S3_SDR_AGC_SIZE / 4];
+
+    uint32_t ctrl;              /* DUMP_CTRL_REG, without DONE */
+    uint32_t dac_trig;          /* DUMP_DAC_TRIG_REG: kept (transmit is not modelled yet) */
+    uint32_t config;            /* DUMP_CONFIG_REG: the lane selectors */
+    uint32_t owner;             /* SRAM_USAGE_3: banks handed to the engine */
+    uint32_t written;           /* Words the last capture wrote */
+    uint32_t count;             /* Words it was asked for */
+    int64_t done_ns;            /* When it finishes, in virtual time (0: none running) */
+
+    uint8_t ana[256][16];       /* The analog blocks' registers, by block and register */
+    uint32_t ana_cmd[2];        /* Each master's last command word, for its readback */
+    uint32_t pll_khz;           /* The RF PLL, from the last tuning the PHY made */
+    uint32_t tuned_khz;         /* The LO: the PLL, times 5/6 with the LO divider on */
+
+    char *scene;                /* What's on the air (see esp32s3_sdr.c) */
+    ESP32S3SdrSource *sources;
+    unsigned nsources;
+    uint32_t seed;
+    uint32_t captures;          /* For tests: captures made */
+} ESP32S3SdrState;
+
+/* The analog I2C master and the hop register are in the SoC's general I/O block: it
+ * passes their accesses here. NULL until the device is realized. */
+extern ESP32S3SdrState *esp32s3_sdr;
+bool esp32s3_sdr_io_read(ESP32S3SdrState *s, hwaddr addr, uint64_t *value);
+void esp32s3_sdr_io_write(ESP32S3SdrState *s, hwaddr addr, uint64_t value);
