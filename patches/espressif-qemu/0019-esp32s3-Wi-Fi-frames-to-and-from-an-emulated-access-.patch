+/*
+ * The Wi-Fi MAC's frame DMA and an access point behind it (esp32_wifi), from Martin
+ * Johnson's ESP32 emulation: only with -nic ...,model=esp32_wifi (as -nic user, the
+ * access point's network is QEMU's user-mode one: DHCP, and the host at 10.0.2.2).
+ * Without it, the MAC's registers are the remembered block below, as before: Wi-Fi
+ * starts and finds no network.
+ */
+#define ESP32S3_WIFI_MAC_BASE 0x60033000
+static void esp32s3_init_wifi(Esp32s3SocState *ms)
+{
+    DeviceState *wifi = qemu_create_nic_device(TYPE_ESP32_WIFI, false, NULL);
+    if (!wifi) {
+        return;
+    }
+    SysBusDevice *sbd = SYS_BUS_DEVICE(wifi);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    memory_region_add_subregion_overlap(get_system_memory(), ESP32S3_WIFI_MAC_BASE,
+                                        sysbus_mmio_get_region(sbd, 0), 1);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(DEVICE(&ms->intmatrix), ETS_WIFI_MAC_INTR_SOURCE));
+
+    /* With no eFuse file, the chip's factory MAC (BLOCK1's first 48 bits, which
+     * ESP-IDF reads byte-reversed) is the NIC's: unique for each -nic, or its mac= */
+    ESPEfuseState *efuse = ESP_EFUSE(&ms->efuse);
+    if (!efuse->blk && efuse->mirror) {
+        uint8_t *blk1 = (uint8_t *)efuse->mirror + ESP_EFUSE_BLOCK0_WORDS * 4;
+        const uint8_t *mac = ESP32_WIFI(wifi)->conf.macaddr.a;
+        for (int i = 0; i < 6; i++) {
+            blk1[i] = mac[5 - i];
+        }
+    }
+}
+
+
 static void esp32s3_soc_realize(DeviceState *dev, Error **errp)
 {
     Esp32s3SocState *s = ESP32S3_SOC(dev);
@@ -584,7 +618,10 @@ static void esp32s3_soc_realize(DeviceState *dev, Error **errp)
 /* The block these are in (the analog I2C master and its calibration engines): it keeps
  * what's written, so the PHY's read-modify-writes read back what they set */
 #define ESP32S3_ANA_BLOCK_START        0x6000E000
-#define ESP32S3_ANA_BLOCK_WORDS        64
+#define ESP32S3_ANA_BLOCK_WORDS        128
+/* The RF PLL's frequency (bits 20-27, (MHz - 2400) / 2 + ...): the channel the radio is
+ * on, for the access point (esp32_wifi), as Martin Johnson's emulation decodes it */
+#define ESP32S3_ANA_RF_FREQ_REG        0x6000E150
 /* The TX DC-offset measurement (txdc_cal_v70): written with its start bit (1), it reports
  * done in bit 24, then the comparator in bits 30-31 (0 here: no analog front end) */
 #define ESP32S3_ANA_TXDC_MEAS_REG      0x6000E04C
@@ -692,6 +729,9 @@ static void esp32s3_io_write(void *opaque, hwaddr addr, uint64_t value, unsigned
     unsigned i;
     if (esp32s3_ana_word(ESP32S3_IO_START_ADDR + addr, &i)) {
         esp32s3_ana_block[i] = value;
+        if (ESP32S3_IO_START_ADDR + addr == ESP32S3_ANA_RF_FREQ_REG) {
+            esp32_wifi_channel = MIN(((int)((value >> 20) & 0xff) - 7) / 5, 14);
+        }
         return;
     }
 #if ESP32S3_IO_WARNING
@@ -949,6 +989,9 @@ static void esp32s3_machine_init(MachineState *machine)
                        qdev_get_gpio_in(intmatrix_dev, ETS_EFUSE_INTR_SOURCE));
     }
 
+    /* Wi-Fi, if a -nic asks for it: after the eFuses, which take its MAC */
+    esp32s3_init_wifi(ss);
