diff --git a/include/hw/misc/esp32_wifi.h b/include/hw/misc/esp32_wifi.h
new file mode 100644
index 0000000..de3757e
--- /dev/null
+++ b/include/hw/misc/esp32_wifi.h
@@ -0,0 +1,94 @@
+/*
+ * ESP32 Wi-Fi MAC emulation: frame DMA to and from an emulated access point.
+ *
+ * From Martin Johnson's ESP32 emulation (github.com/a159x36/qemu, branch
+ * esp-develop-9.2), with the S3's receive registers ESP-IDF 5.4 follows (the
+ * descriptor last filled, the next one, reload), RSSI in dBm, and an ssid property.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "hw/hw.h"
+#include "hw/registerfields.h"
+#include "hw/sysbus.h"
+//#include "hw/misc/esp32_reg.h"
+#include "sysemu/sysemu.h"
+#include "net/net.h"
+
+#define TYPE_ESP32_WIFI "esp32_wifi"
+#define ESP32_WIFI(obj) OBJECT_CHECK(Esp32WifiState, (obj), TYPE_ESP32_WIFI)
+
+typedef struct dma_list_item {
+    unsigned size:12;
+    unsigned length:12;
+    unsigned :6;
+    unsigned eof:1;
+    unsigned owner:1;
+    uint32_t address;
+    uint32_t next;
+} QEMU_PACKED dma_list_item;
+
+typedef struct Esp32WifiState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    int raw_interrupt;
+    qemu_irq irq;
+    uint32_t mem[1024];
+    int dma_inlink_address;
+    uint32_t rx_last_desc;      /* The receive descriptor last filled (S3) */
+    uint32_t ap_state;
+    int inject_queue_size;
+    struct mac80211_frame *inject_queue;
+    int inject_timer_running;
+    unsigned int inject_sequence_number;
+    int beacon_ap;
+    bool iss3;
+    char *ssid;
+
+    hwaddr receive_queue_address;
+    uint32_t receive_queue_count;
+    NICConf conf;
+    NICState *nic;
+    // various timers
+    QEMUTimer *beacon_timer;
+    QEMUTimer *inject_timer;
+    uint8_t ipaddr[4];
+    uint8_t macaddr[6];
+
+    uint8_t ap_ipaddr[4];
+    uint8_t ap_macaddr[6];
+
+    uint8_t associated_ap_macaddr[6];
+    uint8_t sta_macaddr[6];             /* The station's, as it sends */
+} Esp32WifiState;
+
+
+/* The channel the radio is tuned to (set from the RF PLL's frequency by the SoC) */
+extern int esp32_wifi_channel;
+
+void Esp32_WLAN_handle_frame(Esp32WifiState *s, struct mac80211_frame *frame);
+void Esp32_WLAN_setup_ap(DeviceState *dev,Esp32WifiState *s);
+void Esp32_sendFrame(Esp32WifiState *s, struct mac80211_frame *frame,int length, int signal_strength);
+
+REG32(WIFI_DMA_IN_STATUS, 0x84);
+REG32(WIFI_DMA_INLINK, 0x88);
+REG32(WIFI_DMA_INT_STATUS, 0xc48);
+REG32(WIFI_DMA_INT_CLR, 0xc4c);
+REG32(WIFI_STATUS, 0xcc8);
+REG32(WIFI_DMA_OUTLINK, 0xd20);
+REG32(WIFI_DMA_OUT_STATUS, 0xd24);
+
+REG32(WIFI_DMA_IN_STATUS_S3, 0x84);      /* Written: bit 0 reloads the list */
+REG32(WIFI_DMA_RX_NEXT_S3, 0x8c);        /* The DMA's next receive descriptor */
+REG32(WIFI_DMA_RX_LAST_S3, 0x90);        /* The one last filled (low 20 bits) */
+REG32(WIFI_DMA_RX_HIGH_S3, 0xc64);       /* Bits 20-31: their high bits, DRAM's */
+REG32(WIFI_DMA_INLINK_S3, 0x88);
+REG32(WIFI_DMA_INT_STATUS_S3, 0xc3c);
+REG32(WIFI_DMA_INT_CLR_S3, 0xc40);
+REG32(WIFI_STATUS_S3, 0xcb0);
+REG32(WIFI_DMA_OUTLINK_S3, 0xd08);
+REG32(WIFI_DMA_OUT_STATUS_S3, 0xd14);
diff --git a/tests/qtest/esp32s3-wifi-test.c b/tests/qtest/esp32s3-wifi-test.c
new file mode 100644
index 0000000..8ebfd5e
--- /dev/null
+++ b/tests/qtest/esp32s3-wifi-test.c
@@ -0,0 +1,157 @@
+/*
+ * QTest for the ESP32-S3's Wi-Fi MAC (esp32_wifi) and the access point behind it, as
+ * ESP-IDF 5.4's driver uses them: receive descriptors given at INLINK, filled with a
+ * frame and its receive header; the last descriptor filled and the next one read
+ * back (0x90, 0x8c); a reload after descriptors are appended (0x84); a frame sent from
+ * a descriptor at OUTLINK and answered. The radio is on the channel the RF PLL is set
+ * to (0x6000E150): the access point "Open Wifi" is on channel 4.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "libqtest.h"
+
+#define MAC             0x60033000
+#define RX_RELOAD       (MAC + 0x84)
+#define RX_BASE         (MAC + 0x88)
+#define RX_NEXT         (MAC + 0x8c)
+#define RX_LAST         (MAC + 0x90)
+#define INT_STATUS      (MAC + 0xc3c)
+#define INT_CLR         (MAC + 0xc40)
+#define TX_LINK         (MAC + 0xd08)
+#define RF_FREQ         0x6000E150
+
+#define DESC0           0x3FCA0000
+#define DESC1           0x3FCA0010
+#define BUF0            0x3FCA1000
+#define BUF1            0x3FCA1800
+#define TX_DESC         0x3FCA0100
+#define TX_BUF          0x3FCA2000
+
+static const uint8_t sta[6] = { 0x52, 0x54, 0x00, 0x12, 0x34, 0x56 };
+static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+
+static void rx_desc(QTestState *qts, uint32_t desc, uint32_t buf, uint32_t next)
+{
+    qtest_writel(qts, desc, BIT(31) | (1600 << 12) | 1600);        /* DMA-owned, empty */
+    qtest_writel(qts, desc + 4, buf);
+    qtest_writel(qts, desc + 8, next);
+}
+
+/* The 802.11 frame in a received buffer, after its receive header: found by its
+ * frame control byte and destination address */
+static const uint8_t *find_frame(const uint8_t *buf, size_t len, uint8_t fc, const uint8_t *da)
+{
+    for (size_t i = 0; i + 10 <= len && i < 128; i++) {
+        if (buf[i] == fc && buf[i + 1] == 0 && !memcmp(buf + i + 4, da, 6)) {
+            return buf + i;
+        }
+    }
+    return NULL;
+}
+
+static QTestState *radio_on_channel_4(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3 -nic user,model=esp32_wifi");
+    qtest_writel(qts, RF_FREQ, (4 * 5 + 7) << 20);
+    return qts;
+}
+
+/* A beacon from "Open Wifi" lands in the first descriptor; the MAC reports it */
+static void test_beacon(void)
+{
+    QTestState *qts = radio_on_channel_4();
+    rx_desc(qts, DESC0, BUF0, 0);
+    qtest_writel(qts, RX_BASE, DESC0);
+    g_assert_cmphex(qtest_readl(qts, RX_NEXT), ==, DESC0);
+
+    qtest_clock_step(qts, 200 * 1000 * 1000);                      /* Beacons every 10 ms */
+
+    uint32_t w0 = qtest_readl(qts, DESC0);
+    g_assert_cmphex(w0 & BIT(30), ==, BIT(30));                    /* EOF: filled */
+    uint32_t len = (w0 >> 12) & 0xfff;
+    g_assert_cmpuint(len, >, 40);
+    uint8_t buf[256];
+    qtest_memread(qts, BUF0, buf, sizeof buf);
+    const uint8_t *f = find_frame(buf, MIN(len, sizeof buf), 0x80, bcast);    /* Beacon */
+    g_assert_nonnull(f);
+    g_assert_nonnull(memmem(f, buf + sizeof buf - f, "Open Wifi", 9));
+    g_assert_cmpint((int8_t)buf[0], ==, -40);                      /* RSSI, dBm */
+
+    /* The driver's view: the last descriptor filled, no next one, an interrupt */
+    g_assert_cmphex(qtest_readl(qts, RX_LAST), ==, DESC0 & 0xfffff);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc64) & 0xfff00000, ==, 0x3fc00000);
+    g_assert_cmphex(qtest_readl(qts, RX_NEXT), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, INT_STATUS), !=, 0);
+    qtest_writel(qts, INT_CLR, qtest_readl(qts, INT_STATUS));
+    g_assert_cmphex(qtest_readl(qts, INT_STATUS), ==, 0);
+
+    /* Out of descriptors: one appended after the last, and a reload goes on there */
+    rx_desc(qts, DESC1, BUF1, 0);
+    qtest_writel(qts, DESC0 + 8, DESC1);
+    qtest_writel(qts, RX_RELOAD, 1);
+    g_assert_cmphex(qtest_readl(qts, RX_NEXT), ==, DESC1);
+    qtest_clock_step(qts, 200 * 1000 * 1000);
+    g_assert_cmphex(qtest_readl(qts, DESC1) & BIT(30), ==, BIT(30));
+    g_assert_cmphex(qtest_readl(qts, RX_LAST), ==, DESC1 & 0xfffff);
+    qtest_quit(qts);
+}
+
+/* A probe request sent, and the access point's probe response received */
+static void test_probe(void)
+{
+    QTestState *qts = radio_on_channel_4();
+    rx_desc(qts, DESC0, BUF0, DESC1);
+    rx_desc(qts, DESC1, BUF1, 0);
+    qtest_writel(qts, RX_BASE, DESC0);
+
+    uint8_t req[64] = { 0x40, 0x00, 0x00, 0x00 };                  /* Probe request */
+    memcpy(req + 4, bcast, 6);
+    memcpy(req + 10, sta, 6);
+    memcpy(req + 16, bcast, 6);
+    size_t n = 24;
+    req[n++] = 0;                                                   /* SSID */
+    req[n++] = 9;
+    memcpy(req + n, "Open Wifi", 9);
+    n += 9;
+    qtest_memwrite(qts, TX_BUF, req, n);
+    qtest_writel(qts, TX_DESC, BIT(31) | BIT(30) | (n << 12) | n);
+    qtest_writel(qts, TX_DESC + 4, TX_BUF);
+    qtest_writel(qts, TX_DESC + 8, 0);
+    qtest_writel(qts, TX_LINK, (TX_DESC & 0xfffff) | BIT(30));     /* Start */
+    g_assert_cmphex(qtest_readl(qts, INT_STATUS) & 0x80, ==, 0x80); /* Sent */
+
+    qtest_clock_step(qts, 20 * 1000 * 1000);                       /* Before any beacon */
+    g_assert_cmphex(qtest_readl(qts, DESC0) & BIT(30), ==, BIT(30));
+    uint8_t buf[256];
+    qtest_memread(qts, BUF0, buf, sizeof buf);
+    const uint8_t *f = find_frame(buf, sizeof buf, 0x50, sta);     /* Probe response */
+    g_assert_nonnull(f);
+    g_assert_nonnull(memmem(f, buf + sizeof buf - f, "Open Wifi", 9));
+    qtest_quit(qts);
+}
+
+/* Off the access point's channel, nothing is heard */
+static void test_other_channel(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3 -nic user,model=esp32_wifi");
+    qtest_writel(qts, RF_FREQ, (1 * 5 + 7) << 20);                  /* Channel 1 */
+    rx_desc(qts, DESC0, BUF0, 0);
+    qtest_writel(qts, RX_BASE, DESC0);
+    qtest_clock_step(qts, 200 * 1000 * 1000);
+    g_assert_cmphex(qtest_readl(qts, DESC0) & BIT(30), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/wifi/beacon", test_beacon);
+    qtest_add_func("/esp32s3/wifi/probe", test_probe);
+    qtest_add_func("/esp32s3/wifi/other-channel", test_other_channel);
+    return g_test_run();
+}
