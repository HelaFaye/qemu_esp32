diff --git a/include/hw/display/mipi_dbi_panel.h b/include/hw/display/mipi_dbi_panel.h
new file mode 100644
index 0000000..c014910
--- /dev/null
+++ b/include/hw/display/mipi_dbi_panel.h
@@ -0,0 +1,69 @@
+/*
+ * MIPI DBI display controllers (MIPI DCS command set): ILI9341, ILI9488, ST7735, ST7789,
+ * ST7796, GC9A01. The engine (frame memory, address window, MADCTL, pixel formats,
+ * sleep/display on, inversion, read commands) is shared by the bus front ends: SPI (an
+ * SSI peripheral with a D/C line) here, and 8080 parallel buses elsewhere.
+ *
+ *   -device ili9341,bus=spi2,id=lcd    then pin-links for its lines:
+ *     "ssi-gpio-cs" (active low), "dc" (0: command, 1: data), "reset" (active low),
+ *     "backlight" (on when high unless backlight-active-low; on if never connected)
+ *
+ * The panel is a graphic console: `screendump` captures what the glass shows.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#pragma once
+
+#include "hw/ssi/ssi.h"
+#include "ui/console.h"
+
+#define TYPE_MIPI_DBI_PANEL "mipi-dbi-panel"
+OBJECT_DECLARE_SIMPLE_TYPE(MipiDbiPanelState, MIPI_DBI_PANEL)
+
+typedef struct MipiDbiPanelModel {
+    const char *name;
+    uint16_t ram_w, ram_h;              /* Frame memory */
+    uint16_t width, height;             /* The glass, at x/y offset in the frame memory */
+    uint16_t x_off, y_off;
+    uint8_t id[3];                      /* RDDID (0x04) */
+    bool mirror_x, mirror_y;            /* How the module mounts the glass */
+    bool bgr;                           /* MADCTL.BGR set gives the right colors */
+    bool inverted;                      /* INVON gives the right colors (IPS panels) */
+    bool rgb666_only;                   /* No 16-bit pixels on SPI (ILI9488) */
+} MipiDbiPanelModel;
+
+struct MipiDbiPanelState {
+    SSIPeripheral parent_obj;
+
+    const MipiDbiPanelModel *model;
+    QemuConsole *con;
+    uint32_t *ram;                      /* RGB888, ram_w x ram_h */
+
+    /* Properties: a module can override its model's geometry and mounting */
+    uint32_t width, height, x_off, y_off;
+    bool mirror_x, mirror_y, bgr, inverted, backlight_active_low;
+
+    /* Lines */
+    bool dc, in_reset, backlight, backlight_wired;
+
+    /* Controller state */
+    uint8_t cmd;
+    uint32_t nparam;
+    uint8_t param[16];
+    bool sleeping, display_on, inversion, idle;
+    uint8_t madctl, colmod;
+    uint16_t xs, xe, ys, ye;            /* CASET / RASET */
+    uint16_t col, row;                  /* The write pointer */
+    uint8_t pix[3];                     /* A pixel's bytes so far */
+    uint8_t npix;
+    uint8_t rd[8];                      /* A read command's reply */
+    uint8_t rd_len, rd_pos;
+    bool dirty;
+};
+
+/* For bus front ends: a command (D/C low) or a data byte, and a reply byte for reads */
+void mipi_dbi_panel_command(MipiDbiPanelState *s, uint8_t cmd);
+void mipi_dbi_panel_data(MipiDbiPanelState *s, uint8_t data);
+uint8_t mipi_dbi_panel_read(MipiDbiPanelState *s);
diff --git a/tests/qtest/esp32s3-spi-devices-test.c b/tests/qtest/esp32s3-spi-devices-test.c
new file mode 100644
index 0000000..59e3922
--- /dev/null
+++ b/tests/qtest/esp32s3-spi-devices-test.c
@@ -0,0 +1,308 @@
+/*
+ * QTest for SPI devices on the ESP32-S3's GP-SPI2, wired as gbagate's carrier-touch board:
+ * an ILI9341 (CS GPIO10, D/C GPIO9), an XPT2046 (CS GPIO16, PENIRQ GPIO17) and a microSD
+ * card in SPI mode (CS GPIO15). Chip selects are GPIOs driven by hand here, as Arduino's
+ * TFT_eSPI and SD libraries do; the GP-SPI test covers the controller's own.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qapi/qmp/qdict.h"
+#include "libqtest.h"
+
+#define SPI2            0x60024000
+#define SPI_CMD         (SPI2 + 0x00)
+#define SPI_CLOCK       (SPI2 + 0x0C)
+#define SPI_USER        (SPI2 + 0x10)
+#define SPI_MS_DLEN     (SPI2 + 0x1C)
+#define SPI_MISC        (SPI2 + 0x20)
+#define SPI_INT_CLR     (SPI2 + 0x38)
+#define SPI_INT_RAW     (SPI2 + 0x3C)
+#define SPI_W0          (SPI2 + 0x98)
+#define SPI_CLK_GATE    (SPI2 + 0xE8)
+
+#define GPIO            0x60004000
+#define OUT_W1TS        (GPIO + 0x08)
+#define OUT_W1TC        (GPIO + 0x0C)
+#define ENABLE_W1TS     (GPIO + 0x24)
+#define IN              (GPIO + 0x3C)
+
+#define PIN_DC          9
+#define PIN_LCD_CS      10
+#define PIN_SD_CS       15
+#define PIN_TOUCH_CS    16
+#define PIN_TOUCH_IRQ   17
+
+#define BOARD \
+    "-machine esp32s3 " \
+    "-device ili9341,bus=spi2,id=lcd " \
+    "-device esp32s3.pin-link,pin=10,dev=lcd,line=ssi-gpio-cs,pull=up " \
+    "-device esp32s3.pin-link,pin=9,dev=lcd,line=dc " \
+    "-device xpt2046,bus=spi2,cs=1,id=touch " \
+    "-device esp32s3.pin-link,pin=16,dev=touch,line=ssi-gpio-cs,pull=up " \
+    "-device esp32s3.pin-link,pin=17,dev=touch,line=penirq,dir=out,open-drain=on,pull=up "
+
+static void board_init(QTestState *qts)
+{
+    qtest_writel(qts, SPI_CLK_GATE, 0x7);
+    qtest_writel(qts, SPI_CLOCK, BIT(31));          /* 80 MHz */
+    qtest_writel(qts, SPI_MISC, 0x3F);              /* No hardware CS: GPIOs */
+    qtest_writel(qts, SPI_USER, BIT(0) | BIT(27) | BIT(28));   /* Full duplex */
+    uint32_t pins = BIT(PIN_DC) | BIT(PIN_LCD_CS) | BIT(PIN_SD_CS) | BIT(PIN_TOUCH_CS);
+    qtest_writel(qts, OUT_W1TS, pins & ~BIT(PIN_DC));
+    qtest_writel(qts, ENABLE_W1TS, pins);
+}
+
+static void pin(QTestState *qts, int n, int level)
+{
+    qtest_writel(qts, level ? OUT_W1TS : OUT_W1TC, BIT(n));
+}
+
+/* n bytes out and in, through the W buffer, 64 at a time */
+static void xfer(QTestState *qts, const uint8_t *tx, uint8_t *rx, size_t n)
+{
+    for (size_t off = 0; off < n; off += 64) {
+        size_t len = MIN(64, n - off);
+        uint32_t w[16] = { 0 };
+        memcpy(w, tx + off, len);
+        for (int i = 0; i < 16; i++) {
+            qtest_writel(qts, SPI_W0 + 4 * i, w[i]);
+        }
+        qtest_writel(qts, SPI_MS_DLEN, len * 8 - 1);
+        qtest_writel(qts, SPI_INT_CLR, BIT(12));
+        qtest_writel(qts, SPI_CMD, BIT(24));
+        qtest_clock_step(qts, 100000);
+        g_assert_cmphex(qtest_readl(qts, SPI_INT_RAW) & BIT(12), ==, BIT(12));
+        if (rx) {
+            for (int i = 0; i < 16; i++) {
+                w[i] = qtest_readl(qts, SPI_W0 + 4 * i);
+            }
+            memcpy(rx + off, w, len);
+        }
+    }
+}
+
+static void lcd_cmd(QTestState *qts, uint8_t cmd, const uint8_t *data, size_t n)
+{
+    pin(qts, PIN_LCD_CS, 0);
+    pin(qts, PIN_DC, 0);
+    xfer(qts, &cmd, NULL, 1);
+    pin(qts, PIN_DC, 1);
+    if (n) {
+        xfer(qts, data, NULL, n);
+    }
+    pin(qts, PIN_LCD_CS, 1);
+}
+
+/* The panel's glass, from QMP screendump (PPM, P6) */
+static uint8_t *screendump(QTestState *qts, int *w, int *h)
+{
+    g_autofree char *path = g_strdup_printf("%s/qtest-lcd-%d.ppm", g_get_tmp_dir(), getpid());
+    QDict *resp = qtest_qmp(qts, "{'execute': 'screendump', 'arguments': {'filename': %s, 'device': 'lcd'}}",
+                            path);
+    g_assert(qdict_haskey(resp, "return"));
+    qobject_unref(resp);
+    gchar *data;
+    gsize len;
+    g_assert(g_file_get_contents(path, &data, &len, NULL));
+    unlink(path);
+    int maxval, off;
+    g_assert_cmpint(sscanf(data, "P6 %d %d %d%n", w, h, &maxval, &off), ==, 3);
+    uint8_t *px = g_memdup2(data + off + 1, (size_t)*w * *h * 3);
+    g_free(data);
+    return px;
+}
+
+static void test_lcd(void)
+{
+    QTestState *qts = qtest_init(BOARD);
+    board_init(qts);
+
+    /* Read the ID: a dummy byte, then 00 93 41 */
+    uint8_t cmd = 0x04, rx[4], tx[4] = { 0 };
+    pin(qts, PIN_LCD_CS, 0);
+    pin(qts, PIN_DC, 0);
+    xfer(qts, &cmd, NULL, 1);
+    pin(qts, PIN_DC, 1);
+    xfer(qts, tx, rx, 4);
+    pin(qts, PIN_LCD_CS, 1);
+    g_assert_cmphex(rx[1], ==, 0x00);
+    g_assert_cmphex(rx[2], ==, 0x93);
+    g_assert_cmphex(rx[3], ==, 0x41);
+
+    /* TFT_eSPI's start for rotation 0: sleep out, 16 bits, MX|BGR, display on */
+    lcd_cmd(qts, 0x11, NULL, 0);
+    lcd_cmd(qts, 0x3A, (uint8_t[]){ 0x55 }, 1);
+    lcd_cmd(qts, 0x36, (uint8_t[]){ 0x48 }, 1);
+    lcd_cmd(qts, 0x29, NULL, 0);
+
+    /* A 2x2 block at (10, 20): red, green / blue, white */
+    lcd_cmd(qts, 0x2A, (uint8_t[]){ 0, 10, 0, 11 }, 4);
+    lcd_cmd(qts, 0x2B, (uint8_t[]){ 0, 20, 0, 21 }, 4);
+    lcd_cmd(qts, 0x2C, (uint8_t[]){ 0xF8, 0x00, 0x07, 0xE0, 0x00, 0x1F, 0xFF, 0xFF }, 8);
+
+    int w, h;
+    uint8_t *px = screendump(qts, &w, &h);
+    g_assert_cmpint(w, ==, 240);
+    g_assert_cmpint(h, ==, 320);
+#define PX(x, y) (px[((y) * w + (x)) * 3] << 16 | px[((y) * w + (x)) * 3 + 1] << 8 | px[((y) * w + (x)) * 3 + 2])
+    g_assert_cmphex(PX(10, 20), ==, 0xFF0000);
+    g_assert_cmphex(PX(11, 20), ==, 0x00FF00);
+    g_assert_cmphex(PX(10, 21), ==, 0x0000FF);
+    g_assert_cmphex(PX(11, 21), ==, 0xFFFFFF);
+    g_assert_cmphex(PX(12, 20), ==, 0x000000);
+    g_free(px);
+
+    /* Rotation 1 (landscape, MV|BGR): logical (0,0) is the glass's top right */
+    lcd_cmd(qts, 0x36, (uint8_t[]){ 0x28 }, 1);
+    lcd_cmd(qts, 0x2A, (uint8_t[]){ 0, 0, 0, 0 }, 4);
+    lcd_cmd(qts, 0x2B, (uint8_t[]){ 0, 0, 0, 0 }, 4);
+    lcd_cmd(qts, 0x2C, (uint8_t[]){ 0xF8, 0x00 }, 2);
+    px = screendump(qts, &w, &h);
+    g_assert_cmphex(PX(239, 0), ==, 0xFF0000);
+    g_free(px);
+
+    /* Display off: the glass goes dark */
+    lcd_cmd(qts, 0x28, NULL, 0);
+    px = screendump(qts, &w, &h);
+    g_assert_cmphex(PX(10, 20), ==, 0x000000);
+    g_free(px);
+    qtest_quit(qts);
+}
+
+static uint16_t touch_read(QTestState *qts, uint8_t ctrl)
+{
+    uint8_t tx[3] = { ctrl, 0, 0 }, rx[3];
+    pin(qts, PIN_TOUCH_CS, 0);
+    xfer(qts, tx, rx, 3);
+    pin(qts, PIN_TOUCH_CS, 1);
+    return ((rx[1] << 8) | rx[2]) >> 3;
+}
+
+static void test_touch(void)
+{
+    QTestState *qts = qtest_init(BOARD);
+    board_init(qts);
+
+    /* Not touched: PENIRQ high, Z1 0 */
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(PIN_TOUCH_IRQ), ==, BIT(PIN_TOUCH_IRQ));
+    g_assert_cmpint(touch_read(qts, 0xB0), ==, 0);
+
+    qtest_qom_set_bool(qts, "/machine/peripheral/touch", "pressed", true);
+    qobject_unref(qtest_qmp(qts, "{'execute': 'qom-set', 'arguments': {'path': '/machine/peripheral/touch', "
+                                 "'property': 'x', 'value': 1234}}"));
+    qobject_unref(qtest_qmp(qts, "{'execute': 'qom-set', 'arguments': {'path': '/machine/peripheral/touch', "
+                                 "'property': 'y', 'value': 3000}}"));
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(PIN_TOUCH_IRQ), ==, 0);
+    g_assert_cmpint(touch_read(qts, 0xD0), ==, 1234);       /* X */
+    g_assert_cmpint(touch_read(qts, 0x90), ==, 3000);       /* Y */
+    g_assert_cmpint(touch_read(qts, 0xB0), >, 0);           /* Z1 */
+
+    /* XPT2046_Touchscreen's overlapped reads: the next command during this result */
+    uint8_t tx[5] = { 0xD1, 0x91, 0x00, 0xD0, 0x00 }, rx[5];
+    pin(qts, PIN_TOUCH_CS, 0);
+    xfer(qts, tx, rx, 5);
+    pin(qts, PIN_TOUCH_CS, 1);
+    g_assert_cmpint(((rx[1] << 8) | rx[2]) >> 3, ==, 1234);
+    g_assert_cmpint(((rx[3] << 8) | rx[4]) >> 3, ==, 3000);
+
+    /* PD = 01 disables PENIRQ; released, it goes high */
+    touch_read(qts, 0x91);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(PIN_TOUCH_IRQ), ==, BIT(PIN_TOUCH_IRQ));
+    touch_read(qts, 0x90);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(PIN_TOUCH_IRQ), ==, 0);
+    qtest_qom_set_bool(qts, "/machine/peripheral/touch", "pressed", false);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(PIN_TOUCH_IRQ), ==, BIT(PIN_TOUCH_IRQ));
+    qtest_quit(qts);
+}
+
+/* An SD command in SPI mode, and its R1 (the first byte that isn't 0xFF) */
+static uint8_t sd_cmd(QTestState *qts, uint8_t cmd, uint32_t arg, uint8_t crc, uint8_t *extra, int nextra)
+{
+    uint8_t tx[24], rx[24];
+    memset(tx, 0xFF, sizeof(tx));
+    tx[0] = 0x40 | cmd;
+    tx[1] = arg >> 24;
+    tx[2] = arg >> 16;
+    tx[3] = arg >> 8;
+    tx[4] = arg;
+    tx[5] = crc;
+    xfer(qts, tx, rx, sizeof(tx));
+    for (int i = 6; i < (int)sizeof(tx); i++) {
+        if (rx[i] != 0xFF) {
+            for (int j = 0; j < nextra; j++) {
+                extra[j] = i + 1 + j < (int)sizeof(rx) ? rx[i + 1 + j] : 0xFF;
+            }
+            return rx[i];
+        }
+    }
+    return 0xFF;
+}
+
+static void test_sd(void)
+{
+    g_autofree char *img = g_strdup_printf("%s/qtest-sd-%d.img", g_get_tmp_dir(), getpid());
+    g_autofree uint8_t *data = g_malloc0(1024 * 1024);
+    for (int i = 0; i < 512; i++) {
+        data[512 + i] = i * 7;          /* Block 1 */
+    }
+    g_assert(g_file_set_contents(img, (char *)data, 1024 * 1024, NULL));
+
+    g_autofree char *args = g_strdup_printf(BOARD
+        "-drive id=spisd,if=none,format=raw,file=%s "
+        "-device ssi-sd,bus=spi2,cs=2,id=sd,drive=spisd "
+        "-device esp32s3.pin-link,pin=15,dev=sd,line=ssi-gpio-cs,pull=up", img);
+    QTestState *qts = qtest_init(args);
+    board_init(qts);
+
+    /* 74+ clocks with CS high, then the SD library's start */
+    uint8_t ff[10];
+    memset(ff, 0xFF, sizeof(ff));
+    xfer(qts, ff, NULL, sizeof(ff));
+    pin(qts, PIN_SD_CS, 0);
+    g_assert_cmphex(sd_cmd(qts, 0, 0, 0x95, NULL, 0), ==, 0x01);           /* GO_IDLE */
+    uint8_t r7[4];
+    g_assert_cmphex(sd_cmd(qts, 8, 0x1AA, 0x87, r7, 4), ==, 0x01);         /* SEND_IF_COND */
+    g_assert_cmphex(r7[3], ==, 0xAA);
+    uint8_t r1 = 0x01;
+    for (int i = 0; i < 20 && r1 == 0x01; i++) {
+        sd_cmd(qts, 55, 0, 0x65, NULL, 0);
+        r1 = sd_cmd(qts, 41, 0x40000000, 0x77, NULL, 0);                    /* SD_SEND_OP_COND */
+    }
+    g_assert_cmphex(r1, ==, 0x00);
+
+    /* READ_SINGLE_BLOCK 1 (a byte address on a standard capacity card): R1, then the data
+     * token and the block, possibly starting in the command's own transfer */
+    uint8_t blk[700], tx[600];
+    int got = 16;
+    g_assert_cmphex(sd_cmd(qts, 17, 512, 0xFF, blk, got), ==, 0x00);
+    memset(tx, 0xFF, sizeof(tx));
+    xfer(qts, tx, blk + got, sizeof(tx));
+    int start = -1;
+    for (int i = 0; i < 80; i++) {
+        if (blk[i] == 0xFE) {           /* The data token */
+            start = i + 1;
+            break;
+        }
+    }
+    g_assert_cmpint(start, >=, 0);
+    for (int i = 0; i < 512; i++) {
+        g_assert_cmphex(blk[start + i], ==, (uint8_t)(i * 7));
+    }
+    pin(qts, PIN_SD_CS, 1);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/spi-devices/ili9341", test_lcd);
+    qtest_add_func("/esp32s3/spi-devices/xpt2046", test_touch);
+    qtest_add_func("/esp32s3/spi-devices/sd", test_sd);
+    return g_test_run();
+}
