+/*
+ * MIPI DBI display controllers (MIPI DCS): ILI9341, ILI9488, ST7735, ST7789, ST7796, GC9A01
+ *
+ * Writes: CASET/RASET set the window, RAMWR/RAMWRC fill it from the write pointer in
+ * the order MADCTL says (MV exchange, MX/MY mirror), in the COLMOD pixel format (12, 16
+ * or 18 bits). SLPIN/SLPOUT, DISPOFF/DISPON, INVOFF/INVON, IDMOFF/IDMON and SWRESET
+ * change what the glass shows. Reads: RDDID, RDDST, RDDPM, RDDMADCTL, RDDCOLMOD,
+ * RDID1-3 and ILI9341's RDID4 (0xD3), each after a dummy byte as on the SPI bus.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "ui/console.h"
+#include "ui/pixel_ops.h"
+#include "hw/display/mipi_dbi_panel.h"
+
+#define DCS_NOP         0x00
+#define DCS_SWRESET     0x01
+#define DCS_RDDID       0x04
+#define DCS_RDDST       0x09
+#define DCS_RDDPM       0x0A
+#define DCS_RDDMADCTL   0x0B
+#define DCS_RDDCOLMOD   0x0C
+#define DCS_SLPIN       0x10
+#define DCS_SLPOUT      0x11
+#define DCS_INVOFF      0x20
+#define DCS_INVON       0x21
+#define DCS_DISPOFF     0x28
+#define DCS_DISPON      0x29
+#define DCS_CASET       0x2A
+#define DCS_RASET       0x2B
+#define DCS_RAMWR       0x2C
+#define DCS_MADCTL      0x36
+#define DCS_IDMOFF      0x38
+#define DCS_IDMON       0x39
+#define DCS_COLMOD      0x3A
+#define DCS_RAMWRC      0x3C
+#define DCS_RDID1       0xDA
+#define DCS_RDID2       0xDB
+#define DCS_RDID3       0xDC
+#define ILI_RDID4       0xD3
+
+#define MADCTL_MY       0x80
+#define MADCTL_MX       0x40
+#define MADCTL_MV       0x20
+#define MADCTL_BGR      0x08
+
+static const MipiDbiPanelModel models[] = {
+    /* name      ram_w ram_h  w    h   xo  yo  id                  mx    my     bgr   inv    666 */
+    { "ili9341", 240, 320, 240, 320, 0, 0, { 0x00, 0x93, 0x41 }, true,  false, true,  false, false },
+    { "ili9488", 320, 480, 320, 480, 0, 0, { 0x54, 0x80, 0x66 }, true,  false, true,  false, true },
+    { "st7735",  132, 162, 128, 160, 2, 1, { 0x7C, 0x89, 0xF0 }, false, false, false, false, false },
+    { "st7789",  240, 320, 240, 320, 0, 0, { 0x85, 0x85, 0x52 }, false, false, false, true,  false },
+    { "st7796",  320, 480, 320, 480, 0, 0, { 0x00, 0x77, 0x96 }, true,  false, true,  false, false },
+    { "gc9a01",  240, 240, 240, 240, 0, 0, { 0x00, 0x9A, 0x01 }, false, false, true,  true,  false },
+};
+
+static uint16_t win_cols(MipiDbiPanelState *s)
+{
+    return (s->madctl & MADCTL_MV) ? s->model->ram_h : s->model->ram_w;
+}
+
+static uint16_t win_rows(MipiDbiPanelState *s)
+{
+    return (s->madctl & MADCTL_MV) ? s->model->ram_w : s->model->ram_h;
+}
+
+static void put_pixel(MipiDbiPanelState *s, uint32_t rgb)
+{
+    uint16_t c = s->col, p = s->row;
+    if (s->madctl & MADCTL_MX) {
+        c = win_cols(s) - 1 - c;
+    }
+    if (s->madctl & MADCTL_MY) {
+        p = win_rows(s) - 1 - p;
+    }
+    uint16_t x = (s->madctl & MADCTL_MV) ? p : c;
+    uint16_t y = (s->madctl & MADCTL_MV) ? c : p;
+    if (x < s->model->ram_w && y < s->model->ram_h) {
+        s->ram[y * s->model->ram_w + x] = rgb;
+        s->dirty = true;
+    }
+    /* Next: along the column, then the next row of the window, wrapping to the start */
+    if (s->col >= s->xe || s->col >= win_cols(s) - 1) {
+        s->col = s->xs;
+        if (s->row >= s->ye || s->row >= win_rows(s) - 1) {
+            s->row = s->ys;
+        } else {
+            s->row++;
+        }
+    } else {
+        s->col++;
+    }
+}
+
+static int pixel_bytes(MipiDbiPanelState *s)
+{
+    switch (s->colmod & 0x7) {
+    case 3: return 3;       /* 12 bits: 3 bytes for 2 pixels */
+    case 5: return s->model->rgb666_only ? 3 : 2;
+    case 6: return 3;
+    default: return s->model->rgb666_only ? 3 : 2;
+    }
+}
+
+static void pixel_byte(MipiDbiPanelState *s, uint8_t b)
+{
+    s->pix[s->npix++] = b;
+    int need = pixel_bytes(s);
+    if (s->npix < need) {
+        return;
+    }
+    s->npix = 0;
+    if (need == 2) {
+        uint16_t v = (s->pix[0] << 8) | s->pix[1];
+        uint8_t r = (v >> 11) & 0x1F, g = (v >> 5) & 0x3F, bl = v & 0x1F;
+        put_pixel(s, ((r << 3 | r >> 2) << 16) | ((g << 2 | g >> 4) << 8) | (bl << 3 | bl >> 2));
+    } else if ((s->colmod & 0x7) == 3) {
+        /* RRRRGGGG BBBBRRRR GGGGBBBB */
+        uint8_t r0 = s->pix[0] >> 4, g0 = s->pix[0] & 0xF, b0 = s->pix[1] >> 4;
+        uint8_t r1 = s->pix[1] & 0xF, g1 = s->pix[2] >> 4, b1 = s->pix[2] & 0xF;
+        put_pixel(s, (r0 * 0x11) << 16 | (g0 * 0x11) << 8 | b0 * 0x11);
+        put_pixel(s, (r1 * 0x11) << 16 | (g1 * 0x11) << 8 | b1 * 0x11);
+    } else {
+        uint8_t r = s->pix[0] & 0xFC, g = s->pix[1] & 0xFC, bl = s->pix[2] & 0xFC;
+        put_pixel(s, (r | r >> 6) << 16 | (g | g >> 6) << 8 | (bl | bl >> 6));
+    }
+}
+
+static void controller_reset(MipiDbiPanelState *s)
+{
+    s->cmd = DCS_NOP;
+    s->nparam = 0;
+    s->sleeping = true;
+    s->display_on = false;
+    s->inversion = false;
+    s->idle = false;
+    s->madctl = 0;
+    s->colmod = 0x66;                   /* 18 bits per pixel after reset */
+    s->xs = 0;
+    s->ys = 0;
+    s->xe = s->model->ram_w - 1;
+    s->ye = s->model->ram_h - 1;
+    s->col = s->row = 0;
+    s->npix = 0;
+    s->rd_len = s->rd_pos = 0;
+    s->dirty = true;
+}
+
+static void reply(MipiDbiPanelState *s, const uint8_t *bytes, int n)
+{
+    s->rd[0] = 0;               /* The dummy clock(s) before the data */
+    memcpy(s->rd + 1, bytes, n);
+    s->rd_len = n + 1;
+    s->rd_pos = 0;
+}
+
+void mipi_dbi_panel_command(MipiDbiPanelState *s, uint8_t cmd)
+{
+    if (s->in_reset) {
+        return;
+    }
+    s->cmd = cmd;
+    s->nparam = 0;
+    s->npix = 0;
+    s->rd_len = 0;
+
+    switch (cmd) {
+    case DCS_SWRESET:
+        controller_reset(s);
+        break;
+    case DCS_SLPIN:     s->sleeping = true; s->dirty = true; break;
+    case DCS_SLPOUT:    s->sleeping = false; s->dirty = true; break;
+    case DCS_INVOFF:    s->inversion = false; s->dirty = true; break;
+    case DCS_INVON:     s->inversion = true; s->dirty = true; break;
+    case DCS_DISPOFF:   s->display_on = false; s->dirty = true; break;
+    case DCS_DISPON:    s->display_on = true; s->dirty = true; break;
+    case DCS_IDMOFF:    s->idle = false; s->dirty = true; break;
+    case DCS_IDMON:     s->idle = true; s->dirty = true; break;
+    case DCS_RAMWR:
+        s->col = s->xs;
+        s->row = s->ys;
+        break;
+    case DCS_RDDID:
+        reply(s, s->model->id, 3);
+        break;
+    case DCS_RDID1: case DCS_RDID2: case DCS_RDID3:
+        reply(s, &s->model->id[cmd - DCS_RDID1], 1);
+        break;
+    case ILI_RDID4: {
+        const uint8_t id4[3] = { 0x00, s->model->id[1], s->model->id[2] };
+        reply(s, id4, 3);
+        break;
+    }
+    case DCS_RDDST: {
+        const uint8_t st[4] = { (s->sleeping ? 0 : 0x08) | (s->madctl & 0xF0) >> 0,
+                                s->colmod & 0x77,
+                                (s->display_on ? 0x04 : 0) | (s->inversion ? 0x20 : 0), 0 };
+        reply(s, st, 4);
+        break;
+    }
+    case DCS_RDDPM: {
+        uint8_t pm = 0x08 | (s->sleeping ? 0 : 0x10) | (s->display_on ? 0x04 : 0) |
+                     (s->idle ? 0x40 : 0) | (s->display_on && !s->sleeping ? 0x80 : 0);
+        reply(s, &pm, 1);
+        break;
+    }
+    case DCS_RDDMADCTL:
+        reply(s, &s->madctl, 1);
+        break;
+    case DCS_RDDCOLMOD:
+        reply(s, &s->colmod, 1);
+        break;
+    default:
+        break;
+    }
+}
+
+void mipi_dbi_panel_data(MipiDbiPanelState *s, uint8_t b)
+{
+    if (s->in_reset) {
+        return;
+    }
+    switch (s->cmd) {
+    case DCS_RAMWR:
+    case DCS_RAMWRC:
+        pixel_byte(s, b);
+        return;
+    case DCS_CASET:
+    case DCS_RASET:
+        if (s->nparam < 4) {
+            s->param[s->nparam++] = b;
+        }
+        if (s->nparam == 4) {
+            uint16_t a = (s->param[0] << 8) | s->param[1];
+            uint16_t e = (s->param[2] << 8) | s->param[3];
+            if (s->cmd == DCS_CASET) {
+                s->xs = a;
+                s->xe = e;
+            } else {
+                s->ys = a;
+                s->ye = e;
+            }
+            s->nparam++;
+        }
+        return;
+    case DCS_MADCTL:
+        if (s->nparam++ == 0) {
+            s->madctl = b;
+            s->dirty = true;
+        }
+        return;
+    case DCS_COLMOD:
+        if (s->nparam++ == 0) {
+            s->colmod = b;
+        }
+        return;
+    default:
+        return;                 /* Other commands' parameters: gamma, power, timing */
+    }
+}
+
+uint8_t mipi_dbi_panel_read(MipiDbiPanelState *s)
+{
+    return s->rd_pos < s->rd_len ? s->rd[s->rd_pos++] : 0;
+}
+
+/* What the glass shows */
+static void panel_update(void *opaque)
+{
+    MipiDbiPanelState *s = MIPI_DBI_PANEL(opaque);
+    DisplaySurface *surface = qemu_console_surface(s->con);
+
+    if (!s->dirty || !surface) {
+        return;
+    }
+    s->dirty = false;
+
+    bool lit = s->display_on && !s->sleeping && !s->in_reset &&
+               (!s->backlight_wired || s->backlight != s->backlight_active_low);
+    bool swap_rb = !!(s->madctl & MADCTL_BGR) != s->bgr;
+    bool invert = s->inversion != s->inverted;
+    uint8_t *dst = surface_data(surface);
+    int stride = surface_stride(surface);
+
+    for (uint32_t y = 0; y < s->height; y++) {
+        uint32_t *line = (uint32_t *)(dst + y * stride);
+        for (uint32_t x = 0; x < s->width; x++) {
+            uint32_t mx = s->mirror_x ? s->width - 1 - x : x;
+            uint32_t my = s->mirror_y ? s->height - 1 - y : y;
+            uint32_t rx = mx + s->x_off, ry = my + s->y_off;
+            uint32_t v = 0;
+            if (lit && rx < s->model->ram_w && ry < s->model->ram_h) {
+                v = s->ram[ry * s->model->ram_w + rx];
+                if (swap_rb) {
+                    v = (v & 0x00FF00) | (v >> 16 & 0xFF) | (v & 0xFF) << 16;
+                }
+                if (invert) {
+                    v ^= 0xFFFFFF;
+                }
+                if (s->idle) {          /* 8 colors */
+                    v = (v & 0x800000 ? 0xFF0000 : 0) | (v & 0x8000 ? 0xFF00 : 0) | (v & 0x80 ? 0xFF : 0);
+                }
+            }
+            line[x] = v;
+        }
+    }
+    dpy_gfx_update(s->con, 0, 0, s->width, s->height);
+}
+
+static void panel_invalidate(void *opaque)
+{
+    MIPI_DBI_PANEL(opaque)->dirty = true;
+}
+
+static const GraphicHwOps panel_ops = {
+    .invalidate = panel_invalidate,
+    .gfx_update = panel_update,
+};
+
+/* SPI front end: bytes with D/C low are commands, high are data; reads shift out */
+static uint32_t panel_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    MipiDbiPanelState *s = MIPI_DBI_PANEL(dev);
+    if (s->rd_len && s->rd_pos < s->rd_len && s->dc) {
+        return mipi_dbi_panel_read(s);
+    }
+    if (s->dc) {
+        mipi_dbi_panel_data(s, val);
+        return 0;
+    }
+    mipi_dbi_panel_command(s, val);
+    return 0;
+}
+
+static void panel_set_dc(void *opaque, int n, int level)
+{
+    MIPI_DBI_PANEL(opaque)->dc = level;
+}
+
+static void panel_set_reset(void *opaque, int n, int level)
+{
+    MipiDbiPanelState *s = MIPI_DBI_PANEL(opaque);
+    if (!level && !s->in_reset) {
+        controller_reset(s);
+    }
+    s->in_reset = !level;
+    s->dirty = true;
+}
+
+static void panel_set_backlight(void *opaque, int n, int level)
+{
+    MipiDbiPanelState *s = MIPI_DBI_PANEL(opaque);
+    s->backlight_wired = true;
+    s->backlight = level;
+    s->dirty = true;
+}
+
+static void panel_realize(SSIPeripheral *d, Error **errp)
+{
+    MipiDbiPanelState *s = MIPI_DBI_PANEL(d);
+    const char *type = object_get_typename(OBJECT(d));
+
+    for (size_t i = 0; i < ARRAY_SIZE(models); i++) {
+        if (!strcmp(models[i].name, type)) {
+            s->model = &models[i];
+        }
+    }
+    assert(s->model);
+    /* Unset properties (0, or left at the default) take the model's values */
+    if (!s->width) {
+        s->width = s->model->width;
+        s->x_off = s->x_off ? s->x_off : s->model->x_off;
+    }
+    if (!s->height) {
+        s->height = s->model->height;
+        s->y_off = s->y_off ? s->y_off : s->model->y_off;
+    }
+    if (s->width + s->x_off > s->model->ram_w || s->height + s->y_off > s->model->ram_h) {
+        /* The glass can be rotated in the frame memory (MV): allow its transpose */
+        if (s->width + s->x_off > s->model->ram_h || s->height + s->y_off > s->model->ram_w) {
+            error_setg(errp, "%ux%u at %u,%u is outside the %ux%u frame memory",
+                       s->width, s->height, s->x_off, s->y_off, s->model->ram_w, s->model->ram_h);
+            return;
+        }
+    }
+    s->ram = g_new0(uint32_t, (size_t)s->model->ram_w * s->model->ram_h);
+    qdev_init_gpio_in_named(DEVICE(d), panel_set_dc, "dc", 1);
+    qdev_init_gpio_in_named(DEVICE(d), panel_set_reset, "reset", 1);
+    qdev_init_gpio_in_named(DEVICE(d), panel_set_backlight, "backlight", 1);
+    s->con = graphic_console_init(DEVICE(d), 0, &panel_ops, s);
+    qemu_console_resize(s->con, s->width, s->height);
+    controller_reset(s);
+}
+
+static void panel_reset(DeviceState *dev)
+{
+    controller_reset(MIPI_DBI_PANEL(dev));
+}
+
+static Property panel_properties[] = {
+    DEFINE_PROP_UINT32("width", MipiDbiPanelState, width, 0),
+    DEFINE_PROP_UINT32("height", MipiDbiPanelState, height, 0),
+    DEFINE_PROP_UINT32("x-offset", MipiDbiPanelState, x_off, 0),
+    DEFINE_PROP_UINT32("y-offset", MipiDbiPanelState, y_off, 0),
+    DEFINE_PROP_BOOL("backlight-active-low", MipiDbiPanelState, backlight_active_low, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+/* Mounting properties default to the model's: set in instance_init, before -device's */
+static void panel_instance_init(Object *obj)
+{
+    MipiDbiPanelState *s = MIPI_DBI_PANEL(obj);
+    const char *type = object_get_typename(obj);
+    for (size_t i = 0; i < ARRAY_SIZE(models); i++) {
+        if (!strcmp(models[i].name, type)) {
+            s->mirror_x = models[i].mirror_x;
+            s->mirror_y = models[i].mirror_y;
+            s->bgr = models[i].bgr;
+            s->inverted = models[i].inverted;
+        }
+    }
+}
+
+static bool get_mx(Object *o, Error **e) { return MIPI_DBI_PANEL(o)->mirror_x; }
+static void set_mx(Object *o, bool v, Error **e) { MIPI_DBI_PANEL(o)->mirror_x = v; }
+static bool get_my(Object *o, Error **e) { return MIPI_DBI_PANEL(o)->mirror_y; }
+static void set_my(Object *o, bool v, Error **e) { MIPI_DBI_PANEL(o)->mirror_y = v; }
+static bool get_bgr(Object *o, Error **e) { return MIPI_DBI_PANEL(o)->bgr; }
+static void set_bgr(Object *o, bool v, Error **e) { MIPI_DBI_PANEL(o)->bgr = v; }
+static bool get_inv(Object *o, Error **e) { return MIPI_DBI_PANEL(o)->inverted; }
+static void set_inv(Object *o, bool v, Error **e) { MIPI_DBI_PANEL(o)->inverted = v; }
+
+static void panel_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = panel_realize;
+    k->transfer = panel_transfer;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(dc, panel_reset);
+    device_class_set_props(dc, panel_properties);
+    set_bit(DEVICE_CATEGORY_DISPLAY, dc->categories);
+    object_class_property_add_bool(klass, "panel-mirror-x", get_mx, set_mx);
+    object_class_property_add_bool(klass, "panel-mirror-y", get_my, set_my);
+    object_class_property_add_bool(klass, "panel-bgr", get_bgr, set_bgr);
+    object_class_property_add_bool(klass, "panel-inverted", get_inv, set_inv);
+}
+
+static const TypeInfo panel_info = {
+    .name = TYPE_MIPI_DBI_PANEL,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(MipiDbiPanelState),
+    .instance_init = panel_instance_init,
+    .class_init = panel_class_init,
+    .abstract = true,
+};
+
+static void panel_register_types(void)
+{
+    type_register_static(&panel_info);
+    for (size_t i = 0; i < ARRAY_SIZE(models); i++) {
+        TypeInfo ti = {
+            .name = models[i].name,
+            .parent = TYPE_MIPI_DBI_PANEL,
+        };
+        type_register_static(&ti);      /* Copies what it needs */
+    }
+}
+
+type_init(panel_register_types)
