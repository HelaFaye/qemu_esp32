diff --git a/hw/input/xpt2046.c b/hw/input/xpt2046.c
new file mode 100644
index 0000000..8355577
--- /dev/null
+++ b/hw/input/xpt2046.c
@@ -0,0 +1,238 @@
+/*
+ * XPT2046 / ADS7843 / ADS7846 resistive touch screen controller (SPI)
+ *
+ * A control byte (start bit 7, channel A2-A0 in bits 6-4, MODE bit 3: 8-bit, PD1-PD0)
+ * starts a conversion; its result shifts out on the next 16 clocks: a busy bit, 12 bits
+ * (or 8), zeros. A control byte can come during the previous result, as drivers do to
+ * save clocks (16 clocks per conversion); its result follows that one.
+ *
+ * Touches come from the absolute pointer (a window's mouse) or, for tests, the QOM
+ * properties "x", "y" (raw 12-bit plate readings) and "pressed". PENIRQ ("penirq",
+ * unnamed GPIO out 0 also works) is low while pressed with PD = 00, else released (1):
+ * wire it with pin-link dir=out,open-drain=on,pull=up.
+ *
+ *   -device xpt2046,bus=spi2,id=touch
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "ui/input.h"
+#include "qom/object.h"
+
+#define TYPE_XPT2046 "xpt2046"
+OBJECT_DECLARE_SIMPLE_TYPE(XPT2046State, XPT2046)
+
+#define CH_TEMP0    0
+#define CH_Y        1       /* "Y+" in the datasheet: the Y plate position */
+#define CH_VBAT     2
+#define CH_Z1       3
+#define CH_Z2       4
+#define CH_X        5
+#define CH_AUX      6
+#define CH_TEMP1    7
+
+struct XPT2046State {
+    SSIPeripheral parent_obj;
+
+    qemu_irq penirq;
+    QemuInputHandlerState *input;
+
+    /* The touch */
+    uint32_t x, y;              /* Raw plate readings, 0-4095 */
+    bool pressed;
+    uint32_t pressure;          /* 0-4095: how hard */
+
+    /* Calibration of the pointer onto the plates (a board's panel and its film) */
+    uint32_t x_min, x_max, y_min, y_max;
+    bool swap_xy;
+    uint32_t vbat_mv, aux_mv;
+
+    bool penirq_enabled;
+    uint8_t out[8];
+    uint8_t out_len, out_pos;
+};
+
+static void update_penirq(XPT2046State *s)
+{
+    qemu_set_irq(s->penirq, !(s->pressed && s->penirq_enabled));
+}
+
+static uint16_t convert(XPT2046State *s, int ch)
+{
+    switch (ch) {
+    case CH_X:      return s->pressed ? s->x : 0;
+    case CH_Y:      return s->pressed ? s->y : 0;
+    case CH_Z1:     return s->pressed ? MAX(1u, s->pressure * 3 / 4) : 0;
+    case CH_Z2:     return s->pressed ? 4095 - s->pressure / 4 : 4095;
+    case CH_VBAT:   return MIN(4095u, s->vbat_mv * 4096 / 4 / 2500);   /* Vbat / 4 against 2.5 V */
+    case CH_AUX:    return MIN(4095u, s->aux_mv * 4096 / 2500);
+    case CH_TEMP0:  return 0x2A0;       /* About 25 degrees C */
+    case CH_TEMP1:  return 0x340;
+    default:        return 0;
+    }
+}
+
+static void queue(XPT2046State *s, uint8_t b)
+{
+    if (s->out_pos > 0 && s->out_pos == s->out_len) {
+        s->out_len = s->out_pos = 0;
+    }
+    if (s->out_len < sizeof(s->out)) {
+        s->out[s->out_len++] = b;
+    }
+}
+
+static uint32_t xpt2046_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    XPT2046State *s = XPT2046(dev);
+    uint8_t ret = s->out_pos < s->out_len ? s->out[s->out_pos++] : 0;
+
+    if (val & 0x80) {
+        int ch = (val >> 4) & 7;
+        bool eight_bit = val & 0x08;
+        uint16_t r = convert(s, ch);
+        /* Compact what's been read, then this result's bytes after anything pending */
+        memmove(s->out, s->out + s->out_pos, s->out_len - s->out_pos);
+        s->out_len -= s->out_pos;
+        s->out_pos = 0;
+        if (eight_bit) {
+            r >>= 4;
+            queue(s, r >> 1);
+            queue(s, (r & 1) << 7);
+        } else {
+            queue(s, r >> 5);
+            queue(s, (r << 3) & 0xF8);
+        }
+        s->penirq_enabled = (val & 0x03) == 0;
+        update_penirq(s);
+    }
+    return ret;
+}
+
+static void xpt2046_input_event(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    XPT2046State *s = XPT2046(dev);
+    InputMoveEvent *move;
+    InputBtnEvent *btn;
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_ABS:
+        move = evt->u.abs.data;
+        {
+            int64_t v = move->value;        /* 0 .. INPUT_EVENT_ABS_MAX */
+            bool is_x = (move->axis == INPUT_AXIS_X) != s->swap_xy;
+            uint32_t lo = is_x ? s->x_min : s->y_min, hi = is_x ? s->x_max : s->y_max;
+            uint32_t raw = lo + (int64_t)((int64_t)hi - lo) * v / INPUT_EVENT_ABS_MAX;
+            if (is_x) {
+                s->x = raw;
+            } else {
+                s->y = raw;
+            }
+        }
+        break;
+    case INPUT_EVENT_KIND_BTN:
+        btn = evt->u.btn.data;
+        if (btn->button == INPUT_BUTTON_LEFT) {
+            s->pressed = btn->down;
+            update_penirq(s);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static const QemuInputHandler xpt2046_handler = {
+    .name = "xpt2046 touch screen",
+    .mask = INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_ABS,
+    .event = xpt2046_input_event,
+};
+
+static bool get_pressed(Object *obj, Error **errp)
+{
+    return XPT2046(obj)->pressed;
+}
+
+static void set_pressed(Object *obj, bool value, Error **errp)
+{
+    XPT2046State *s = XPT2046(obj);
+    s->pressed = value;
+    update_penirq(s);
+}
+
+/* Settable while running (qom-set), unlike qdev properties */
+static void xpt2046_instance_init(Object *obj)
+{
+    XPT2046State *s = XPT2046(obj);
+    s->x = s->y = 2048;
+    s->pressure = 2400;
+    object_property_add_uint32_ptr(obj, "x", &s->x, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "y", &s->y, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "pressure", &s->pressure, OBJ_PROP_FLAG_READWRITE);
+}
+
+static void xpt2046_realize(SSIPeripheral *d, Error **errp)
+{
+    XPT2046State *s = XPT2046(d);
+
+    qdev_init_gpio_out(DEVICE(d), &s->penirq, 1);
+    qdev_init_gpio_out_named(DEVICE(d), &s->penirq, "penirq", 1);
+    s->input = qemu_input_handler_register(DEVICE(d), &xpt2046_handler);
+    s->penirq_enabled = true;
+}
+
+static void xpt2046_reset(DeviceState *dev)
+{
+    XPT2046State *s = XPT2046(dev);
+    s->out_len = s->out_pos = 0;
+    s->penirq_enabled = true;           /* PD = 00 at power up */
+    update_penirq(s);
+}
+
+static Property xpt2046_properties[] = {
+    DEFINE_PROP_UINT32("x-min", XPT2046State, x_min, 200),
+    DEFINE_PROP_UINT32("x-max", XPT2046State, x_max, 3900),
+    DEFINE_PROP_UINT32("y-min", XPT2046State, y_min, 200),
+    DEFINE_PROP_UINT32("y-max", XPT2046State, y_max, 3900),
+    DEFINE_PROP_BOOL("swap-xy", XPT2046State, swap_xy, false),
+    DEFINE_PROP_UINT32("vbat-mv", XPT2046State, vbat_mv, 3700),
+    DEFINE_PROP_UINT32("aux-mv", XPT2046State, aux_mv, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void xpt2046_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = xpt2046_realize;
+    k->transfer = xpt2046_transfer;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(dc, xpt2046_reset);
+    device_class_set_props(dc, xpt2046_properties);
+    object_class_property_add_bool(klass, "pressed", get_pressed, set_pressed);
+    set_bit(DEVICE_CATEGORY_INPUT, dc->categories);
+}
+
+static const TypeInfo xpt2046_info = {
+    .name = TYPE_XPT2046,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(XPT2046State),
+    .instance_init = xpt2046_instance_init,
+    .class_init = xpt2046_class_init,
+};
+
+static void xpt2046_register_types(void)
+{
+    type_register_static(&xpt2046_info);
+}
+
+type_init(xpt2046_register_types)
