diff --git a/hw/misc/esp32s3_cache.c b/hw/misc/esp32s3_cache.c
index ef75966..9d50a25 100644
--- a/hw/misc/esp32s3_cache.c
+++ b/hw/misc/esp32s3_cache.c
@@ -57,6 +57,25 @@ static inline uint32_t esp32s3_read_mmu_value(ESP32S3CacheState *s, hwaddr reg_a
 }
 
 
+/**
+ * @brief Whether any MMU entry other than `except` still maps flash page `page_number`.
+ *        A flash page can be mapped at several virtual addresses at once: ESP-IDF's
+ *        esp_image_verify() (behind ESP.getSketchSize() and OTA) maps the running app's
+ *        own pages to read them, while the app keeps executing from its first mapping.
+ */
+static bool esp32s3_flash_page_still_mapped(ESP32S3CacheState *s, uint32_t page_number, uint32_t except)
+{
+    for (uint32_t i = 0; i < ESP32S3_MMU_TABLE_ENTRY_COUNT; i++) {
+        const ESP32S3MMUEntry e = s->mmu[i];
+        if (i != except && !e.invalid && e.type == ESP32S3_MMU_TYPE_FLASH &&
+            e.page_number == page_number) {
+            return true;
+        }
+    }
+    return false;
+}
+
+
 static void esp32s3_mmu_invalidate_page(ESP32S3CacheState *s, hwaddr virt_addr, hwaddr phys_addr, bool is_psram, bool clear_mr)
 {
     IOMMUTLBEvent event = {
@@ -100,8 +119,13 @@ static inline void esp32s3_write_mmu_value(ESP32S3CacheState *s, hwaddr reg_addr
         const uint32_t physical_address = e.page_number * ESP32S3_PAGE_SIZE;
         const uint32_t former_physaddr = former.page_number * ESP32S3_PAGE_SIZE;
         const uint32_t virtaddr = index * ESP32S3_PAGE_SIZE;
-        /* Invalidate the former mapping and clear the MR if and only if this is an "invalidate" operation */
-        esp32s3_mmu_invalidate_page(s, virtaddr, former_physaddr, former.type == ESP32S3_MMU_TYPE_PSRAM, e.invalid);
+        /* Invalidate the former mapping and clear the MR if and only if this is an "invalidate" operation.
+         * The MR holds flash by physical address and is shared by every mapping of a page: clearing it
+         * while another entry still maps that page would corrupt the other mapping (the running app's
+         * own code, when esp_image_verify() unmaps its temporary view of the app partition). */
+        const bool clear = e.invalid && !former.invalid &&
+                           !esp32s3_flash_page_still_mapped(s, former.page_number, index);
+        esp32s3_mmu_invalidate_page(s, virtaddr, former_physaddr, former.type == ESP32S3_MMU_TYPE_PSRAM, clear);
 
         if (!e.invalid) {
             if (e.type == ESP32S3_MMU_TYPE_FLASH && s->flash_blk != NULL) {
diff --git a/tests/qtest/esp32s3-mmu-test.c b/tests/qtest/esp32s3-mmu-test.c
new file mode 100644
index 0000000..cda7dbf
--- /dev/null
+++ b/tests/qtest/esp32s3-mmu-test.c
@@ -0,0 +1,56 @@
+/*
+ * QTest for the ESP32-S3 MMU's flash pages: one flash page mapped at two virtual pages
+ * stays readable through the first when the second is unmapped. ESP-IDF does exactly
+ * this when it verifies the running app (esp_image_verify(), behind ESP.getSketchSize(),
+ * getSketchMD5() and OTA): it maps the app's own pages a second time, then unmaps them.
+ * Clearing the shared page there filled the running code with 0xdeadbeef.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "libqtest.h"
+
+#define MMU_TABLE   0x600C5000
+#define DCACHE      0x3c000000
+#define PAGE        0x10000
+#define INVALID     BIT(14)
+
+static void test_shared_page(void)
+{
+    g_autofree char *path = NULL;
+    int fd = g_file_open_tmp("esp32s3-mmu-XXXXXX", &path, NULL);
+    g_assert(fd >= 0);
+    g_autofree uint8_t *flash = g_malloc0(4 * 1024 * 1024);
+    for (int i = 0; i < PAGE; i += 4) {
+        stl_le_p(flash + PAGE + i, 0x11223344 + i);       /* Flash page 1 */
+    }
+    g_assert(write(fd, flash, 4 * 1024 * 1024) == 4 * 1024 * 1024);
+    close(fd);
+
+    QTestState *qts = qtest_initf("-machine esp32s3 -drive file=%s,if=mtd,format=raw", path);
+    qtest_writel(qts, MMU_TABLE + 4 * 10, 1);                /* Virtual page 10 -> flash 1 */
+    qtest_writel(qts, MMU_TABLE + 4 * 11, 1);                /* and 11 -> the same page */
+    g_assert_cmphex(qtest_readl(qts, DCACHE + 10 * PAGE + 8), ==, 0x11223344 + 8);
+    g_assert_cmphex(qtest_readl(qts, DCACHE + 11 * PAGE + 8), ==, 0x11223344 + 8);
+
+    qtest_writel(qts, MMU_TABLE + 4 * 11, INVALID);          /* Unmap the second */
+    g_assert_cmphex(qtest_readl(qts, DCACHE + 10 * PAGE + 8), ==, 0x11223344 + 8);
+
+    /* Invalidating an entry that is already invalid leaves every page alone */
+    qtest_writel(qts, MMU_TABLE + 4 * 11, INVALID | 1);
+    g_assert_cmphex(qtest_readl(qts, DCACHE + 10 * PAGE + 8), ==, 0x11223344 + 8);
+
+    qtest_quit(qts);
+    unlink(path);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/mmu/shared-page", test_shared_page);
+    return g_test_run();
+}
