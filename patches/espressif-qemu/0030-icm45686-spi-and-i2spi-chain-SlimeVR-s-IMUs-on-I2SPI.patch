+static uint32_t icm_spi_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    ICM45686SPIState *s = ICM45686_SPI(dev);
+    uint8_t out = 0;
+
+    if (spi_selected > 1) {
+        s->fights++;
+    }
+    if (s->first) {
+        s->first = false;
+        s->reading = val & 0x80;
+        s->ptr = val & 0x7F;
+        return 0;
+    }
+    if (s->reading) {
+        out = read_byte(&s->c, s->ptr);
