diff --git a/hw/misc/i2spi_chain.c b/hw/misc/i2spi_chain.c
new file mode 100644
index 0000000..5068b37
--- /dev/null
+++ b/hw/misc/i2spi_chain.c
@@ -0,0 +1,471 @@
+/*
+ * An I2SPI chain (SPI data, I2C selection; SlimeVR's docs/I2SPI.md, protocol v3): up
+ * to 15 nodes behind one I2C address. Each node owns channels; a channel gates an SPI
+ * part's chip select with the shared CS_STROBE line, CS = CS_STROBE OR NOT armed, or
+ * with SET_CS in software mode. Nodes power their sensors through a switch that starts
+ * off, and a part whose node switches it on is reset as it would be by its supply.
+ *
+ *   -device i2spi-chain,bus=i2c0,address=0x13,id=chain,nodes=1:2/3,links=0x10=imu1:0x11=imu2:0x30=imu3  (icm45686-spi parts)
+ *   -device esp32s3.pin-link,pin=10,dev=chain,line=strobe,pull=up
+ *
+ * nodes:   the nodes present, by id and "/"-separated, each with its channel count
+ *          (":n", default 1).
+ *          A node left out is absent: it neither answers nor gates.
+ * links:   target=device pairs, target = (node << 4) | channel, device = an SSI part's
+ *          id; its "ssi-gpio-cs" follows the channel.
+ * version: the protocol version the nodes report (default 3).
+ * misflash: "position=id": the node at a position answers IDENTIFY for that position
+ *          but reports another id, as a node flashed with the wrong image does.
+ *
+ * Read back over QOM: "frames" (valid frames), "arms" (ARM frames), "fights" (times two
+ * of this chain's chip selects were asserted together), "armed" (the armed target, 0
+ * for none), "powered" (bit n: node n's sensors are on).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/i2c/i2c.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "qemu/cutils.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "qemu/notify.h"
+#include "sysemu/sysemu.h"
+#include "qom/object.h"
+
+#define TYPE_I2SPI_CHAIN "i2spi-chain"
+OBJECT_DECLARE_SIMPLE_TYPE(I2SPIChainState, I2SPI_CHAIN)
+
+#define MAX_NODES       16      /* Ids 1..15 */
+#define MAX_CHANNELS    16
+#define MAX_LINKS       64
+
+enum {
+    OP_ARM = 0x01, OP_DISARM_ALL = 0x02, OP_POWER_ALL = 0x03,
+    OP_SET_CS = 0x10, OP_SET_MODE = 0x11, OP_SET_SENSOR_POWER = 0x12,
+    OP_SET_SENSOR_RESET = 0x13, OP_IDENTIFY = 0x20, OP_RESET_ALL = 0x7f,
+};
+
+#define IDENTITY_MAGIC  0x5c
+#define ST_ARMED        0x01
+#define ST_STROBE       0x02
+#define ST_POWERED      0x04
+#define ST_HELD         0x08
+
+typedef struct Node {
+    bool present;
+    uint8_t reported_id;
+    uint8_t channels;
+    int armed;              /* Channel, or -1 */
+    bool strobe_mode;
+    bool powered;
+    bool held;
+    bool soft_cs_low;
+} Node;
+
+typedef struct Link {
+    uint8_t target;
+    char *dev_id;
+    DeviceState *dev;
+    qemu_irq cs;
+    int level;              /* -1: not driven yet */
+} Link;
+
+struct I2SPIChainState {
+    I2CSlave parent_obj;
+
+    char *nodes_str;
+    char *links_str;
+    char *misflash_str;
+    uint8_t version;
+
+    Node node[MAX_NODES];
+    Link link[MAX_LINKS];
+    int nlinks;
+    uint8_t identified;     /* Node answering reads, 0 for none */
+
+    uint8_t frame[4];
+    int frame_len;
+    bool sending;
+    int read_pos;
+    bool strobe;            /* Level of CS_STROBE */
+
+    uint32_t frames, arms, fights;
+    uint32_t armed_target, powered_mask;
+
+    Notifier init_done;
+};
+
+static bool link_asserted(I2SPIChainState *s, Link *l)
+{
+    Node *n = &s->node[l->target >> 4];
+    int ch = l->target & 0x0f;
+    if (!n->present || !n->powered || n->held || n->armed != ch) {
+        return false;
+    }
+    return n->strobe_mode ? !s->strobe : n->soft_cs_low;
+}
+
+static void update(I2SPIChainState *s)
+{
+    int asserted = 0;
+
+    s->armed_target = 0;
+    s->powered_mask = 0;
+    for (int id = 1; id < MAX_NODES; id++) {
+        Node *n = &s->node[id];
+        if (n->present && n->armed >= 0) {
+            s->armed_target = id << 4 | n->armed;
+        }
+        if (n->present && n->powered && !n->held) {
+            s->powered_mask |= 1u << id;
+        }
+    }
+    for (int i = 0; i < s->nlinks; i++) {
+        Link *l = &s->link[i];
+        bool on = link_asserted(s, l);
+        asserted += on;
+        if (l->cs && l->level != !on) {
+            l->level = !on;
+            qemu_set_irq(l->cs, l->level);
+        }
+    }
+    if (asserted > 1) {
+        s->fights++;
+    }
+}
+
+/* A node's supply came on: its parts start from power-on */
+static void power_on(I2SPIChainState *s, int id)
+{
+    for (int i = 0; i < s->nlinks; i++) {
+        Link *l = &s->link[i];
+        if ((l->target >> 4) == id && l->dev) {
+            device_cold_reset(l->dev);
+            l->level = -1;
+        }
+    }
+}
+
+static void set_power(I2SPIChainState *s, Node *n, int id, bool on)
+{
+    bool was = n->powered && !n->held;
+    n->powered = on;
+    if (!was && n->powered && !n->held) {
+        power_on(s, id);
+    }
+}
+
+static void node_reset(Node *n)
+{
+    n->armed = -1;
+    n->strobe_mode = true;
+    n->powered = false;
+    n->held = false;
+    n->soft_cs_low = false;
+}
+
+static void apply(I2SPIChainState *s)
+{
+    uint8_t op = s->frame[0], target = s->frame[1], value = s->frame[2];
+    int tid = target >> 4, ch = target & 0x0f;
+    bool known = true;
+
+    for (int id = 1; id < MAX_NODES; id++) {
+        Node *n = &s->node[id];
+        if (!n->present) {
+            continue;
+        }
+        bool mine = tid == id;
+        switch (op) {
+        case OP_ARM:
+            n->armed = (mine && ch < n->channels) ? ch : -1;
+            n->soft_cs_low = false;
+            break;
+        case OP_DISARM_ALL:
+            n->armed = -1;
+            n->soft_cs_low = false;
+            break;
+        case OP_POWER_ALL:
+            set_power(s, n, id, value == 1);
+            break;
+        case OP_RESET_ALL:
+            node_reset(n);
+            break;
+        case OP_SET_CS:
+            if (mine && !n->strobe_mode && n->armed == ch) {
+                n->soft_cs_low = value == 0;
+            }
+            break;
+        case OP_SET_MODE:
+            if (mine) {
+                n->strobe_mode = value == 1;
+            }
+            break;
+        case OP_SET_SENSOR_POWER:
+            if (mine) {
+                set_power(s, n, id, value == 1);
+            }
+            break;
+        case OP_SET_SENSOR_RESET:
+            if (mine) {
+                bool was = n->powered && !n->held;
+                n->held = value == 1;
+                n->powered = !n->held;
+                if (!was && n->powered && !n->held) {
+                    power_on(s, id);
+                }
+            }
+            break;
+        case OP_IDENTIFY:
+            break;
+        default:
+            known = false;
+        }
+    }
+    if (op == OP_IDENTIFY) {
+        s->identified = tid;
+    } else if (op == OP_RESET_ALL) {
+        s->identified = 0;
+    }
+    if (known) {
+        s->frames++;
+        s->arms += op == OP_ARM;
+    }
+    update(s);
+}
+
+static int chain_event(I2CSlave *i2c, enum i2c_event event)
+{
+    I2SPIChainState *s = I2SPI_CHAIN(i2c);
+    bool any = false;
+
+    for (int id = 1; id < MAX_NODES; id++) {
+        any |= s->node[id].present;
+    }
+    switch (event) {
+    case I2C_START_SEND:
+    case I2C_START_SEND_ASYNC:
+        if (!any) {
+            return -1;          /* No node on the cable: nobody ACKs */
+        }
+        s->frame_len = 0;
+        s->sending = true;
+        break;
+    case I2C_START_RECV:
+        if (!any) {
+            return -1;
+        }
+        s->read_pos = 0;
+        s->sending = false;
+        break;
+    case I2C_FINISH:
+        if (s->sending && s->frame_len == 3) {
+            apply(s);
+        }
+        s->sending = false;
+        break;
+    default:
+        break;
+    }
+    return 0;
+}
+
+static int chain_send(I2CSlave *i2c, uint8_t b)
+{
+    I2SPIChainState *s = I2SPI_CHAIN(i2c);
+    if (s->frame_len < (int)sizeof(s->frame)) {
+        s->frame[s->frame_len] = b;
+    }
+    s->frame_len++;             /* A fourth byte spoils the frame */
+    return 0;
+}
+
+static uint8_t chain_recv(I2CSlave *i2c)
+{
+    I2SPIChainState *s = I2SPI_CHAIN(i2c);
+    int id = s->identified;
+    Node *n = id ? &s->node[id] : NULL;
+    int pos = s->read_pos++;
+
+    if (!n || !n->present || pos >= 4) {
+        return 0xff;            /* Bus idle */
+    }
+    switch (pos) {
+    case 0:
+        return IDENTITY_MAGIC;
+    case 1:
+        return s->version;
+    case 2:
+        return n->reported_id;
+    default:
+        return (n->armed >= 0 ? ST_ARMED : 0) | (n->strobe_mode ? ST_STROBE : 0) |
+               (n->powered && !n->held ? ST_POWERED : 0) | (n->held ? ST_HELD : 0);
+    }
+}
+
+static void strobe_in(void *opaque, int n, int level)
+{
+    I2SPIChainState *s = I2SPI_CHAIN(opaque);
+    s->strobe = level != 0;
+    update(s);
+}
+
+static void chain_reset(DeviceState *dev)
+{
+    I2SPIChainState *s = I2SPI_CHAIN(dev);
+    for (int id = 1; id < MAX_NODES; id++) {
+        node_reset(&s->node[id]);
+    }
+    s->identified = 0;
+    s->frame_len = 0;
+    s->sending = false;
+    s->strobe = true;
+    for (int i = 0; i < s->nlinks; i++) {
+        s->link[i].level = -1;
+    }
+    update(s);
+}
+
+/* The parts exist once every -device is in: connect, and deselect them all */
+static void chain_init_done(Notifier *notifier, void *data)
+{
+    I2SPIChainState *s = container_of(notifier, I2SPIChainState, init_done);
+
+    for (int i = 0; i < s->nlinks; i++) {
+        Link *l = &s->link[i];
+        g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", l->dev_id);
+        Object *o = object_resolve_path(path, NULL);
+        if (!o || !object_dynamic_cast(o, TYPE_SSI_PERIPHERAL)) {
+            error_report("i2spi-chain: links: no SPI device '%s'", l->dev_id);
+            exit(1);
+        }
+        l->dev = DEVICE(o);
+        l->cs = qdev_get_gpio_in_named(l->dev, SSI_GPIO_CS, 0);
+        l->level = -1;
+    }
+    update(s);
+}
+
+static void chain_realize(DeviceState *dev, Error **errp)
+{
+    I2SPIChainState *s = I2SPI_CHAIN(dev);
+
+    for (int id = 0; id < MAX_NODES; id++) {
+        s->node[id].reported_id = id;
+    }
+    if (s->nodes_str && *s->nodes_str) {
+        g_auto(GStrv) parts = g_strsplit(s->nodes_str, "/", -1);
+        for (int i = 0; parts[i]; i++) {
+            unsigned long id, ch = 1;
+            const char *end;
+            if (qemu_strtoul(parts[i], &end, 0, &id) < 0 ||
+                (*end && (*end != ':' || qemu_strtoul(end + 1, NULL, 0, &ch) < 0))) {
+                goto bad_nodes;
+            }
+            if (id < 1 || id >= MAX_NODES || ch < 1 || ch > MAX_CHANNELS) {
+                goto bad_nodes;
+            }
+            s->node[id].present = true;
+            s->node[id].channels = ch;
+        }
+    }
+    if (s->misflash_str && *s->misflash_str) {
+        unsigned long pos, id;
+        const char *end;
+        if (qemu_strtoul(s->misflash_str, &end, 0, &pos) < 0 || *end != '=' ||
+            qemu_strtoul(end + 1, NULL, 0, &id) < 0 ||
+            pos < 1 || pos >= MAX_NODES || id > 255) {
+            error_setg(errp, "i2spi-chain: misflash: position=id");
+            return;
+        }
+        s->node[pos].reported_id = id;
+    }
+    if (s->links_str && *s->links_str) {
+        g_auto(GStrv) parts = g_strsplit(s->links_str, ":", -1);
+        for (int i = 0; parts[i]; i++) {
+            char *eq = strchr(parts[i], '=');
+            unsigned long target;
+            if (!eq || s->nlinks >= MAX_LINKS) {
+                goto bad_links;
+            }
+            *eq = 0;
+            if (qemu_strtoul(parts[i], NULL, 0, &target) < 0 || target > 0xff ||
+                (target >> 4) == 0) {
+                goto bad_links;
+            }
+            s->link[s->nlinks].target = target;
+            s->link[s->nlinks].dev_id = g_strdup(eq + 1);
+            s->link[s->nlinks].level = -1;
+            s->nlinks++;
+        }
+    }
+    qdev_init_gpio_in_named(dev, strobe_in, "strobe", 1);
+    s->init_done.notify = chain_init_done;
+    qemu_add_machine_init_done_notifier(&s->init_done);
+    return;
+
+bad_nodes:
+    error_setg(errp, "i2spi-chain: nodes: id[:channels]/... with ids 1..15");
+    return;
+bad_links:
+    error_setg(errp, "i2spi-chain: links: target=device:... (target 0x10..0xff)");
+}
+
+static void get_u32(Object *obj, Visitor *v, const char *name, void *opaque,
+                    Error **errp)
+{
+    visit_type_uint32(v, name, (uint32_t *)opaque, errp);
+}
+
+static void chain_init(Object *obj)
+{
+    I2SPIChainState *s = I2SPI_CHAIN(obj);
+    object_property_add(obj, "frames", "uint32", get_u32, NULL, NULL, &s->frames);
+    object_property_add(obj, "arms", "uint32", get_u32, NULL, NULL, &s->arms);
+    object_property_add(obj, "fights", "uint32", get_u32, NULL, NULL, &s->fights);
+    object_property_add(obj, "armed", "uint32", get_u32, NULL, NULL, &s->armed_target);
+    object_property_add(obj, "powered", "uint32", get_u32, NULL, NULL,
+                        &s->powered_mask);
+}
+
+static Property chain_properties[] = {
+    DEFINE_PROP_STRING("nodes", I2SPIChainState, nodes_str),
+    DEFINE_PROP_STRING("links", I2SPIChainState, links_str),
+    DEFINE_PROP_STRING("misflash", I2SPIChainState, misflash_str),
+    DEFINE_PROP_UINT8("version", I2SPIChainState, version, 3),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void chain_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = chain_realize;
+    device_class_set_legacy_reset(dc, chain_reset);
+    device_class_set_props(dc, chain_properties);
+    k->event = chain_event;
+    k->send = chain_send;
+    k->recv = chain_recv;
+}
+
+static const TypeInfo chain_info = {
+    .name = TYPE_I2SPI_CHAIN,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(I2SPIChainState),
+    .instance_init = chain_init,
+    .class_init = chain_class_init,
+};
+
+static void chain_register_types(void)
+{
+    type_register_static(&chain_info);
+}
+
+type_init(chain_register_types)
