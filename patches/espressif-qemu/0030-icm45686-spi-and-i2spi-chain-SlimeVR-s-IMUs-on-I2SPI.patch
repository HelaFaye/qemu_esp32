diff --git a/tests/qtest/esp32s3-i2spi-test.c b/tests/qtest/esp32s3-i2spi-test.c
new file mode 100644
index 0000000..390b46f
--- /dev/null
+++ b/tests/qtest/esp32s3-i2spi-test.c
@@ -0,0 +1,341 @@
+/*
+ * QTest: an I2SPI chain (i2spi-chain) selecting ICM-45686s (icm45686-spi) on GP-SPI2, as
+ * SlimeVR's docs/I2SPI.md describes it: frames, identity reads, sensor power, one-hot
+ * arming, the strobe and software chip selects; and icm45686-spi's registers and FIFO.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qapi/qmp/qdict.h"
+#include "qemu/bitops.h"
+
+#define SPI2            0x60024000
+#define SPI_CMD         (SPI2 + 0x00)
+#define SPI_CLOCK       (SPI2 + 0x0C)
+#define SPI_USER        (SPI2 + 0x10)
+#define SPI_MS_DLEN     (SPI2 + 0x1C)
+#define SPI_MISC        (SPI2 + 0x20)
+#define SPI_INT_CLR     (SPI2 + 0x38)
+#define SPI_INT_RAW     (SPI2 + 0x3C)
+#define SPI_W0          (SPI2 + 0x98)
+#define SPI_CLK_GATE    (SPI2 + 0xE8)
+
+#define I2C0            0x60013000
+#define I2C_SCL_LOW     (I2C0 + 0x00)
+#define I2C_CTR         (I2C0 + 0x04)
+#define I2C_FIFO_CONF   (I2C0 + 0x18)
+#define I2C_DATA        (I2C0 + 0x1C)
+#define I2C_INT_RAW     (I2C0 + 0x20)
+#define I2C_INT_CLR     (I2C0 + 0x24)
+#define I2C_SCL_HIGH    (I2C0 + 0x38)
+#define I2C_CLK_CONF    (I2C0 + 0x54)
+#define I2C_COMD(n)     (I2C0 + 0x58 + 4 * (n))
+#define CMD(op, n, ack_check, ack_val) ((op) << 11 | (ack_val) << 10 | (ack_check) << 8 | (n))
+#define INT_TRANS_COMPLETE  BIT(7)
+#define INT_NACK            BIT(10)
+
+#define GPIO            0x60004000
+#define OUT_W1TS        (GPIO + 0x08)
+#define OUT_W1TC        (GPIO + 0x0C)
+#define ENABLE_W1TS     (GPIO + 0x24)
+
+#define PIN_STROBE      10
+#define PIN_DIRECT_CS   7
+#define CHAIN           0x13
+
+enum { ARM = 0x01, DISARM_ALL = 0x02, POWER_ALL = 0x03, SET_CS = 0x10, SET_MODE = 0x11,
+       SET_SENSOR_POWER = 0x12, SET_SENSOR_RESET = 0x13, IDENTIFY = 0x20, RESET_ALL = 0x7f };
+
+#define WHO_AM_I        0x72
+
+/* Node 1: two channels (imu1, imu2); node 2: one (imu3); imu4 on a host pin */
+#define DEVICES \
+    "-device icm45686-spi,bus=spi2,cs=10,id=imu1 " \
+    "-device icm45686-spi,bus=spi2,cs=11,id=imu2 " \
+    "-device icm45686-spi,bus=spi2,cs=12,id=imu3,gyro-z=90000 " \
+    "-device icm45686-spi,bus=spi2,cs=13,id=imu4 " \
+    "-device esp32s3.pin-link,pin=7,dev=imu4,line=ssi-gpio-cs,pull=up " \
+    "-device i2spi-chain,bus=i2c0,address=0x13,id=chain,%s" \
+    "links=0x10=imu1:0x11=imu2:0x20=imu3 " \
+    "-device esp32s3.pin-link,pin=10,dev=chain,line=strobe,pull=up "
+
+static QTestState *board(const char *chain_opts)
+{
+    g_autofree char *devices = g_strdup_printf(DEVICES, chain_opts);
+    g_autofree char *args = g_strdup_printf("-machine esp32s3 %s", devices);
+    QTestState *qts = qtest_init(args);
+
+    qtest_writel(qts, I2C_CLK_CONF, BIT(21));
+    qtest_writel(qts, I2C_SCL_LOW, 49);
+    qtest_writel(qts, I2C_SCL_HIGH, 49);
+    qtest_writel(qts, I2C_CTR, BIT(4) | BIT(11));
+
+    qtest_writel(qts, SPI_CLK_GATE, 0x7);
+    qtest_writel(qts, SPI_CLOCK, BIT(31));
+    qtest_writel(qts, SPI_MISC, 0x3F);              /* No hardware CS: GPIOs */
+    qtest_writel(qts, SPI_USER, BIT(0) | BIT(27) | BIT(28));
+    qtest_writel(qts, OUT_W1TS, BIT(PIN_STROBE) | BIT(PIN_DIRECT_CS));
+    qtest_writel(qts, ENABLE_W1TS, BIT(PIN_STROBE) | BIT(PIN_DIRECT_CS));
+    return qts;
+}
+
+static bool i2c_xfer(QTestState *qts, const uint8_t *w, int wn, uint8_t *r, int rn)
+{
+    int c = 0;
+    qtest_writel(qts, I2C_FIFO_CONF, BIT(12) | BIT(13));
+    qtest_writel(qts, I2C_FIFO_CONF, 0);
+    qtest_writel(qts, I2C_COMD(c++), CMD(6, 0, 0, 0));
+    if (wn) {
+        qtest_writel(qts, I2C_DATA, CHAIN << 1);
+        for (int i = 0; i < wn; i++) {
+            qtest_writel(qts, I2C_DATA, w[i]);
+        }
+        qtest_writel(qts, I2C_COMD(c++), CMD(1, 1 + wn, 1, 0));
+    } else {
+        qtest_writel(qts, I2C_DATA, CHAIN << 1 | 1);
+        qtest_writel(qts, I2C_COMD(c++), CMD(1, 1, 1, 0));
+        if (rn > 1) {
+            qtest_writel(qts, I2C_COMD(c++), CMD(3, rn - 1, 0, 0));
+        }
+        qtest_writel(qts, I2C_COMD(c++), CMD(3, 1, 0, 1));
+    }
+    qtest_writel(qts, I2C_COMD(c++), CMD(2, 0, 0, 0));
+    qtest_writel(qts, I2C_INT_CLR, 0x3FFFF);
+    qtest_writel(qts, I2C_CTR, BIT(4) | BIT(5));
+    qtest_clock_step(qts, 1000 * 1000);
+    uint32_t raw = qtest_readl(qts, I2C_INT_RAW);
+    for (int i = 0; i < rn; i++) {
+        r[i] = qtest_readl(qts, I2C_DATA);
+    }
+    return (raw & INT_TRANS_COMPLETE) && !(raw & INT_NACK);
+}
+
+static bool frame(QTestState *qts, uint8_t op, uint8_t target, uint8_t value)
+{
+    uint8_t f[3] = { op, target, value };
+    return i2c_xfer(qts, f, 3, NULL, 0);
+}
+
+static void identify(QTestState *qts, uint8_t node, uint8_t *id)
+{
+    g_assert_true(frame(qts, IDENTIFY, node << 4, 0));
+    g_assert_true(i2c_xfer(qts, NULL, 0, id, 4));
+}
+
+static void pin(QTestState *qts, int n, int level)
+{
+    qtest_writel(qts, level ? OUT_W1TS : OUT_W1TC, BIT(n));
+}
+
+static void spi(QTestState *qts, const uint8_t *tx, uint8_t *rx, size_t n)
+{
+    uint32_t w[16] = { 0 };
+    g_assert_cmpuint(n, <=, 64);
+    memcpy(w, tx, n);
+    for (int i = 0; i < 16; i++) {
+        qtest_writel(qts, SPI_W0 + 4 * i, w[i]);
+    }
+    qtest_writel(qts, SPI_MS_DLEN, n * 8 - 1);
+    qtest_writel(qts, SPI_INT_CLR, BIT(12));
+    qtest_writel(qts, SPI_CMD, BIT(24));
+    qtest_clock_step(qts, 100000);
+    for (int i = 0; i < 16; i++) {
+        w[i] = qtest_readl(qts, SPI_W0 + 4 * i);
+    }
+    memcpy(rx, w, n);
+}
+
+/* A register read framed by a chip-select pin (the strobe, or a host pin) */
+static uint8_t read_reg(QTestState *qts, int cs_pin, uint8_t reg)
+{
+    uint8_t tx[2] = { reg | 0x80, 0 }, rx[2];
+    if (cs_pin >= 0) {
+        pin(qts, cs_pin, 0);
+    }
+    spi(qts, tx, rx, 2);
+    if (cs_pin >= 0) {
+        pin(qts, cs_pin, 1);
+    }
+    return rx[1];
+}
+
+static void write_reg(QTestState *qts, int cs_pin, uint8_t reg, uint8_t v)
+{
+    uint8_t tx[2] = { reg, v }, rx[2];
+    pin(qts, cs_pin, 0);
+    spi(qts, tx, rx, 2);
+    pin(qts, cs_pin, 1);
+}
+
+static uint32_t qom_u32(QTestState *qts, const char *dev, const char *prop)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", dev);
+    QDict *r = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': {'path': %s, "
+                              "'property': %s}}", path, prop);
+    g_assert(qdict_haskey(r, "return"));
+    uint32_t v = qdict_get_int(r, "return");
+    qobject_unref(r);
+    return v;
+}
+
+static void test_identity(void)
+{
+    QTestState *qts = board("nodes=1:2/2,");
+    uint8_t id[4];
+
+    identify(qts, 1, id);
+    g_assert_cmphex(id[0], ==, 0x5c);
+    g_assert_cmphex(id[1], ==, 0x03);
+    g_assert_cmphex(id[2], ==, 1);
+    g_assert_cmphex(id[3], ==, 0x02);           /* Strobe mode; unarmed, unpowered */
+
+    identify(qts, 2, id);
+    g_assert_cmphex(id[2], ==, 2);
+
+    identify(qts, 5, id);                       /* Absent: nobody drives SDA */
+    g_assert_cmphex(id[0], ==, 0xff);
+
+    g_assert_true(frame(qts, SET_SENSOR_POWER, 0x10, 1));
+    g_assert_true(frame(qts, ARM, 0x11, 0));
+    identify(qts, 1, id);
+    g_assert_cmphex(id[3], ==, 0x02 | 0x01 | 0x04);
+    g_assert_cmpuint(qom_u32(qts, "chain", "armed"), ==, 0x11);
+    g_assert_cmpuint(qom_u32(qts, "chain", "powered"), ==, BIT(1));
+    qtest_quit(qts);
+}
+
+static void test_power_and_one_hot(void)
+{
+    QTestState *qts = board("nodes=1:2/2,");
+
+    /* Armed but unpowered: the IMU is not there */
+    g_assert_true(frame(qts, ARM, 0x10, 0));
+    g_assert_cmphex(read_reg(qts, PIN_STROBE, WHO_AM_I), ==, 0x00);
+
+    g_assert_true(frame(qts, POWER_ALL, 0, 1));
+    g_assert_cmphex(read_reg(qts, PIN_STROBE, WHO_AM_I), ==, 0xe9);
+
+    /* The strobe idles high: armed is not asserted */
+    g_assert_cmphex(read_reg(qts, -1, WHO_AM_I), ==, 0x00);
+
+    /* Arming another channel or node moves the one chip select; nothing doubles up */
+    for (int t = 0; t < 3; t++) {
+        uint8_t target = (uint8_t[]){ 0x11, 0x20, 0x10 }[t];
+        g_assert_true(frame(qts, ARM, target, 0));
+        g_assert_cmphex(read_reg(qts, PIN_STROBE, WHO_AM_I), ==, 0xe9);
+    }
+    /* With a host pin's IMU too: two chip selects at once is a fight, and is seen */
+    pin(qts, PIN_DIRECT_CS, 0);
+    read_reg(qts, PIN_STROBE, WHO_AM_I);
+    pin(qts, PIN_DIRECT_CS, 1);
+    g_assert_cmpuint(qom_u32(qts, "imu1", "fights"), >, 0);
+    g_assert_cmpuint(qom_u32(qts, "imu2", "fights"), ==, 0);
+    g_assert_cmpuint(qom_u32(qts, "chain", "fights"), ==, 0);
+
+    /* Arming a channel a node doesn't have, or node 0, disarms it */
+    g_assert_true(frame(qts, ARM, 0x25, 0));
+    g_assert_cmphex(read_reg(qts, PIN_STROBE, WHO_AM_I), ==, 0x00);
+    g_assert_true(frame(qts, ARM, 0x00, 0));
+    g_assert_cmpuint(qom_u32(qts, "chain", "armed"), ==, 0);
+
+    /* Power-off forgets: power back on and the IMU is at reset again */
+    g_assert_true(frame(qts, ARM, 0x10, 0));
+    write_reg(qts, PIN_STROBE, 0x21, 0x0f);
+    g_assert_cmphex(read_reg(qts, PIN_STROBE, 0x21), ==, 0x0f);
+    g_assert_true(frame(qts, SET_SENSOR_RESET, 0x10, 1));
+    g_assert_true(frame(qts, SET_SENSOR_RESET, 0x10, 0));
+    g_assert_cmphex(read_reg(qts, PIN_STROBE, 0x21), ==, 0x00);
+    qtest_quit(qts);
+}
+
+static void test_software_cs(void)
+{
+    QTestState *qts = board("nodes=1:2/2,");
+
+    g_assert_true(frame(qts, POWER_ALL, 0, 1));
+    g_assert_true(frame(qts, SET_MODE, 0x20, 0));
+    g_assert_true(frame(qts, ARM, 0x20, 0));
+    g_assert_cmphex(read_reg(qts, -1, WHO_AM_I), ==, 0x00);      /* Released */
+    g_assert_true(frame(qts, SET_CS, 0x20, 0));
+    g_assert_cmphex(read_reg(qts, -1, WHO_AM_I), ==, 0xe9);      /* No strobe needed */
+    g_assert_true(frame(qts, SET_CS, 0x20, 1));
+    g_assert_cmphex(read_reg(qts, -1, WHO_AM_I), ==, 0x00);
+
+    /* SET_CS for a channel that isn't armed does nothing */
+    g_assert_true(frame(qts, SET_CS, 0x10, 0));
+    g_assert_cmphex(read_reg(qts, -1, WHO_AM_I), ==, 0x00);
+    qtest_quit(qts);
+}
+
+static void test_bad_frames(void)
+{
+    QTestState *qts = board("nodes=1,");
+    uint8_t four[4] = { ARM, 0x10, 0, 0 }, two[2] = { ARM, 0x10 };
+
+    g_assert_true(frame(qts, POWER_ALL, 0, 1));
+    g_assert_true(i2c_xfer(qts, four, 4, NULL, 0));
+    g_assert_true(i2c_xfer(qts, two, 2, NULL, 0));
+    g_assert_true(frame(qts, 0x55, 0x10, 0));                   /* Unknown opcode */
+    g_assert_cmpuint(qom_u32(qts, "chain", "armed"), ==, 0);
+    g_assert_cmphex(read_reg(qts, PIN_STROBE, WHO_AM_I), ==, 0x00);
+    qtest_quit(qts);
+}
+
+static void test_no_nodes_and_misflash(void)
+{
+    QTestState *qts = board("");
+    g_assert_false(frame(qts, DISARM_ALL, 0, 0));               /* An empty cable NACKs */
+    qtest_quit(qts);
+
+    uint8_t id[4];
+    qts = board("nodes=1/2,misflash=2=5,version=2,");
+    identify(qts, 2, id);
+    g_assert_cmphex(id[1], ==, 2);
+    g_assert_cmphex(id[2], ==, 5);
+    qtest_quit(qts);
+}
+
+static void test_fifo(void)
+{
+    QTestState *qts = board("nodes=1:2/2,");
+    uint8_t tx[1 + 20 * 2] = { 0x14 | 0x80 }, rx[sizeof(tx)];
+
+    g_assert_true(frame(qts, POWER_ALL, 0, 1));
+    g_assert_true(frame(qts, ARM, 0x20, 0));                    /* imu3: gyro-z 90 dps */
+    write_reg(qts, PIN_STROBE, 0x10, 0x0f);                     /* PWR_MGMT0 */
+    write_reg(qts, PIN_STROBE, 0x1d, 0x5f);                     /* FIFO_CONFIG0: stream */
+    write_reg(qts, PIN_STROBE, 0x21, 0x0f);                     /* FIFO_CONFIG3 */
+    qtest_clock_step(qts, 100 * 1000 * 1000);                   /* 100 ms: ~20 packets */
+    uint16_t count = read_reg(qts, PIN_STROBE, 0x12);
+    count |= read_reg(qts, PIN_STROBE, 0x13) << 8;
+    g_assert_cmpuint(count, >=, 19);
+    g_assert_cmpuint(count, <=, 22);
+
+    pin(qts, PIN_STROBE, 0);
+    spi(qts, tx, rx, sizeof(tx));
+    pin(qts, PIN_STROBE, 1);
+    const uint8_t *p = rx + 1;
+    g_assert_cmphex(p[0] & 0x60, ==, 0x60);                     /* Accel and gyro */
+    g_assert_cmphex(p[20] & 0x60, ==, 0x20);                    /* Gyro only */
+    int16_t az = p[5] | p[6] << 8, gz = p[11] | p[12] << 8;
+    int32_t az20 = az * 16 | p[19] >> 4, gz20 = gz * 16 | (p[19] & 0xf);
+    g_assert_cmpint(az20, ==, 16384);                           /* 1 g */
+    g_assert_cmpint(gz20, >=, 11796 - 1);                       /* 90 dps at 131.072 */
+    g_assert_cmpint(gz20, <=, 11796 + 1);
+    g_assert_cmpuint(qom_u32(qts, "imu3", "frames-read"), ==, 2);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/i2spi/identity", test_identity);
+    qtest_add_func("/esp32s3/i2spi/power-and-one-hot", test_power_and_one_hot);
+    qtest_add_func("/esp32s3/i2spi/software-cs", test_software_cs);
+    qtest_add_func("/esp32s3/i2spi/bad-frames", test_bad_frames);
+    qtest_add_func("/esp32s3/i2spi/no-nodes-and-misflash", test_no_nodes_and_misflash);
+    qtest_add_func("/esp32s3/i2spi/fifo", test_fifo);
+    return g_test_run();
+}
