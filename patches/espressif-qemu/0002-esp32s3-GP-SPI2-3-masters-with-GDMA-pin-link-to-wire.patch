diff --git a/hw/gpio/esp32s3_gpio.c b/hw/gpio/esp32s3_gpio.c
index 548c928..b97039f 100644
--- a/hw/gpio/esp32s3_gpio.c
+++ b/hw/gpio/esp32s3_gpio.c
@@ -91,11 +91,41 @@ enum { INT_DISABLED, INT_POSEDGE, INT_NEGEDGE, INT_ANYEDGE, INT_LOW_LEVEL, INT_H
 #define FUN_PU              BIT(8)
 #define FUN_IE              BIT(9)
 #define IOMUX_RESET         (FUN_IE | (2 << 10))     /* Input on, drive strength 2 */
+#define MCU_SEL(v)          (((v) >> 12) & 0x7)
+
+/*
+ * A pin's own peripheral functions (IO_MUX MCU_SEL), which bypass the GPIO matrix: the
+ * output signal each drives. ESP-IDF uses them when a bus is on its native pins.
+ */
+static const struct { uint8_t pin, func; uint16_t sig; } iomux_funcs[] = {
+    { 9,  4, 104 },     /* FSPIHD */
+    { 10, 4, 110 },     /* FSPICS0 */
+    { 11, 4, 103 },     /* FSPID */
+    { 12, 4, 101 },     /* FSPICLK */
+    { 13, 4, 102 },     /* FSPIQ */
+    { 14, 4, 105 },     /* FSPIWP */
+    { 43, 0, 12 },      /* U0TXD */
+};
+
+/* The output signal driving pin n through the IO_MUX, or -1 for the GPIO matrix */
+static int iomux_signal(ESP32S3GPIOState *s, int n)
+{
+    int func = MCU_SEL(s->iomux_regs[n]);
+    for (size_t i = 0; i < ARRAY_SIZE(iomux_funcs); i++) {
+        if (iomux_funcs[i].pin == n && iomux_funcs[i].func == func) {
+            return iomux_funcs[i].sig;
+        }
+    }
+    return -1;
+}
 
 static bool pin_output_enabled(ESP32S3GPIOState *s, int n)
 {
     uint32_t sel = s->func_out_sel[n];
     bool oe;
+    if (iomux_signal(s, n) >= 0) {
+        return true;            /* The peripheral drives its own pin */
+    }
     if (OUT_SEL(sel) == ESP32S3_GPIO_OUT_SEL_GPIO || (sel & OEN_SEL)) {
         oe = (s->enable >> n) & 1;
     } else {
@@ -111,6 +141,10 @@ static int pin_output_value(ESP32S3GPIOState *s, int n)
 {
     uint32_t sel = s->func_out_sel[n];
     int v;
+    int sig = iomux_signal(s, n);
+    if (sig >= 0) {
+        return s->sig_out[sig];
+    }
     if (OUT_SEL(sel) == ESP32S3_GPIO_OUT_SEL_GPIO) {
         v = (s->out >> n) & 1;
     } else {
@@ -138,7 +172,13 @@ static int pin_level(ESP32S3GPIOState *s, int n)
     if (s->iomux_regs[n] & FUN_PU) {
         return 1;
     }
-    return 0;           /* Pulled down, or floating */
+    if (s->iomux_regs[n] & FUN_PD) {
+        return 0;
+    }
+    if ((s->board_pulled >> n) & 1) {
+        return (s->board_pull_level >> n) & 1;
+    }
+    return 0;           /* Floating */
 }
 
 static uint64_t input_value(ESP32S3GPIOState *s)
@@ -196,6 +236,11 @@ static void update_pins(ESP32S3GPIOState *s)
             s->status |= 1ULL << n;
         }
         qemu_set_irq(s->pin_out[n], l);
+        if (s->listeners[n]) {
+            for (guint i = 0; i < s->listeners[n]->len; i++) {
+                qemu_set_irq(g_ptr_array_index(s->listeners[n], i), l);
+            }
+        }
     }
     latch_levels(s);
     update_irq(s);
@@ -346,6 +391,29 @@ static void esp32s3_gpio_pin_in(void *opaque, int n, int level)
     update_pins(s);
 }
 
+/* A resistor on the board: 1 up, 0 down, anything else none */
+static void esp32s3_gpio_pin_pull(void *opaque, int n, int level)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+    if (level == 0 || level == 1) {
+        s->board_pulled |= 1ULL << n;
+        s->board_pull_level = (s->board_pull_level & ~(1ULL << n)) | ((uint64_t)level << n);
+    } else {
+        s->board_pulled &= ~(1ULL << n);
+    }
+    update_pins(s);
+}
+
+void esp32s3_gpio_add_listener(ESP32S3GPIOState *s, int pin, qemu_irq irq)
+{
+    assert(pin >= 0 && pin < PINS);
+    if (!s->listeners[pin]) {
+        s->listeners[pin] = g_ptr_array_new();
+    }
+    g_ptr_array_add(s->listeners[pin], irq);
+    qemu_set_irq(irq, (s->level >> pin) & 1);
+}
+
 /* A peripheral's output signal (index: the signal number in FUNC_OUT_SEL_CFG) */
 static void esp32s3_gpio_sig_out(void *opaque, int sig, int level)
 {
@@ -365,7 +433,7 @@ static void esp32s3_gpio_reset_hold(Object *obj, ResetType type)
     memset(s->func_in_sel, 0, sizeof(s->func_in_sel));
     for (int n = 0; n < PINS; n++) {
         s->func_out_sel[n] = ESP32S3_GPIO_OUT_SEL_GPIO;
-        s->iomux_regs[n] = IOMUX_RESET;
+        s->iomux_regs[n] = IOMUX_RESET;     /* MCU_SEL 0: GPIO, but U0TXD on pin 43 */
     }
     /* External drives and peripheral signals are wires: they survive a chip reset */
     update_pins(s);
@@ -385,6 +453,7 @@ static void esp32s3_gpio_init(Object *obj)
     qdev_init_gpio_in_named(DEVICE(s), esp32s3_gpio_pin_in, ESP32S3_GPIO_PIN_IN, PINS);
     qdev_init_gpio_out_named(DEVICE(s), s->pin_out, ESP32S3_GPIO_PIN_OUT, PINS);
     qdev_init_gpio_in_named(DEVICE(s), esp32s3_gpio_sig_out, ESP32S3_GPIO_SIG_OUT, ESP32S3_GPIO_SIGNALS);
+    qdev_init_gpio_in_named(DEVICE(s), esp32s3_gpio_pin_pull, ESP32S3_GPIO_PIN_PULL, PINS);
 }
 
 static Property esp32s3_gpio_properties[] = {
diff --git a/hw/gpio/esp32s3_pin_link.c b/hw/gpio/esp32s3_pin_link.c
new file mode 100644
index 0000000..a3fc917
--- /dev/null
+++ b/hw/gpio/esp32s3_pin_link.c
@@ -0,0 +1,166 @@
+/*
+ * A wire between an ESP32-S3 pin and a device's GPIO line, set from the command line, so
+ * that a board is a list of -device options:
+ *
+ *   -device ili9341,bus=spi2,id=lcd
+ *   -device esp32s3.pin-link,pin=10,dev=lcd,line=ssi-gpio-cs       (pin to device input)
+ *   -device esp32s3.pin-link,pin=9,dev=lcd,line=dc
+ *   -device esp32s3.pin-link,pin=17,dev=touch,line=penirq,dir=out,open-drain=on,pull=up
+ *   -device esp32s3.pin-link,pin=0,pull=up                          (a resistor alone)
+ *
+ * dir=in (the default): the device input follows the pin's level. Many links can share
+ * a pin. dir=out: the device output drives the pin; with open-drain=on it only pulls low
+ * and a 1 releases the pin. pull=up/down: a resistor on the board. invert=on: an inverter
+ * in between. dev is an id (-device ...,id=) or a QOM path; line is a named GPIO line, or
+ * empty for the device's unnamed lines; n is the index within it.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "hw/irq.h"
+#include "hw/gpio/esp32s3_gpio.h"
+
+#define TYPE_ESP32S3_PIN_LINK "esp32s3.pin-link"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3PinLinkState, ESP32S3_PIN_LINK)
+
+struct ESP32S3PinLinkState {
+    DeviceState parent_obj;
+
+    int32_t pin;
+    char *dev;
+    char *line;
+    int32_t n;
+    char *dir;
+    char *pull;
+    bool open_drain;
+    bool invert;
+
+    ESP32S3GPIOState *gpio;
+    qemu_irq target;            /* dir=in: the device's input */
+    qemu_irq pin_in;            /* dir=out: the pin */
+};
+
+/* Pin level to the device */
+static void link_to_device(void *opaque, int n, int level)
+{
+    ESP32S3PinLinkState *s = opaque;
+    qemu_set_irq(s->target, s->invert ? !level : level);
+}
+
+/* Device output to the pin */
+static void link_to_pin(void *opaque, int n, int level)
+{
+    ESP32S3PinLinkState *s = opaque;
+    level = level ? 1 : 0;
+    if (s->invert) {
+        level = !level;
+    }
+    qemu_set_irq(s->pin_in, (s->open_drain && level) ? -1 : level);
+}
+
+static void esp32s3_pin_link_realize(DeviceState *dev, Error **errp)
+{
+    ESP32S3PinLinkState *s = ESP32S3_PIN_LINK(dev);
+
+    s->gpio = (ESP32S3GPIOState *)object_dynamic_cast(object_resolve_path("/machine/soc/gpio", NULL),
+                                                      TYPE_ESP32S3_GPIO);
+    if (!s->gpio) {
+        error_setg(errp, "no ESP32-S3 GPIO (use -machine esp32s3)");
+        return;
+    }
+    if (s->pin < 0 || s->pin >= ESP32S3_GPIO_PINS) {
+        error_setg(errp, "pin must be 0-%d", ESP32S3_GPIO_PINS - 1);
+        return;
+    }
+
+    if (s->pull && *s->pull) {
+        int level = !strcmp(s->pull, "up") ? 1 : !strcmp(s->pull, "down") ? 0 : -2;
+        if (level < 0) {
+            error_setg(errp, "pull must be up or down");
+            return;
+        }
+        qemu_set_irq(qdev_get_gpio_in_named(DEVICE(s->gpio), ESP32S3_GPIO_PIN_PULL, s->pin), level);
+    }
+    if (!s->dev || !*s->dev) {
+        return;                 /* A resistor alone */
+    }
+
+    g_autofree char *path = s->dev[0] == '/' ? g_strdup(s->dev)
+                                             : g_strdup_printf("/machine/peripheral/%s", s->dev);
+    Object *obj = object_resolve_path(path, NULL);
+    DeviceState *target = (DeviceState *)object_dynamic_cast(obj, TYPE_DEVICE);
+    if (!target) {
+        error_setg(errp, "no device '%s' (it must come before the link)", s->dev);
+        return;
+    }
+    const char *line = (s->line && *s->line) ? s->line : NULL;
+    NamedGPIOList *gl;
+    QLIST_FOREACH(gl, &target->gpios, node) {
+        if (g_strcmp0(gl->name, line) == 0) {
+            break;
+        }
+    }
+
+    if (!s->dir || !strcmp(s->dir, "in")) {
+        if (!gl || s->n < 0 || s->n >= gl->num_in) {
+            error_setg(errp, "'%s' has no input line %s[%d]", s->dev, line ? line : "", s->n);
+            return;
+        }
+        s->target = qdev_get_gpio_in_named(target, line, s->n);
+        esp32s3_gpio_add_listener(s->gpio, s->pin, qemu_allocate_irq(link_to_device, s, 0));
+    } else if (!strcmp(s->dir, "out")) {
+        if (!gl || s->n < 0 || s->n >= gl->num_out) {
+            error_setg(errp, "'%s' has no output line %s[%d]", s->dev, line ? line : "", s->n);
+            return;
+        }
+        s->pin_in = qdev_get_gpio_in_named(DEVICE(s->gpio), ESP32S3_GPIO_PIN_IN, s->pin);
+        qdev_connect_gpio_out_named(target, line, s->n, qemu_allocate_irq(link_to_pin, s, 0));
+        if (s->open_drain) {
+            qemu_set_irq(s->pin_in, -1);    /* Released until the device pulls it low */
+        }
+    } else {
+        error_setg(errp, "dir must be in or out");
+    }
+}
+
+static Property esp32s3_pin_link_properties[] = {
+    DEFINE_PROP_INT32("pin", ESP32S3PinLinkState, pin, -1),
+    DEFINE_PROP_STRING("dev", ESP32S3PinLinkState, dev),
+    DEFINE_PROP_STRING("line", ESP32S3PinLinkState, line),
+    DEFINE_PROP_INT32("n", ESP32S3PinLinkState, n, 0),
+    DEFINE_PROP_STRING("dir", ESP32S3PinLinkState, dir),
+    DEFINE_PROP_STRING("pull", ESP32S3PinLinkState, pull),
+    DEFINE_PROP_BOOL("open-drain", ESP32S3PinLinkState, open_drain, false),
+    DEFINE_PROP_BOOL("invert", ESP32S3PinLinkState, invert, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32s3_pin_link_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = esp32s3_pin_link_realize;
+    dc->user_creatable = true;
+    dc->desc = "A wire from an ESP32-S3 pin to a device's GPIO line";
+    device_class_set_props(dc, esp32s3_pin_link_properties);
+}
+
+static const TypeInfo esp32s3_pin_link_info = {
+    .name = TYPE_ESP32S3_PIN_LINK,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(ESP32S3PinLinkState),
+    .class_init = esp32s3_pin_link_class_init,
+};
+
+static void esp32s3_pin_link_register_types(void)
+{
+    type_register_static(&esp32s3_pin_link_info);
+}
+
+type_init(esp32s3_pin_link_register_types)
diff --git a/hw/gpio/meson.build b/hw/gpio/meson.build
index bb965df..eca929e 100644
--- a/hw/gpio/meson.build
+++ b/hw/gpio/meson.build
@@ -25,5 +25,5 @@ system_ss.add(when: 'CONFIG_RISCV_ESP32H4', if_true: files('esp32_gpio.c', 'esp3
 system_ss.add(when: 'CONFIG_RISCV_ESP32P4', if_true: files('esp32_gpio.c', 'esp32c3_gpio.c', 'esp32p4_gpio.c'))
 system_ss.add(when: 'CONFIG_RISCV_ESP32C6', if_true: files('esp32_gpio.c', 'esp32c3_gpio.c', 'esp32c6_gpio.c'))
 system_ss.add(when: 'CONFIG_RISCV_ESP32H2', if_true: files('esp32_gpio.c', 'esp32c3_gpio.c', 'esp32h2_gpio.c'))
-system_ss.add(when: 'CONFIG_XTENSA_ESP32S3', if_true: files('esp32_gpio.c', 'esp32s3_gpio.c'))
+system_ss.add(when: 'CONFIG_XTENSA_ESP32S3', if_true: files('esp32_gpio.c', 'esp32s3_gpio.c', 'esp32s3_pin_link.c'))
 system_ss.add(when: 'CONFIG_PCF8574', if_true: files('pcf8574.c'))
diff --git a/hw/ssi/esp32s3_gpspi.c b/hw/ssi/esp32s3_gpspi.c
new file mode 100644
index 0000000..ebbee9b
--- /dev/null
+++ b/hw/ssi/esp32s3_gpspi.c
@@ -0,0 +1,448 @@
+/*
+ * ESP32-S3 general purpose SPI controllers (GP-SPI2 and GP-SPI3), master mode
+ *
+ * A transaction (CMD.USR) runs its phases on the SSI bus a byte at a time: command
+ * (USER2, low byte first), address (ADDR, from bit 31), dummy cycles, then data from the
+ * W0-W15 buffer or the GDMA (DMA_CONF.DMA_TX_ENA / DMA_RX_ENA), full duplex (USER.DOUTDIN)
+ * or half. Chip selects follow MISC: the enabled ones go active for the transaction
+ * (MASTER_CS_POL) and stay so with CS_KEEP_ACTIVE. TRANS_DONE comes once the bits would
+ * have gone out at the configured clock, so a driver's timing is the chip's.
+ * Register layout: ESP-IDF's soc/esp32s3/register/soc/spi_struct.h and hal/spi_ll.h.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/esp32s3_gpspi.h"
+
+#define A_CMD           0x00
+#define A_ADDR          0x04
+#define A_CTRL          0x08
+#define A_CLOCK         0x0C
+#define A_USER          0x10
+#define A_USER1         0x14
+#define A_USER2         0x18
+#define A_MS_DLEN       0x1C
+#define A_MISC          0x20
+#define A_DIN_MODE      0x24
+#define A_DIN_NUM       0x28
+#define A_DOUT_MODE     0x2C
+#define A_DMA_CONF      0x30
+#define A_DMA_INT_ENA   0x34
+#define A_DMA_INT_CLR   0x38
+#define A_DMA_INT_RAW   0x3C
+#define A_DMA_INT_ST    0x40
+#define A_DMA_INT_SET   0x44
+#define A_W0            0x98
+#define A_W15           0xD4
+#define A_SLAVE         0xE0
+#define A_SLAVE1        0xE4
+#define A_CLK_GATE      0xE8
+#define A_DATE          0xF0
+
+#define CMD_UPDATE      BIT(23)
+#define CMD_USR         BIT(24)
+
+#define CTRL_RD_BIT_ORDER(v)    (((v) >> 23) & 3)
+#define CTRL_WR_BIT_ORDER(v)    (((v) >> 25) & 3)
+
+#define CLOCK_EQU_SYSCLK        BIT(31)
+#define CLOCK_N(v)              (((v) >> 12) & 0x3F)
+#define CLOCK_PRE(v)            (((v) >> 18) & 0xF)
+
+#define USER_DOUTDIN            BIT(0)
+#define USER_CS_HOLD            BIT(6)
+#define USER_CS_SETUP           BIT(7)
+#define USER_MISO_HIGHPART      BIT(24)
+#define USER_MOSI_HIGHPART      BIT(25)
+#define USER_MOSI               BIT(27)
+#define USER_MISO               BIT(28)
+#define USER_DUMMY              BIT(29)
+#define USER_ADDR               BIT(30)
+#define USER_COMMAND            BIT(31)
+
+#define USER1_DUMMY_CYCLES(v)   (((v) & 0xFF) + 1)
+#define USER1_ADDR_BITS(v)      ((((v) >> 27) & 0x1F) + 1)
+#define USER2_CMD_BITS(v)       ((((v) >> 28) & 0xF) + 1)
+
+#define MISC_CS_DIS(n)          BIT(n)
+#define MISC_CS_POL(n)          BIT(7 + (n))
+#define MISC_CS_KEEP_ACTIVE     BIT(30)
+
+#define DMA_CONF_RX_ENA         BIT(27)
+#define DMA_CONF_TX_ENA         BIT(28)
+#define DMA_CONF_RESETS         (BIT(29) | BIT(30) | BIT(31))   /* Self-clearing */
+
+#define INT_RD_DMA_DONE         BIT(8)
+#define INT_WR_DMA_DONE         BIT(9)
+#define INT_RD_BUF_DONE         BIT(10)
+#define INT_WR_BUF_DONE         BIT(11)
+#define INT_TRANS_DONE          BIT(12)
+#define INT_MASK                0x1FFFFF
+
+#define CLK_GATE_MST_CLK_SEL    BIT(2)
+
+#define DATE_VALUE              0x2101220
+#define APB_HZ                  80000000ULL
+#define XTAL_HZ                 40000000ULL
+#define MAX_DATA_BYTES          ((1 << 18) / 8)     /* MS_DLEN is 18 bits */
+
+static int cs_count(ESP32S3GPSPIState *s)
+{
+    return s->port == 2 ? 6 : 3;
+}
+
+static void update_irq(ESP32S3GPSPIState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+static void set_cs(ESP32S3GPSPIState *s, bool active)
+{
+    for (int n = 0; n < cs_count(s); n++) {
+        bool pol_high = s->misc & MISC_CS_POL(n);
+        bool on = active && !(s->misc & MISC_CS_DIS(n));
+        qemu_set_irq(s->cs[n], on == pol_high);
+    }
+}
+
+static uint8_t bitrev8(uint8_t b)
+{
+    b = (b & 0xF0) >> 4 | (b & 0x0F) << 4;
+    b = (b & 0xCC) >> 2 | (b & 0x33) << 2;
+    b = (b & 0xAA) >> 1 | (b & 0x55) << 1;
+    return b;
+}
+
+static uint8_t xfer(ESP32S3GPSPIState *s, uint8_t out)
+{
+    if (CTRL_WR_BIT_ORDER(s->ctrl)) {
+        out = bitrev8(out);
+    }
+    uint8_t in = ssi_transfer(s->bus, out);
+    if (CTRL_RD_BIT_ORDER(s->ctrl)) {
+        in = bitrev8(in);
+    }
+    return in;
+}
+
+/* The SPI clock: APB (or XTAL) / (PRE + 1) / (N + 1), or the APB clock itself */
+static uint64_t sclk_hz(ESP32S3GPSPIState *s)
+{
+    uint64_t src = (s->clk_gate & CLK_GATE_MST_CLK_SEL) ? APB_HZ : XTAL_HZ;
+    if (s->clock & CLOCK_EQU_SYSCLK) {
+        return src;
+    }
+    return src / (CLOCK_PRE(s->clock) + 1) / (CLOCK_N(s->clock) + 1);
+}
+
+static void buf_bytes(ESP32S3GPSPIState *s, uint8_t *out, bool highpart, size_t n)
+{
+    const uint8_t *src = (const uint8_t *)s->data + (highpart ? 32 : 0);
+    size_t avail = sizeof(s->data) - (highpart ? 32 : 0);
+    memset(out, 0, n);
+    memcpy(out, src, MIN(n, avail));
+}
+
+static void store_buf(ESP32S3GPSPIState *s, const uint8_t *in, bool highpart, size_t n)
+{
+    uint8_t *dst = (uint8_t *)s->data + (highpart ? 32 : 0);
+    size_t avail = sizeof(s->data) - (highpart ? 32 : 0);
+    memcpy(dst, in, MIN(n, avail));
+}
+
+static void run_transaction(ESP32S3GPSPIState *s)
+{
+    uint64_t bits = 0;
+    const bool tx_dma = s->dma_conf & DMA_CONF_TX_ENA;
+    const bool rx_dma = s->dma_conf & DMA_CONF_RX_ENA;
+
+    set_cs(s, true);
+
+    if (s->user & USER_COMMAND) {
+        int n = USER2_CMD_BITS(s->user2);
+        uint16_t v = s->user2 & 0xFFFF;
+        xfer(s, v & 0xFF);
+        if (n > 8) {
+            xfer(s, v >> 8);
+        }
+        bits += n;
+    }
+    if (s->user & USER_ADDR) {
+        int n = USER1_ADDR_BITS(s->user1);
+        for (int i = 0; i < DIV_ROUND_UP(n, 8); i++) {
+            xfer(s, s->addr >> (24 - 8 * i));
+        }
+        bits += n;
+    }
+    if (s->user & USER_DUMMY) {
+        int n = USER1_DUMMY_CYCLES(s->user1);
+        for (int i = 0; i < DIV_ROUND_UP(n, 8); i++) {
+            xfer(s, 0xFF);
+        }
+        bits += n;
+    }
+
+    const bool mosi = s->user & USER_MOSI, miso = s->user & USER_MISO;
+    if (mosi || miso) {
+        size_t nbits = (s->ms_dlen & 0x3FFFF) + 1;
+        size_t n = DIV_ROUND_UP(nbits, 8);
+        g_autofree uint8_t *tx = g_malloc(n);
+        g_autofree uint8_t *rx = g_malloc0(n);
+        const bool duplex = s->user & USER_DOUTDIN;
+        uint32_t chan;
+
+        if (mosi) {
+            if (tx_dma) {
+                if (!s->gdma || !esp_gdma_get_channel_periph(s->gdma, s->port == 2 ? GDMA_SPI2 : GDMA_SPI3,
+                                                             ESP_GDMA_OUT_IDX, &chan) ||
+                    !esp_gdma_read_channel(s->gdma, chan, tx, n)) {
+                    qemu_log_mask(LOG_GUEST_ERROR, "esp32s3.spi%u: no TX DMA data\n", s->port);
+                    memset(tx, 0xFF, n);
+                }
+            } else {
+                buf_bytes(s, tx, s->user & USER_MOSI_HIGHPART, n);
+            }
+        } else {
+            memset(tx, 0xFF, n);        /* MOSI idles high while reading */
+        }
+
+        if (duplex || !mosi || !miso) {
+            for (size_t i = 0; i < n; i++) {
+                rx[i] = xfer(s, tx[i]);
+            }
+            bits += nbits;
+        } else {
+            /* Half duplex with both phases: write, then read the same length */
+            for (size_t i = 0; i < n; i++) {
+                xfer(s, tx[i]);
+            }
+            for (size_t i = 0; i < n; i++) {
+                rx[i] = xfer(s, 0xFF);
+            }
+            bits += 2 * nbits;
+        }
+        if (nbits % 8 && miso) {
+            rx[n - 1] &= 0xFF << (8 - nbits % 8);       /* Bits not clocked in */
+        }
+
+        if (miso) {
+            if (rx_dma) {
+                if (!s->gdma || !esp_gdma_get_channel_periph(s->gdma, s->port == 2 ? GDMA_SPI2 : GDMA_SPI3,
+                                                             ESP_GDMA_IN_IDX, &chan) ||
+                    !esp_gdma_write_channel(s->gdma, chan, rx, n)) {
+                    qemu_log_mask(LOG_GUEST_ERROR, "esp32s3.spi%u: no RX DMA buffer\n", s->port);
+                }
+            } else {
+                store_buf(s, rx, s->user & USER_MISO_HIGHPART, n);
+            }
+        }
+    }
+
+    if (!(s->misc & MISC_CS_KEEP_ACTIVE)) {
+        set_cs(s, false);
+    }
+
+    /* Done when the last bit would have gone out (CS setup and hold are a few cycles more) */
+    if (s->user & USER_CS_SETUP) {
+        bits += ((s->user1 >> 17) & 0x1F) + 1;
+    }
+    if (s->user & USER_CS_HOLD) {
+        bits += ((s->user1 >> 22) & 0x1F) + 1;
+    }
+    uint64_t ns = muldiv64(bits, NANOSECONDS_PER_SECOND, MAX(sclk_hz(s), 1));
+    timer_mod(s->done_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + MAX(ns, 1));
+}
+
+static void transaction_done(void *opaque)
+{
+    ESP32S3GPSPIState *s = ESP32S3_GPSPI(opaque);
+    uint32_t done = INT_TRANS_DONE;
+    if (s->user & USER_MOSI) {
+        done |= (s->dma_conf & DMA_CONF_TX_ENA) ? INT_WR_DMA_DONE : INT_WR_BUF_DONE;
+    }
+    if (s->user & USER_MISO) {
+        done |= (s->dma_conf & DMA_CONF_RX_ENA) ? INT_RD_DMA_DONE : INT_RD_BUF_DONE;
+    }
+    s->cmd &= ~CMD_USR;
+    s->int_raw |= done;
+    update_irq(s);
+}
+
+static uint64_t esp32s3_gpspi_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3GPSPIState *s = ESP32S3_GPSPI(opaque);
+
+    if (addr >= A_W0 && addr <= A_W15) {
+        return s->data[(addr - A_W0) / 4];
+    }
+    switch (addr) {
+    case A_CMD:         return s->cmd;
+    case A_ADDR:        return s->addr;
+    case A_CTRL:        return s->ctrl;
+    case A_CLOCK:       return s->clock;
+    case A_USER:        return s->user;
+    case A_USER1:       return s->user1;
+    case A_USER2:       return s->user2;
+    case A_MS_DLEN:     return s->ms_dlen;
+    case A_MISC:        return s->misc;
+    case A_DIN_MODE:    return s->din_mode;
+    case A_DIN_NUM:     return s->din_num;
+    case A_DOUT_MODE:   return s->dout_mode;
+    case A_DMA_CONF:    return s->dma_conf | BIT(0);      /* OUTFIFO_EMPTY */
+    case A_DMA_INT_ENA: return s->int_ena;
+    case A_DMA_INT_RAW: return s->int_raw;
+    case A_DMA_INT_ST:  return s->int_raw & s->int_ena;
+    case A_SLAVE:       return s->slave;
+    case A_SLAVE1:      return s->slave1;
+    case A_CLK_GATE:    return s->clk_gate;
+    case A_DATE:        return DATE_VALUE;
+    default:
+        return 0;
+    }
+}
+
+static void esp32s3_gpspi_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3GPSPIState *s = ESP32S3_GPSPI(opaque);
+
+    if (addr >= A_W0 && addr <= A_W15) {
+        s->data[(addr - A_W0) / 4] = value;
+        return;
+    }
+    switch (addr) {
+    case A_CMD:
+        /* UPDATE (copy the configuration to the SPI clock domain) is done at once */
+        s->cmd = value & ~CMD_UPDATE & ~CMD_USR;
+        if (value & CMD_USR) {
+            if (s->slave & BIT(26)) {
+                qemu_log_mask(LOG_UNIMP, "esp32s3.spi%u: slave mode\n", s->port);
+                return;
+            }
+            s->cmd |= CMD_USR;
+            run_transaction(s);
+        }
+        break;
+    case A_ADDR:        s->addr = value; break;
+    case A_CTRL:        s->ctrl = value; break;
+    case A_CLOCK:       s->clock = value; break;
+    case A_USER:        s->user = value; break;
+    case A_USER1:       s->user1 = value; break;
+    case A_USER2:       s->user2 = value; break;
+    case A_MS_DLEN:     s->ms_dlen = value & 0x3FFFF; break;
+    case A_MISC: {
+        bool keep = s->misc & MISC_CS_KEEP_ACTIVE;
+        s->misc = value;
+        if (keep && !(value & MISC_CS_KEEP_ACTIVE)) {
+            set_cs(s, false);           /* The end of a CS_KEEP_ACTIVE run */
+        }
+        break;
+    }
+    case A_DIN_MODE:    s->din_mode = value; break;
+    case A_DIN_NUM:     s->din_num = value; break;
+    case A_DOUT_MODE:   s->dout_mode = value; break;
+    case A_DMA_CONF:    s->dma_conf = value & ~DMA_CONF_RESETS; break;
+    case A_DMA_INT_ENA: s->int_ena = value & INT_MASK; update_irq(s); break;
+    case A_DMA_INT_CLR: s->int_raw &= ~value; update_irq(s); break;
+    case A_DMA_INT_RAW: s->int_raw = value & INT_MASK; update_irq(s); break;
+    case A_DMA_INT_SET: s->int_raw |= value & INT_MASK; update_irq(s); break;
+    case A_SLAVE:       s->slave = value & ~BIT(27); break;    /* SOFT_RESET clears itself */
+    case A_SLAVE1:      s->slave1 = value; break;
+    case A_CLK_GATE:    s->clk_gate = value; break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "esp32s3.spi%u: write to 0x%" HWADDR_PRIx "\n", s->port, addr);
+        break;
+    }
+}
+
+static const MemoryRegionOps esp32s3_gpspi_ops = {
+    .read = esp32s3_gpspi_read,
+    .write = esp32s3_gpspi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void esp32s3_gpspi_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3GPSPIState *s = ESP32S3_GPSPI(obj);
+
+    timer_del(s->done_timer);
+    s->cmd = s->addr = s->ctrl = 0;
+    s->clock = 0x80003043;              /* Reset values from the TRM */
+    s->user = 0x800000C0;
+    s->user1 = 0xB8410007;
+    s->user2 = 0x78000000;
+    s->ms_dlen = 0;
+    s->misc = 0x3E;                     /* CS1-CS5 disabled, CS0 enabled */
+    s->din_mode = s->din_num = s->dout_mode = 0;
+    s->dma_conf = 0;
+    s->int_ena = s->int_raw = 0;
+    memset(s->data, 0, sizeof(s->data));
+    s->slave = 0x280000;
+    s->slave1 = 0;
+    s->clk_gate = 0;
+    set_cs(s, false);
+    update_irq(s);
+}
+
+static void esp32s3_gpspi_realize(DeviceState *dev, Error **errp)
+{
+    ESP32S3GPSPIState *s = ESP32S3_GPSPI(dev);
+
+    if (s->port != 2 && s->port != 3) {
+        error_setg(errp, "port must be 2 or 3");
+        return;
+    }
+    g_autofree char *name = g_strdup_printf("spi%u", s->port);
+    s->bus = ssi_create_bus(dev, name);
+}
+
+static void esp32s3_gpspi_init(Object *obj)
+{
+    ESP32S3GPSPIState *s = ESP32S3_GPSPI(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32s3_gpspi_ops, s, TYPE_ESP32S3_GPSPI, ESP32S3_GPSPI_REGS);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    qdev_init_gpio_out_named(DEVICE(s), s->cs, ESP32S3_GPSPI_CS_OUT, ESP32S3_GPSPI_CS_COUNT);
+    s->done_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, transaction_done, s);
+}
+
+static Property esp32s3_gpspi_properties[] = {
+    DEFINE_PROP_UINT32("port", ESP32S3GPSPIState, port, 2),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32s3_gpspi_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = esp32s3_gpspi_realize;
+    rc->phases.hold = esp32s3_gpspi_reset_hold;
+    device_class_set_props(dc, esp32s3_gpspi_properties);
+}
+
+static const TypeInfo esp32s3_gpspi_info = {
+    .name = TYPE_ESP32S3_GPSPI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3GPSPIState),
+    .instance_init = esp32s3_gpspi_init,
+    .class_init = esp32s3_gpspi_class_init,
+};
+
+static void esp32s3_gpspi_register_types(void)
+{
+    type_register_static(&esp32s3_gpspi_info);
+}
+
+type_init(esp32s3_gpspi_register_types)
