+/*
+ * QTest for the ESP32-S3 GP-SPI2 controller: a SPI NOR flash (gd25q32) on the spi2 bus,
+ * its chip select wired to a pin, read through the W buffer and through the GDMA.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "libqtest.h"
+
+#define SPI2            0x60024000
+#define SPI_CMD         (SPI2 + 0x00)
+#define SPI_CLOCK       (SPI2 + 0x0C)
+#define SPI_USER        (SPI2 + 0x10)
+#define SPI_USER1       (SPI2 + 0x14)
+#define SPI_USER2       (SPI2 + 0x18)
+#define SPI_MS_DLEN     (SPI2 + 0x1C)
+#define SPI_MISC        (SPI2 + 0x20)
+#define SPI_DMA_CONF    (SPI2 + 0x30)
+#define SPI_INT_ENA     (SPI2 + 0x34)
+#define SPI_INT_CLR     (SPI2 + 0x38)
+#define SPI_INT_RAW     (SPI2 + 0x3C)
+#define SPI_W0          (SPI2 + 0x98)
+#define SPI_CLK_GATE    (SPI2 + 0xE8)
+
+#define CMD_UPDATE      BIT(23)
+#define CMD_USR         BIT(24)
+#define USER_DOUTDIN    BIT(0)
+#define USER_MOSI       BIT(27)
+#define USER_MISO       BIT(28)
+#define USER_COMMAND    BIT(31)
+#define TRANS_DONE      BIT(12)
+
+#define GPIO            0x60004000
+#define GPIO_OUT_W1TS   (GPIO + 0x08)
+#define GPIO_EN_W1TS    (GPIO + 0x24)
+#define OUT_SEL(n)      (GPIO + 0x554 + 4 * (n))
+#define IN              (GPIO + 0x3C)
+#define IO_MUX(n)       (0x60009004 + 4 * (n))
+#define FSPICS0         110
+
+#define GDMA            0x6003F000
+#define GDMA_IN(ch, r)  (GDMA + (ch) * 0xC0 + (r))
+#define GDMA_OUT(ch, r) (GDMA + (ch) * 0xC0 + 0x60 + (r))
+#define LINK            0x20
+#define PERI_SEL        0x48
+#define OUT_LINK_START  BIT(21)
+#define IN_LINK_START   BIT(22)
+
+#define INTMATRIX_STATUS0   0x600C218C
+#define SPI2_SOURCE         21
+
+#define CS_PIN          14
+#define JEDEC_GD25Q32   0x1640C8        /* C8 40 16, read as a little-endian word */
+
+static QTestState *start(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3 "
+                                 "-device gd25q32,bus=spi2,id=flash "
+                                 "-device esp32s3.pin-link,pin=14,dev=flash,line=ssi-gpio-cs,pull=up");
+    /* As spi_master: the controller's clock on, 10 MHz (80 MHz / 8), CS0 only */
+    qtest_writel(qts, SPI_CLK_GATE, 0x7);
+    qtest_writel(qts, SPI_CLOCK, (7 << 12) | (3 << 6) | 7);
+    qtest_writel(qts, SPI_MISC, 0x3E);
+    return qts;
+}
+
+/* JEDEC ID (0x9F), full duplex: 4 bytes out, 4 in */
+static void jedec_setup(QTestState *qts)
+{
+    qtest_writel(qts, SPI_USER, USER_DOUTDIN | USER_MOSI | USER_MISO);
+    qtest_writel(qts, SPI_MS_DLEN, 31);
+    qtest_writel(qts, SPI_CMD, CMD_UPDATE);
+    g_assert_cmphex(qtest_readl(qts, SPI_CMD), ==, 0);     /* The update is done at once */
+}
+
+static void run(QTestState *qts)
+{
+    qtest_writel(qts, SPI_CMD, CMD_USR);
+    qtest_clock_step(qts, 1000000);
+}
+
+static void test_cs_through_matrix(void)
+{
+    QTestState *qts = start();
+
+    /* The pull-up holds the flash deselected */
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(CS_PIN), ==, BIT(CS_PIN));
+
+    /* FSPICS0 to the pin: idle high, low during a transaction */
+    qtest_writel(qts, OUT_SEL(CS_PIN), FSPICS0);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(CS_PIN), ==, BIT(CS_PIN));
+
+    jedec_setup(qts);
+    qtest_writel(qts, SPI_W0, 0xFFFFFF9F);
+    run(qts);
+    g_assert_cmphex(qtest_readl(qts, SPI_INT_RAW) & TRANS_DONE, ==, TRANS_DONE);
+    g_assert_cmphex(qtest_readl(qts, SPI_CMD) & CMD_USR, ==, 0);
+    g_assert_cmphex(qtest_readl(qts, SPI_W0) >> 8, ==, JEDEC_GD25Q32);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(CS_PIN), ==, BIT(CS_PIN));
+
+    /* CS0 disabled: nobody answers */
+    qtest_writel(qts, SPI_INT_CLR, TRANS_DONE);
+    qtest_writel(qts, SPI_MISC, 0x3F);
+    qtest_writel(qts, SPI_W0, 0xFFFFFF9F);
+    run(qts);
+    g_assert_cmphex(qtest_readl(qts, SPI_W0), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_cs_by_hand(void)
+{
+    QTestState *qts = start();
+
+    /* The CS pin as a plain output, as Arduino's SD library does */
+    qtest_writel(qts, GPIO_EN_W1TS, BIT(CS_PIN));
+    qtest_writel(qts, GPIO_OUT_W1TS, BIT(CS_PIN));
+    jedec_setup(qts);
+    qtest_writel(qts, SPI_W0, 0xFFFFFF9F);
+    run(qts);
+    g_assert_cmphex(qtest_readl(qts, SPI_W0), ==, 0);      /* High: not selected */
+
+    qtest_writel(qts, GPIO + 0x0C, BIT(CS_PIN));            /* OUT_W1TC */
+    qtest_writel(qts, SPI_W0, 0xFFFFFF9F);
+    run(qts);
+    g_assert_cmphex(qtest_readl(qts, SPI_W0) >> 8, ==, JEDEC_GD25Q32);
+    qtest_quit(qts);
+}
+
+static void test_command_phase(void)
+{
+    QTestState *qts = start();
+
+    /* 0x9F in the command phase (as spi_ll_set_command leaves it), then 24 bits in */
+    qtest_writel(qts, OUT_SEL(CS_PIN), FSPICS0);
+    qtest_writel(qts, SPI_USER, USER_COMMAND | USER_MISO);
+    qtest_writel(qts, SPI_USER2, (7u << 28) | 0x9F);
+    qtest_writel(qts, SPI_MS_DLEN, 23);
+    run(qts);
+    g_assert_cmphex(qtest_readl(qts, SPI_W0) & 0xFFFFFF, ==, JEDEC_GD25Q32);
+    qtest_quit(qts);
+}
+
+static void test_timing_and_irq(void)
+{
+    QTestState *qts = start();
+
+    qtest_writel(qts, OUT_SEL(CS_PIN), FSPICS0);
+    qtest_writel(qts, SPI_INT_ENA, TRANS_DONE);
+    jedec_setup(qts);
+    qtest_writel(qts, SPI_W0, 0xFFFFFF9F);
+
+    /* 32 bits at 10 MHz: 3.2 us */
+    qtest_writel(qts, SPI_CMD, CMD_USR);
+    qtest_clock_step(qts, 3000);
+    g_assert_cmphex(qtest_readl(qts, SPI_INT_RAW) & TRANS_DONE, ==, 0);
+    g_assert_false(qtest_readl(qts, INTMATRIX_STATUS0) & BIT(SPI2_SOURCE));
+    qtest_clock_step(qts, 300);
+    g_assert_cmphex(qtest_readl(qts, SPI_INT_RAW) & TRANS_DONE, ==, TRANS_DONE);
+    g_assert_true(qtest_readl(qts, INTMATRIX_STATUS0) & BIT(SPI2_SOURCE));
+
+    qtest_writel(qts, SPI_INT_CLR, TRANS_DONE);
+    g_assert_false(qtest_readl(qts, INTMATRIX_STATUS0) & BIT(SPI2_SOURCE));
+    qtest_quit(qts);
+}
+
+static void test_iomux_cs(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3 "
+                                 "-device gd25q32,bus=spi2,id=flash "
+                                 "-device esp32s3.pin-link,pin=10,dev=flash,line=ssi-gpio-cs,pull=up");
+    qtest_writel(qts, SPI_CLK_GATE, 0x7);
+    qtest_writel(qts, SPI_MISC, 0x3E);
+    /* GPIO10's own function 4 is FSPICS0: no GPIO matrix */
+    qtest_writel(qts, IO_MUX(10), (4 << 12) | BIT(9));
+    jedec_setup(qts);
+    qtest_writel(qts, SPI_W0, 0xFFFFFF9F);
+    run(qts);
+    g_assert_cmphex(qtest_readl(qts, SPI_W0) >> 8, ==, JEDEC_GD25Q32);
+    qtest_quit(qts);
+}
+
+static void test_dma(void)
+{
+    QTestState *qts = start();
+    const uint32_t tx_desc = 0x3FCA0000, rx_desc = 0x3FCA0010;
+    const uint32_t tx_buf = 0x3FCA0100, rx_buf = 0x3FCA0200;
+    const uint8_t cmd[4] = { 0x9F, 0xFF, 0xFF, 0xFF };
+
+    qtest_writel(qts, OUT_SEL(CS_PIN), FSPICS0);
+    qtest_memwrite(qts, tx_buf, cmd, sizeof(cmd));
+    qtest_memset(qts, rx_buf, 0xAA, 4);
+    /* Descriptors: size, length, suc_eof, owner = DMA; buffer; next (none) */
+    qtest_writel(qts, tx_desc, BIT(31) | BIT(30) | (4 << 12) | 4);
+    qtest_writel(qts, tx_desc + 4, tx_buf);
+    qtest_writel(qts, tx_desc + 8, 0);
+    qtest_writel(qts, rx_desc, BIT(31) | (0 << 12) | 4);
+    qtest_writel(qts, rx_desc + 4, rx_buf);
+    qtest_writel(qts, rx_desc + 8, 0);
+
+    /* Channel 0 to SPI2, both directions */
+    qtest_writel(qts, GDMA_OUT(0, PERI_SEL), 0);
+    qtest_writel(qts, GDMA_IN(0, PERI_SEL), 0);
+    qtest_writel(qts, GDMA_OUT(0, LINK), (tx_desc & 0xFFFFF) | OUT_LINK_START);
+    qtest_writel(qts, GDMA_IN(0, LINK), (rx_desc & 0xFFFFF) | IN_LINK_START);
+
+    qtest_writel(qts, SPI_DMA_CONF, BIT(27) | BIT(28));
+    jedec_setup(qts);
+    run(qts);
+    g_assert_cmphex(qtest_readl(qts, SPI_INT_RAW) & TRANS_DONE, ==, TRANS_DONE);
+    g_assert_cmphex(qtest_readl(qts, rx_buf) >> 8, ==, JEDEC_GD25Q32);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/gpspi/cs_through_matrix", test_cs_through_matrix);
+    qtest_add_func("/esp32s3/gpspi/cs_by_hand", test_cs_by_hand);
+    qtest_add_func("/esp32s3/gpspi/command_phase", test_command_phase);
+    qtest_add_func("/esp32s3/gpspi/timing_and_irq", test_timing_and_irq);
+    qtest_add_func("/esp32s3/gpspi/iomux_cs", test_iomux_cs);
+    qtest_add_func("/esp32s3/gpspi/dma", test_dma);
+    return g_test_run();
+}
