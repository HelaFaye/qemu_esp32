diff --git a/include/hw/ssi/esp32s3_gpspi.h b/include/hw/ssi/esp32s3_gpspi.h
new file mode 100644
index 0000000..aa1c276
--- /dev/null
+++ b/include/hw/ssi/esp32s3_gpspi.h
@@ -0,0 +1,46 @@
+/*
+ * ESP32-S3 general purpose SPI controllers (GP-SPI2 and GP-SPI3), master mode
+ *
+ * Each controller has an SSI bus, "spi2" or "spi3": attach devices with
+ *   -device <model>,bus=spi2
+ * and connect their chip select to the pin the board wires it to (esp32s3.pin-link),
+ * because a device is selected by its CS pin's level. Its CS can be the controller's (the
+ * FSPICSn / SPI3_CSn signals, routed to a pin by the GPIO matrix or the IO_MUX) or a pin
+ * the firmware toggles by hand: both work as on the chip.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/ssi/ssi.h"
+#include "hw/dma/esp_gdma.h"
+
+#define TYPE_ESP32S3_GPSPI "esp32s3.gpspi"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3GPSPIState, ESP32S3_GPSPI)
+
+#define ESP32S3_GPSPI_CS_COUNT  6       /* SPI2: 6, SPI3: 3 */
+#define ESP32S3_GPSPI_CS_OUT    "cs"    /* The CSn signals, to the GPIO matrix */
+#define ESP32S3_GPSPI_REGS      0x100
+#define ESP32S3_GPSPI_BUF_WORDS 16
+
+struct ESP32S3GPSPIState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    SSIBus *bus;
+    qemu_irq irq;
+    qemu_irq cs[ESP32S3_GPSPI_CS_COUNT];
+    QEMUTimer *done_timer;
+    ESPGdmaState *gdma;
+
+    uint32_t port;                      /* 2 or 3 */
+
+    uint32_t cmd, addr, ctrl, clock, user, user1, user2, ms_dlen, misc;
+    uint32_t din_mode, din_num, dout_mode;
+    uint32_t dma_conf, int_ena, int_raw;
+    uint32_t data[ESP32S3_GPSPI_BUF_WORDS];
+    uint32_t slave, slave1, clk_gate;
+};
