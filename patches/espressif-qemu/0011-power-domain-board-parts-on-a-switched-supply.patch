diff --git a/tests/qtest/esp32s3-i2c-devices-test.c b/tests/qtest/esp32s3-i2c-devices-test.c
index 45c1981..f298270 100644
--- a/tests/qtest/esp32s3-i2c-devices-test.c
+++ b/tests/qtest/esp32s3-i2c-devices-test.c
@@ -239,6 +239,44 @@ static void test_expander(void)
     qtest_quit(qts);
 }
 
+/* A part on a switched supply: off, it doesn't answer; on again, it's as at power-on */
+static void test_power_domain(void)
+{
+    QTestState *qts = board("-device mcp23017,bus=i2c0,address=0x20,id=exp "
+                            "-device mcp23017,bus=i2c0,address=0x21,id=other "
+                            "-device power-domain,id=pwr,devices=exp");
+    uint8_t r[1];
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00, 0x55 }, 2, NULL, 0));     /* IODIRA */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));
+    g_assert_cmphex(r[0], ==, 0x55);
+
+    qom_set(qts, "/machine/peripheral/pwr", "on", "false");
+    g_assert_false(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));             /* NACK */
+    g_assert_true(i2c_xfer(qts, 0x21, (uint8_t[]){ 0x00 }, 1, r, 1));              /* Not its */
+
+    qom_set(qts, "/machine/peripheral/pwr", "on", "true");
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));
+    g_assert_cmphex(r[0], ==, 0xFF);                                               /* Reset value */
+    qtest_quit(qts);
+}
+
+/* Switched by the firmware: on while GPIO10 is high (T-Deck's BOARD_POWERON) */
+static void test_power_domain_pin(void)
+{
+    QTestState *qts = board("-device mcp23017,bus=i2c0,address=0x20,id=exp "
+                            "-device power-domain,id=pwr,devices=exp,switched=on "
+                            "-device esp32s3.pin-link,pin=10,dev=pwr,line=enable");
+    uint8_t r[1];
+    g_assert_false(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));        /* Pin low: off */
+    qtest_writel(qts, GPIO + 0x24, BIT(10));                                  /* ENABLE_W1TS */
+    qtest_writel(qts, GPIO + 0x08, BIT(10));                                  /* OUT_W1TS */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));
+    g_assert_cmphex(r[0], ==, 0xFF);
+    qtest_writel(qts, GPIO + 0x0C, BIT(10));                                  /* OUT_W1TC */
+    g_assert_false(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));
+    qtest_quit(qts);
+}
+
 static void test_buttons_and_encoder(void)
 {
     QTestState *qts = board("-device gpio-button,pin=0,id=boot "
@@ -275,5 +313,7 @@ int main(int argc, char **argv)
     qtest_add_func("/esp32s3/i2c-devices/keyboard", test_keyboard);
     qtest_add_func("/esp32s3/i2c-devices/expander", test_expander);
     qtest_add_func("/esp32s3/i2c-devices/buttons_and_encoder", test_buttons_and_encoder);
+    qtest_add_func("/esp32s3/i2c-devices/power_domain", test_power_domain);
+    qtest_add_func("/esp32s3/i2c-devices/power_domain_pin", test_power_domain_pin);
     return g_test_run();
 }
diff --git a/tests/qtest/esp32s3-spi-devices-test.c b/tests/qtest/esp32s3-spi-devices-test.c
index 1cd2661..7ebbbb8 100644
--- a/tests/qtest/esp32s3-spi-devices-test.c
+++ b/tests/qtest/esp32s3-spi-devices-test.c
@@ -174,6 +174,49 @@ static void test_lcd(void)
     qtest_quit(qts);
 }
 
+static void read_id(QTestState *qts, uint8_t *rx)
+{
+    uint8_t cmd = 0x04, tx[4] = { 0 };
+    pin(qts, PIN_LCD_CS, 0);
+    pin(qts, PIN_DC, 0);
+    xfer(qts, &cmd, NULL, 1);
+    pin(qts, PIN_DC, 1);
+    xfer(qts, tx, rx, 4);
+    pin(qts, PIN_LCD_CS, 1);
+}
+
+/* The display on its own supply (power-domain): off, it doesn't answer; on again, it's
+ * asleep and dark until the firmware sets it up again */
+static void test_lcd_power(void)
+{
+    QTestState *qts = qtest_init(BOARD "-device power-domain,id=lcd_pwr,devices=lcd");
+    uint8_t rx[4];
+    int w, h;
+    board_init(qts);
+    lcd_cmd(qts, 0x11, NULL, 0);
+    lcd_cmd(qts, 0x3A, (uint8_t[]){ 0x55 }, 1);
+    lcd_cmd(qts, 0x36, (uint8_t[]){ 0x48 }, 1);
+    lcd_cmd(qts, 0x29, NULL, 0);
+    lcd_cmd(qts, 0x2A, (uint8_t[]){ 0, 10, 0, 10 }, 4);
+    lcd_cmd(qts, 0x2B, (uint8_t[]){ 0, 20, 0, 20 }, 4);
+    lcd_cmd(qts, 0x2C, (uint8_t[]){ 0xFF, 0xFF }, 2);
+    uint8_t *px = screendump(qts, &w, &h);
+    g_assert_cmphex(PX(10, 20), ==, 0xFFFFFF);
+    g_free(px);
+
+    qtest_qom_set_bool(qts, "/machine/peripheral/lcd_pwr", "on", false);
+    read_id(qts, rx);
+    g_assert_cmphex(rx[1] | rx[2] | rx[3], ==, 0);          /* Nothing on MISO */
+
+    qtest_qom_set_bool(qts, "/machine/peripheral/lcd_pwr", "on", true);
+    read_id(qts, rx);
+    g_assert_cmphex(rx[2], ==, 0x93);
+    px = screendump(qts, &w, &h);
+    g_assert_cmphex(PX(10, 20), ==, 0x000000);               /* Asleep, display off */
+    g_free(px);
+    qtest_quit(qts);
+}
+
 static uint16_t touch_read(QTestState *qts, uint8_t ctrl)
 {
     uint8_t tx[3] = { ctrl, 0, 0 }, rx[3];
@@ -336,5 +379,6 @@ int main(int argc, char **argv)
     qtest_add_func("/esp32s3/spi-devices/ili9341", test_lcd);
     qtest_add_func("/esp32s3/spi-devices/xpt2046", test_touch);
     qtest_add_func("/esp32s3/spi-devices/sd", test_sd);
+    qtest_add_func("/esp32s3/spi-devices/lcd_power", test_lcd_power);
     return g_test_run();
 }
