diff --git a/hw/misc/power_domain.c b/hw/misc/power_domain.c
new file mode 100644
index 0000000..e0fa428
--- /dev/null
+++ b/hw/misc/power_domain.c
@@ -0,0 +1,161 @@
+/*
+ * A power domain: board parts on their own supply (a regulator, a load switch, a GPIO
+ * that powers a module), switched at run time.
+ *
+ *   -device power-domain,id=lcd_pwr,devices=lcd:touch
+ *   qom-set /machine/peripheral/lcd_pwr on false
+ *
+ * Or switched by the firmware, through a pin (a regulator's enable, a load switch):
+ *   -device power-domain,id=periph_pwr,devices=lcd:lora,switched=on
+ *   -device esp32s3.pin-link,pin=10,dev=periph_pwr,line=enable
+ * then it's on while the pin is high (and 'on' is true).
+ *
+ * Off, its SPI and I2C parts drop off their buses (an I2C part doesn't ACK its address,
+ * an SPI part drives nothing and hears nothing). On again, each starts from its power-on
+ * state (a cold reset), as a real part does: a display forgets its setup, a radio its
+ * configuration, and the firmware has to notice.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qom/object.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "hw/i2c/i2c.h"
+#include "hw/irq.h"
+
+#define TYPE_POWER_DOMAIN "power-domain"
+OBJECT_DECLARE_SIMPLE_TYPE(PowerDomainState, POWER_DOMAIN)
+
+struct PowerDomainState {
+    DeviceState parent_obj;
+    char *devices;              /* ids, separated by ':' */
+    bool on;                    /* Powered now */
+    bool want;                  /* The 'on' property */
+    bool initially_on;
+    bool switched;              /* Also needs its enable line high */
+    bool enable;
+};
+
+static DeviceState *find(const char *id, Error **errp)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", id);
+    Object *o = object_resolve_path(path, NULL);
+    if (!o || !object_dynamic_cast(o, TYPE_DEVICE)) {
+        error_setg(errp, "power-domain: no device with id '%s'", id);
+        return NULL;
+    }
+    return DEVICE(o);
+}
+
+static void set_supply(DeviceState *d, bool on)
+{
+    SSIPeripheral *ssi = (SSIPeripheral *)object_dynamic_cast(OBJECT(d), TYPE_SSI_PERIPHERAL);
+    I2CSlave *i2c = (I2CSlave *)object_dynamic_cast(OBJECT(d), TYPE_I2C_SLAVE);
+
+    if (ssi) {
+        ssi->unpowered = !on;
+    }
+    if (i2c) {
+        i2c->unpowered = !on;
+    }
+}
+
+static void apply(PowerDomainState *s, bool on, Error **errp)
+{
+    g_auto(GStrv) ids = g_strsplit(s->devices ? s->devices : "", ":", -1);
+
+    for (int i = 0; ids[i]; i++) {
+        if (!*ids[i]) {
+            continue;
+        }
+        DeviceState *d = find(ids[i], errp);
+        if (!d) {
+            return;
+        }
+        if (on && !s->on) {
+            device_cold_reset(d);          /* Power-on state */
+        }
+        set_supply(d, on);
+    }
+    s->on = on;
+}
+
+static void update(PowerDomainState *s, Error **errp)
+{
+    apply(s, s->want && (!s->switched || s->enable), errp);
+}
+
+static bool get_on(Object *obj, Error **errp)
+{
+    return POWER_DOMAIN(obj)->on;
+}
+
+static void set_on(Object *obj, bool on, Error **errp)
+{
+    PowerDomainState *s = POWER_DOMAIN(obj);
+    s->want = on;
+    update(s, errp);
+}
+
+static void enable_in(void *opaque, int n, int level)
+{
+    PowerDomainState *s = POWER_DOMAIN(opaque);
+    s->enable = level;
+    if (DEVICE(s)->realized) {
+        update(s, &error_warn);
+    }
+}
+
+static void power_domain_realize(DeviceState *dev, Error **errp)
+{
+    PowerDomainState *s = POWER_DOMAIN(dev);
+
+    /* Check the ids now (the parts come first on the command line) */
+    s->on = true;
+    s->want = s->initially_on;
+    update(s, errp);
+}
+
+static void power_domain_init(Object *obj)
+{
+    object_property_add_bool(obj, "on", get_on, set_on);
+    qdev_init_gpio_in_named(DEVICE(obj), enable_in, "enable", 1);
+}
+
+static Property power_domain_properties[] = {
+    DEFINE_PROP_STRING("devices", PowerDomainState, devices),
+    DEFINE_PROP_BOOL("initially-on", PowerDomainState, initially_on, true),
+    DEFINE_PROP_BOOL("switched", PowerDomainState, switched, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void power_domain_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = power_domain_realize;
+    dc->user_creatable = true;
+    dc->desc = "Board parts on a switched supply";
+    device_class_set_props(dc, power_domain_properties);
+}
+
+static const TypeInfo power_domain_info = {
+    .name = TYPE_POWER_DOMAIN,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(PowerDomainState),
+    .instance_init = power_domain_init,
+    .class_init = power_domain_class_init,
+};
+
+static void power_domain_register_types(void)
+{
+    type_register_static(&power_domain_info);
+}
+
+type_init(power_domain_register_types)
