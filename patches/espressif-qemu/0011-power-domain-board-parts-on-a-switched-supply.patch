 hw/misc/meson.build                    |   1 +
 hw/misc/power_domain.c                 | 161 +++++++++++++++++++++++++
 hw/ssi/ssi.c                           |   3 +
 include/hw/i2c/i2c.h                   |   3 +
 include/hw/ssi/ssi.h                   |   3 +
 tests/qtest/esp32s3-i2c-devices-test.c |  40 ++++++
 tests/qtest/esp32s3-spi-devices-test.c |  44 +++++++
 8 files changed, 258 insertions(+)
 create mode 100644 hw/misc/power_domain.c

