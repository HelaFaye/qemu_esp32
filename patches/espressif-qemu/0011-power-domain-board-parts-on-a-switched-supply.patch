@@ -162,6 +162,9 @@ uint32_t ssi_transfer(SSIBus *bus, uint32_t val)
 
     QTAILQ_FOREACH(kid, &b->children, sibling) {
         SSIPeripheral *p = SSI_PERIPHERAL(kid->child);
+        if (p->unpowered) {
+            continue;           /* Drives nothing on MISO, hears nothing */
+        }
         r |= p->spc->transfer_raw(p, val);
     }
 
diff --git a/include/hw/i2c/i2c.h b/include/hw/i2c/i2c.h
index 2a3abac..3c0e6e0 100644
--- a/include/hw/i2c/i2c.h
+++ b/include/hw/i2c/i2c.h
@@ -61,6 +61,9 @@ struct I2CSlave {
 
