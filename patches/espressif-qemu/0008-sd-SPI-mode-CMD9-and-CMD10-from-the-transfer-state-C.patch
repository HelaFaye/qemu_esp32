From beed24db6befad827381a7fed9cc35155ad9353a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 11:18:29 +0000
Subject: [PATCH] sd: SPI mode: CMD9 and CMD10 from the transfer state; CMD13
 answers R2

In SPI mode ACMD41 (and CMD1) leave the card in the transfer state, as
SPI has no CMD2/CMD3 to take it through identification to standby. But
SEND_CSD and SEND_CID only answered from standby, so every SPI host that
reads the CID to mount a card (ESP-IDF's sdspi among them) got an illegal
command (R1 0x04) and then waited for a data block that never came:
sdmmc_init_cid timed out.

And SEND_STATUS answered sd_r2_s in SPI mode, the SD bus's 136-bit R2
(the CSD), where SPI's R2 is the R1 byte and one more status byte.
ssi-sd builds that from the card status, so the card status (sd_r1) is
what it needs; with 16 bytes it refused the response ('Unexpected
response to cmd 13').

The SD qtest now reads the CID, the CSD and the status after ACMD41, as
a host mounting a card does; it fails on the first without this.
---
 hw/sd/sd.c                             | 19 ++++++++++++---
 tests/qtest/esp32s3-spi-devices-test.c | 32 ++++++++++++++++++++++++++
 2 files changed, 48 insertions(+), 3 deletions(-)

diff --git a/hw/sd/sd.c b/hw/sd/sd.c
index f9bd03f..4316a10 100644
--- a/hw/sd/sd.c
+++ b/hw/sd/sd.c
@@ -1577,7 +1577,11 @@ static sd_rsp_type_t emmc_cmd_SEND_EXT_CSD(SDState *sd, SDRequest req)
 /* CMD9 */
 static sd_rsp_type_t spi_cmd_SEND_CSD(SDState *sd, SDRequest req)
 {
-    if (sd->state != sd_standby_state) {
+    /*
+     * SPI mode has no standby state to send this from: ACMD41 (or CMD1)
+     * leaves the card in transfer, and SPI hosts read the CSD there.
+     */
+    if (sd->state != sd_standby_state && sd->state != sd_transfer_state) {
         return sd_invalid_state_for_cmd(sd, req);
     }
     return sd_cmd_to_sendingdata(sd, req, sd_req_get_address(sd, req),
@@ -1596,7 +1600,11 @@ static sd_rsp_type_t sd_cmd_SEND_CSD(SDState *sd, SDRequest req)
 /* CMD10 */
 static sd_rsp_type_t spi_cmd_SEND_CID(SDState *sd, SDRequest req)
 {
-    if (sd->state != sd_standby_state) {
+    /*
+     * SPI mode has no standby state to send this from: ACMD41 (or CMD1)
+     * leaves the card in transfer, and SPI hosts read the CID there.
+     */
+    if (sd->state != sd_standby_state && sd->state != sd_transfer_state) {
         return sd_invalid_state_for_cmd(sd, req);
     }
     return sd_cmd_to_sendingdata(sd, req, sd_req_get_address(sd, req),
@@ -1649,7 +1657,12 @@ static sd_rsp_type_t sd_cmd_SEND_STATUS(SDState *sd, SDRequest req)
     }
 
     if (sd_is_spi(sd)) {
-        return sd_r2_s;
+        /*
+         * SPI's R2 is the R1 byte and a second status byte, which ssi-sd
+         * builds from the card status: so the card status (R1), not
+         * sd_r2_s, the 16-byte CSD of the SD bus's R2.
+         */
+        return sd_r1;
     }
 
     return sd_req_rca_same(sd, req) ? sd_r1 : sd_r0;
diff --git a/tests/qtest/esp32s3-spi-devices-test.c b/tests/qtest/esp32s3-spi-devices-test.c
index 59e3922..5f9c7cc 100644
--- a/tests/qtest/esp32s3-spi-devices-test.c
+++ b/tests/qtest/esp32s3-spi-devices-test.c
@@ -243,6 +243,24 @@ static uint8_t sd_cmd(QTestState *qts, uint8_t cmd, uint32_t arg, uint8_t crc, u
     return 0xFF;
 }
 
+/* A register read by data block (CMD9 CSD, CMD10 CID): R1, the data token, 16 bytes */
+static void sd_read_reg(QTestState *qts, uint8_t cmd, uint8_t *reg)
+{
+    uint8_t buf[16 + 40], tx[40];
+    g_assert_cmphex(sd_cmd(qts, cmd, 0, 0xFF, buf, 16), ==, 0x00);
+    memset(tx, 0xFF, sizeof(tx));
+    xfer(qts, tx, buf + 16, sizeof(tx));
+    int start = -1;
+    for (int i = 0; i < (int)sizeof(buf) - 16; i++) {
+        if (buf[i] == 0xFE) {
+            start = i + 1;
+            break;
+        }
+    }
+    g_assert_cmpint(start, >=, 0);
+    memcpy(reg, buf + start, 16);
+}
+
 static void test_sd(void)
 {
     g_autofree char *img = g_strdup_printf("%s/qtest-sd-%d.img", g_get_tmp_dir(), getpid());
@@ -275,6 +293,20 @@ static void test_sd(void)
     }
     g_assert_cmphex(r1, ==, 0x00);
 
+    /*
+     * What an SPI host reads next, as ESP-IDF's sdspi does to mount a card:
+     * the CID and the CSD (from the transfer state ACMD41 leaves the card
+     * in; SPI has no standby), and the status, as R2 (R1 and one byte).
+     */
+    uint8_t cid[16], csd[16], st[1];
+    sd_read_reg(qts, 10, cid);                                              /* SEND_CID */
+    g_assert_cmphex(cid[0], ==, 0xAA);
+    g_assert(memcmp(cid + 3, "QEMU!", 5) == 0);
+    sd_read_reg(qts, 9, csd);                                               /* SEND_CSD */
+    g_assert_cmphex(csd[0] >> 6, <=, 1);    /* CSD structure 1.0 or 2.0 */
+    g_assert_cmphex(sd_cmd(qts, 13, 0, 0xFF, st, 1), ==, 0x00);            /* SEND_STATUS */
+    g_assert_cmphex(st[0], ==, 0x00);
+
     /* READ_SINGLE_BLOCK 1 (a byte address on a standard capacity card): R1, then the data
      * token and the block, possibly starting in the command's own transfer */
     uint8_t blk[700], tx[600];
-- 
2.43.0

