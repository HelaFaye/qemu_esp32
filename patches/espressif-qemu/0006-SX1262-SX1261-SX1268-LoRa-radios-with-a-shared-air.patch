diff --git a/tests/qtest/esp32s3-sx1262-test.c b/tests/qtest/esp32s3-sx1262-test.c
new file mode 100644
index 0000000..ea96230
--- /dev/null
+++ b/tests/qtest/esp32s3-sx1262-test.c
@@ -0,0 +1,203 @@
+/*
+ * QTest for the SX1262 LoRa radio on the ESP32-S3's GP-SPI2, wired as
+ * meshcore-bare-esp32s3 wires it (NSS GPIO7, BUSY GPIO15, DIO1 GPIO16, NRESET GPIO8),
+ * with two QEMUs sharing the air over a socket: one sends, the other receives, after
+ * LoRa's time on air.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "libqtest.h"
+
+#define SPI2            0x60024000
+#define SPI_CMD         (SPI2 + 0x00)
+#define SPI_CLOCK       (SPI2 + 0x0C)
+#define SPI_USER        (SPI2 + 0x10)
+#define SPI_MS_DLEN     (SPI2 + 0x1C)
+#define SPI_MISC        (SPI2 + 0x20)
+#define SPI_INT_CLR     (SPI2 + 0x38)
+#define SPI_W0          (SPI2 + 0x98)
+#define SPI_CLK_GATE    (SPI2 + 0xE8)
+
+#define GPIO            0x60004000
+#define OUT_W1TS        (GPIO + 0x08)
+#define OUT_W1TC        (GPIO + 0x0C)
+#define ENABLE_W1TS     (GPIO + 0x24)
+#define IN              (GPIO + 0x3C)
+
+#define PIN_NSS         7
+#define PIN_RESET       8
+#define PIN_BUSY        15
+#define PIN_DIO1        16
+
+#define WIRING \
+    "-device sx1262,bus=spi2,id=lora,chardev=air " \
+    "-device esp32s3.pin-link,pin=7,dev=lora,line=ssi-gpio-cs,pull=up " \
+    "-device esp32s3.pin-link,pin=8,dev=lora,line=reset,pull=up " \
+    "-device esp32s3.pin-link,pin=15,dev=lora,line=busy,dir=out " \
+    "-device esp32s3.pin-link,pin=16,dev=lora,line=dio1,dir=out "
+
+static QTestState *node(const char *sock, bool server)
+{
+    g_autofree char *args = g_strdup_printf("-machine esp32s3 -chardev socket,id=air,path=%s%s " WIRING,
+                                            sock, server ? ",server=on,wait=off" : "");
+    QTestState *qts = qtest_init(args);
+    qtest_writel(qts, SPI_CLK_GATE, 0x7);
+    qtest_writel(qts, SPI_CLOCK, (7 << 12) | (3 << 6) | 7);   /* 10 MHz */
+    qtest_writel(qts, SPI_MISC, 0x3F);
+    qtest_writel(qts, SPI_USER, BIT(0) | BIT(27) | BIT(28));
+    qtest_writel(qts, OUT_W1TS, BIT(PIN_NSS) | BIT(PIN_RESET));
+    qtest_writel(qts, ENABLE_W1TS, BIT(PIN_NSS) | BIT(PIN_RESET));
+    return qts;
+}
+
+static bool pin(QTestState *qts, int n)
+{
+    return qtest_readl(qts, IN) & BIT(n);
+}
+
+static void wait_not_busy(QTestState *qts)
+{
+    for (int i = 0; i < 100 && pin(qts, PIN_BUSY); i++) {
+        qtest_clock_step(qts, 100 * 1000);
+    }
+    g_assert_false(pin(qts, PIN_BUSY));
+}
+
+/* One command: NSS low, the bytes, NSS high (when the chip runs it) */
+static void cmd(QTestState *qts, const uint8_t *tx, uint8_t *rx, size_t n)
+{
+    wait_not_busy(qts);
+    qtest_writel(qts, OUT_W1TC, BIT(PIN_NSS));
+    uint32_t w[16] = { 0 };
+    g_assert(n <= 64);
+    memcpy(w, tx, n);
+    for (int i = 0; i < 16; i++) {
+        qtest_writel(qts, SPI_W0 + 4 * i, w[i]);
+    }
+    qtest_writel(qts, SPI_MS_DLEN, n * 8 - 1);
+    qtest_writel(qts, SPI_INT_CLR, BIT(12));
+    qtest_writel(qts, SPI_CMD, BIT(24));
+    qtest_clock_step(qts, 20000);
+    for (int i = 0; i < 16; i++) {
+        w[i] = qtest_readl(qts, SPI_W0 + 4 * i);
+    }
+    if (rx) {
+        memcpy(rx, w, n);
+    }
+    qtest_writel(qts, OUT_W1TS, BIT(PIN_NSS));
+}
+
+#define CMD(qts, ...) do { const uint8_t _c[] = { __VA_ARGS__ }; cmd(qts, _c, NULL, sizeof(_c)); } while (0)
+
+/* RadioLib's begin() for a MeshCore-like profile: LoRa, SF7, BW125, CR 4/5, sync 0x12 */
+static void setup(QTestState *qts, uint8_t sf)
+{
+    qtest_writel(qts, OUT_W1TC, BIT(PIN_RESET));
+    qtest_clock_step(qts, 1000 * 1000);
+    qtest_writel(qts, OUT_W1TS, BIT(PIN_RESET));
+    g_assert_true(pin(qts, PIN_BUSY));                  /* Cold start */
+    wait_not_busy(qts);
+
+    uint8_t tx[20] = { 0x1D, 0x03, 0x20, 0x00 }, rx[20];
+    cmd(qts, tx, rx, 20);
+    g_assert_cmpmem(rx + 4, 15, "SX1261 V2D 2D02", 15);
+
+    CMD(qts, 0x80, 0x00);                               /* Standby RC */
+    CMD(qts, 0x96, 0x01);                               /* DC-DC */
+    CMD(qts, 0x97, 0x01, 0x00, 0x01, 0x40);             /* DIO3 TCXO 1.8 V */
+    CMD(qts, 0x89, 0x7F);                               /* Calibrate all: 3.5 ms busy */
+    g_assert_true(pin(qts, PIN_BUSY));
+    CMD(qts, 0x9D, 0x01);                               /* DIO2 as RF switch */
+    CMD(qts, 0x8A, 0x01);                               /* LoRa */
+    /* 869.525 MHz: f * 2^25 / 32 MHz */
+    uint32_t frf = (uint32_t)(869525000ull * (1 << 25) / 32000000);
+    CMD(qts, 0x86, frf >> 24, frf >> 16, frf >> 8, frf);
+    CMD(qts, 0x8B, sf, 0x04, 0x01, 0x00);               /* SF, BW125, CR4/5, LDRO off */
+    CMD(qts, 0x0D, 0x07, 0x40, 0x14, 0x24);             /* Sync word 0x12 */
+    CMD(qts, 0x8C, 0x00, 0x08, 0x00, 10, 0x01, 0x00);   /* Preamble 8, explicit, 10 bytes, CRC */
+    CMD(qts, 0x8F, 0x00, 0x80);                         /* TX base 0, RX base 128 */
+    CMD(qts, 0x08, 0x03, 0xFF, 0x03, 0xFF, 0, 0, 0, 0); /* All IRQs on DIO1 */
+}
+
+static uint16_t irq_status(QTestState *qts)
+{
+    uint8_t tx[4] = { 0x12 }, rx[4];
+    cmd(qts, tx, rx, 4);
+    return rx[2] << 8 | rx[3];
+}
+
+static void test_link(void)
+{
+    g_autofree char *sock = g_strdup_printf("%s/qtest-air-%d.sock", g_get_tmp_dir(), getpid());
+    QTestState *a = node(sock, true);
+    QTestState *b = node(sock, false);
+    setup(a, 7);
+    setup(b, 7);
+
+    /* B listens, continuously */
+    CMD(b, 0x82, 0xFF, 0xFF, 0xFF);
+    g_assert_cmphex(irq_status(b), ==, 0);
+
+    /* A sends "hello mesh" */
+    CMD(a, 0x0E, 0x00, 'h', 'e', 'l', 'l', 'o', ' ', 'm', 'e', 's', 's');
+    CMD(a, 0x83, 0x00, 0x00, 0x00);
+    /* SF7/BW125, 8 symbols of preamble, 10 bytes, CRC, CR 4/5: 41.2 ms on the air */
+    qtest_clock_step(a, 40 * 1000 * 1000);
+    g_assert_false(pin(a, PIN_DIO1));
+    g_assert_cmphex(irq_status(a) & BIT(0), ==, 0);
+    qtest_clock_step(a, 2 * 1000 * 1000);
+    g_assert_true(pin(a, PIN_DIO1));
+    g_assert_cmphex(irq_status(a) & BIT(0), ==, BIT(0));      /* TX_DONE */
+
+    /* B: the packet arrives over the socket, ends after its airtime on B's clock */
+    for (int i = 0; i < 50 && !pin(b, PIN_DIO1); i++) {
+        g_usleep(10000);
+        qtest_clock_step(b, 5 * 1000 * 1000);
+    }
+    g_assert_true(pin(b, PIN_DIO1));
+    uint16_t irq = irq_status(b);
+    g_assert_cmphex(irq & (BIT(1) | BIT(4) | BIT(6)), ==, BIT(1) | BIT(4));  /* RX_DONE, HEADER_VALID */
+    uint8_t tx[16] = { 0x13 }, rx[16];
+    cmd(b, tx, rx, 4);
+    g_assert_cmpint(rx[2], ==, 10);                             /* Length */
+    g_assert_cmpint(rx[3], ==, 128);                            /* Where */
+    uint8_t rd[16] = { 0x1E, 128, 0x00 };
+    cmd(b, rd, rx, 13);
+    g_assert_cmpmem(rx + 3, 10, "hello mess", 10);
+    uint8_t ps[5] = { 0x14 };
+    cmd(b, ps, rx, 5);
+    g_assert_cmpint(-rx[2] / 2, ==, -60);                       /* RSSI */
+
+    /* Clear, then a mismatched receiver (SF8) hears nothing */
+    CMD(b, 0x02, 0x03, 0xFF);
+    g_assert_false(pin(b, PIN_DIO1));
+    CMD(b, 0x8B, 8, 0x04, 0x01, 0x00);
+    CMD(b, 0x82, 0xFF, 0xFF, 0xFF);
+    CMD(a, 0x83, 0x00, 0x00, 0x00);
+    for (int i = 0; i < 20; i++) {
+        g_usleep(5000);
+        qtest_clock_step(b, 5 * 1000 * 1000);
+    }
+    g_assert_false(pin(b, PIN_DIO1));
+
+    /* An RX timeout: 0x000280 * 15.625 us = 10 ms */
+    CMD(b, 0x82, 0x00, 0x02, 0x80);
+    qtest_clock_step(b, 11 * 1000 * 1000);
+    g_assert_cmphex(irq_status(b) & BIT(9), ==, BIT(9));
+
+    qtest_quit(b);
+    qtest_quit(a);
+    unlink(sock);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/sx1262/link", test_link);
+    return g_test_run();
