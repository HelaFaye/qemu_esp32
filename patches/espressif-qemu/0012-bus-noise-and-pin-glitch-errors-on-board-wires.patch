diff --git a/hw/misc/bus_noise.c b/hw/misc/bus_noise.c
new file mode 100644
index 0000000..70125e4
--- /dev/null
+++ b/hw/misc/bus_noise.c
@@ -0,0 +1,140 @@
+/*
+ * Bus noise: errors on the wires of board parts, so drivers' error paths run.
+ *
+ *   -device bus-noise,id=n0,devices=touch:exp,ber=1e-4,nack=0.01,burst=1,seed=7
+ *   qom-set /machine/peripheral/n0 ber 1e-3        (at run time; 0 turns it off)
+ *   qom-get /machine/peripheral/n0 flips           (errors injected so far)
+ *
+ * SPI parts: each bit to the part (MOSI) and from it (MISO) flips with probability ber,
+ * while it's selected. I2C parts: each bit written to it and read from it likewise, and
+ * each time it's addressed, its ACK is lost with probability nack (the host sees a
+ * NACK). burst: bits flipped per error, consecutive (a noise burst). seed: the same
+ * seed, the same errors at the same transfers.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qom/object.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "hw/i2c/i2c.h"
+#include "hw/misc/bus_noise.h"
+
+#define TYPE_BUS_NOISE "bus-noise"
+OBJECT_DECLARE_SIMPLE_TYPE(BusNoiseState, BUS_NOISE)
+
+struct BusNoiseState {
+    DeviceState parent_obj;
+    char *devices;
+    uint32_t seed;
+    BusNoise noise;
+};
+
+static char *get_rate(double v)
+{
+    return g_strdup_printf("%g", v);
+}
+
+static bool parse_rate(const char *str, double *out, Error **errp)
+{
+    char *end;
+    double v = g_ascii_strtod(str, &end);
+    if (end == str || *end || v < 0 || v > 1) {
+        error_setg(errp, "bus-noise: a probability from 0 to 1, not '%s'", str);
+        return false;
+    }
+    *out = v;
+    return true;
+}
+
+static char *get_ber(Object *obj, Error **errp)
+{
+    return get_rate(BUS_NOISE(obj)->noise.ber);
+}
+
+static void set_ber(Object *obj, const char *str, Error **errp)
+{
+    parse_rate(str, &BUS_NOISE(obj)->noise.ber, errp);
+}
+
+static char *get_nack(Object *obj, Error **errp)
+{
+    return get_rate(BUS_NOISE(obj)->noise.nack);
+}
+
+static void set_nack(Object *obj, const char *str, Error **errp)
+{
+    parse_rate(str, &BUS_NOISE(obj)->noise.nack, errp);
+}
+
+static void bus_noise_realize(DeviceState *dev, Error **errp)
+{
+    BusNoiseState *s = BUS_NOISE(dev);
+    g_auto(GStrv) ids = g_strsplit(s->devices ? s->devices : "", ":", -1);
+
+    s->noise.rng = g_rand_new_with_seed(s->seed);
+    for (int i = 0; ids[i]; i++) {
+        if (!*ids[i]) {
+            continue;
+        }
+        g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", ids[i]);
+        Object *o = object_resolve_path(path, NULL);
+        SSIPeripheral *ssi = o ? (SSIPeripheral *)object_dynamic_cast(o, TYPE_SSI_PERIPHERAL) : NULL;
+        I2CSlave *i2c = o ? (I2CSlave *)object_dynamic_cast(o, TYPE_I2C_SLAVE) : NULL;
+        if (ssi) {
+            ssi->noise = &s->noise;
+        } else if (i2c) {
+            i2c->noise = &s->noise;
+        } else {
+            error_setg(errp, "bus-noise: '%s' isn't an SPI or I2C part with that id", ids[i]);
+            return;
+        }
+    }
+}
+
+static void bus_noise_init(Object *obj)
+{
+    BusNoiseState *s = BUS_NOISE(obj);
+
+    object_property_add_str(obj, "ber", get_ber, set_ber);
+    object_property_add_str(obj, "nack", get_nack, set_nack);
+    object_property_add_uint64_ptr(obj, "flips", &s->noise.flips, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "nacks", &s->noise.nacks, OBJ_PROP_FLAG_READ);
+}
+
+static Property bus_noise_properties[] = {
+    DEFINE_PROP_STRING("devices", BusNoiseState, devices),
+    DEFINE_PROP_UINT32("burst", BusNoiseState, noise.burst, 1),
+    DEFINE_PROP_UINT32("seed", BusNoiseState, seed, 1),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void bus_noise_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = bus_noise_realize;
+    dc->user_creatable = true;
+    dc->desc = "Bit errors and lost ACKs on board parts' wires";
+    device_class_set_props(dc, bus_noise_properties);
+}
+
+static const TypeInfo bus_noise_info = {
+    .name = TYPE_BUS_NOISE,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(BusNoiseState),
+    .instance_init = bus_noise_init,
+    .class_init = bus_noise_class_init,
+};
+
+static void bus_noise_register_types(void)
+{
+    type_register_static(&bus_noise_info);
+}
+
+type_init(bus_noise_register_types)
