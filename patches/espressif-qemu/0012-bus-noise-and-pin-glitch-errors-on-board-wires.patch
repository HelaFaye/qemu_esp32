diff --git a/include/hw/misc/bus_noise.h b/include/hw/misc/bus_noise.h
new file mode 100644
index 0000000..d035dda
--- /dev/null
+++ b/include/hw/misc/bus_noise.h
@@ -0,0 +1,48 @@
+/*
+ * Bus noise: errors on a board part's wires (bit flips on SPI and I2C transfers, I2C
+ * NACKs), set by a bus-noise device (hw/misc/bus_noise.c) and applied by the SSI and
+ * I2C cores to the parts it names.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#ifndef HW_MISC_BUS_NOISE_H
+#define HW_MISC_BUS_NOISE_H
+
+typedef struct BusNoise {
+    double ber;             /* Per bit, each direction */
+    double nack;            /* Per I2C address phase */
+    uint32_t burst;         /* Bits flipped per error (consecutive) */
+    GRand *rng;
+    uint64_t flips;         /* Errors injected (events, not bits) */
+    uint64_t nacks;
+} BusNoise;
+
+/* bits of val (LSB first) through the noise */
+static inline uint32_t bus_noise_bits(BusNoise *n, uint32_t val, int bits)
+{
+    if (!n || n->ber <= 0) {
+        return val;
+    }
+    for (int i = 0; i < bits; i++) {
+        if (g_rand_double(n->rng) < n->ber) {
+            for (uint32_t k = 0; k < MAX(n->burst, 1) && i < bits; k++, i++) {
+                val ^= 1u << i;
+            }
+            n->flips++;
+        }
+    }
+    return val;
+}
+
+static inline bool bus_noise_nack(BusNoise *n)
+{
+    if (n && n->nack > 0 && g_rand_double(n->rng) < n->nack) {
+        n->nacks++;
+        return true;
+    }
+    return false;
+}
+
+#endif
diff --git a/include/hw/ssi/ssi.h b/include/hw/ssi/ssi.h
index 4fce064..b902983 100644
--- a/include/hw/ssi/ssi.h
+++ b/include/hw/ssi/ssi.h
@@ -70,6 +70,9 @@ struct SSIPeripheral {
 
     /* Its supply is off (a power-domain): it takes no part in transfers */
     bool unpowered;
+
+    /* Errors on its wires (a bus-noise), or NULL */
+    struct BusNoise *noise;
 };
 
 extern const VMStateDescription vmstate_ssi_peripheral;
diff --git a/tests/qtest/esp32s3-i2c-devices-test.c b/tests/qtest/esp32s3-i2c-devices-test.c
index f298270..7d839be 100644
--- a/tests/qtest/esp32s3-i2c-devices-test.c
+++ b/tests/qtest/esp32s3-i2c-devices-test.c
@@ -277,6 +277,73 @@ static void test_power_domain_pin(void)
     qtest_quit(qts);
 }
 
+static uint64_t qom_get_u64(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *r = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': {'path': %s, 'property': %s}}",
+                         path, prop);
+    uint64_t v = qdict_get_int(r, "return");
+    qobject_unref(r);
+    return v;
+}
+
+/* Noise on a part's wires: lost ACKs, then bit errors at a rate; off again, all clean */
+static void test_bus_noise(void)
+{
+    QTestState *qts = board("-device mcp23017,bus=i2c0,address=0x20,id=exp "
+                            "-device bus-noise,id=noise,devices=exp,nack=1");
+    uint8_t r[1];
+    g_assert_false(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));
+    g_assert_cmpint(qom_get_u64(qts, "/machine/peripheral/noise", "nacks"), ==, 1);
+    qom_set(qts, "/machine/peripheral/noise", "nack", "\"0\"");
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));
+    g_assert_cmphex(r[0], ==, 0xFF);                                   /* IODIRA */
+
+    qom_set(qts, "/machine/peripheral/noise", "ber", "\"0.02\"");
+    int wrong = 0;
+    for (int i = 0; i < 100; i++) {
+        i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1);
+        wrong += r[0] != 0xFF;
+    }
+    /* 16 bits a read at 2%: about 27 of 100 reads hit */
+    g_assert_cmpint(wrong, >, 5);
+    g_assert_cmpint(wrong, <, 60);
+    g_assert_cmpint(qom_get_u64(qts, "/machine/peripheral/noise", "flips"), >=, wrong);
+
+    qom_set(qts, "/machine/peripheral/noise", "ber", "\"0\"");
+    for (int i = 0; i < 20; i++) {
+        g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x00 }, 1, r, 1));
+        g_assert_cmphex(r[0], ==, 0xFF);
+    }
+    qtest_quit(qts);
+}
+
+/* Glitches on an input with a pull-up: each is a falling edge, an interrupt */
+static void test_pin_glitch(void)
+{
+    QTestState *qts = board("-device pin-glitch,id=g,width-us=2 "
+                            "-device esp32s3.pin-link,pin=16,dev=g,line=out,dir=out,open-drain=on,pull=up");
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(16), ==, BIT(16));
+    qtest_writel(qts, PIN(16), (2 << 7) | BIT(13));                  /* Falling edge, to the CPU */
+    qtest_writel(qts, STATUS_W1TC, BIT(16));
+
+    qom_set(qts, "/machine/peripheral/g", "pulse", "true");
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(16), ==, 0);          /* Low now */
+    qtest_clock_step(qts, 3000);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(16), ==, BIT(16));    /* Released */
+    g_assert_cmphex(qtest_readl(qts, STATUS) & BIT(16), ==, BIT(16));
+    qtest_writel(qts, STATUS_W1TC, BIT(16));
+
