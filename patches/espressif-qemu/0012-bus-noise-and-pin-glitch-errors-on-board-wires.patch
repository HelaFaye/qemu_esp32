 #include "hw/qdev-properties.h"
 #include "hw/ssi/ssi.h"
 #include "migration/vmstate.h"
@@ -165,6 +166,17 @@ uint32_t ssi_transfer(SSIBus *bus, uint32_t val)
         if (p->unpowered) {
             continue;           /* Drives nothing on MISO, hears nothing */
         }
+        if (p->noise) {
+            SSIPeripheralClass *ssc = p->spc;
+            bool selected = ssc->transfer_raw != ssi_transfer_raw_default ||
+                            ssc->cs_polarity == SSI_CS_NONE ||
+                            (p->cs == (ssc->cs_polarity == SSI_CS_HIGH));
+            if (selected) {
+                /* Errors on MOSI going in, on MISO coming out (a byte a word) */
