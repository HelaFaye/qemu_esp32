diff --git a/hw/misc/pin_glitch.c b/hw/misc/pin_glitch.c
new file mode 100644
index 0000000..3f989e1
--- /dev/null
+++ b/hw/misc/pin_glitch.c
@@ -0,0 +1,153 @@
+/*
+ * Glitches on a pin: short pulses that pull an input low, as noise on a long wire, a
+ * bouncing contact or ESD would, to exercise spurious edge interrupts and wrong reads.
+ *
+ *   -device pin-glitch,id=g0,rate=5,width-us=2,seed=3
+ *   -device esp32s3.pin-link,pin=16,dev=g0,line=out,dir=out,open-drain=on,pull=up
+ *   qom-set /machine/peripheral/g0 rate 50          (pulses a second, at random; 0: none)
+ *   qom-set /machine/peripheral/g0 pulse true       (one, now)
+ *   qom-get /machine/peripheral/g0 count
+ *
+ * Wired open-drain, a pulse pulls the line low over whatever else drives it (a pull-up,
+ * a button, a part's INT) and lets it go after width-us.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "hw/irq.h"
+
+#define TYPE_PIN_GLITCH "pin-glitch"
+OBJECT_DECLARE_SIMPLE_TYPE(PinGlitchState, PIN_GLITCH)
+
+struct PinGlitchState {
+    DeviceState parent_obj;
+    qemu_irq out;
+    QEMUTimer *next;
+    QEMUTimer *release;
+    GRand *rng;
+    double rate;
+    uint32_t width_us;
+    uint32_t seed;
+    uint64_t count;
+};
+
+static void schedule(PinGlitchState *s)
+{
+    timer_del(s->next);
+    if (s->rate > 0) {
+        /* Poisson arrivals: exponential gaps */
+        double gap = -log(1.0 - g_rand_double(s->rng)) / s->rate;
+        timer_mod(s->next, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + (int64_t)(gap * 1e9));
+    }
+}
+
+static void pulse(PinGlitchState *s)
+{
+    qemu_set_irq(s->out, 0);
+    s->count++;
+    timer_mod(s->release, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + (int64_t)s->width_us * 1000);
+}
+
+static void on_next(void *opaque)
+{
+    PinGlitchState *s = opaque;
+    pulse(s);
+    schedule(s);
+}
+
+static void on_release(void *opaque)
+{
+    qemu_set_irq(((PinGlitchState *)opaque)->out, 1);
+}
+
+static char *get_rate(Object *obj, Error **errp)
+{
+    return g_strdup_printf("%g", PIN_GLITCH(obj)->rate);
+}
+
+static void set_rate(Object *obj, const char *str, Error **errp)
+{
+    PinGlitchState *s = PIN_GLITCH(obj);
+    char *end;
+    double v = g_ascii_strtod(str, &end);
+    if (end == str || *end || v < 0) {
+        error_setg(errp, "pin-glitch: pulses a second (0 or more), not '%s'", str);
+        return;
+    }
+    s->rate = v;
+    if (DEVICE(s)->realized) {
+        schedule(s);
+    }
+}
+
+static bool get_pulse(Object *obj, Error **errp)
+{
+    return false;
+}
+
+static void set_pulse(Object *obj, bool v, Error **errp)
+{
+    if (v) {
+        pulse(PIN_GLITCH(obj));
+    }
+}
+
+static void pin_glitch_realize(DeviceState *dev, Error **errp)
+{
+    PinGlitchState *s = PIN_GLITCH(dev);
+    s->rng = g_rand_new_with_seed(s->seed);
+    qemu_set_irq(s->out, 1);                /* Released */
+    schedule(s);
+}
+
+static void pin_glitch_init(Object *obj)
+{
+    PinGlitchState *s = PIN_GLITCH(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->out, "out", 1);
+    s->next = timer_new_ns(QEMU_CLOCK_VIRTUAL, on_next, s);
+    s->release = timer_new_ns(QEMU_CLOCK_VIRTUAL, on_release, s);
+    object_property_add_str(obj, "rate", get_rate, set_rate);
+    object_property_add_bool(obj, "pulse", get_pulse, set_pulse);
+    object_property_add_uint64_ptr(obj, "count", &s->count, OBJ_PROP_FLAG_READ);
+}
+
+static Property pin_glitch_properties[] = {
+    DEFINE_PROP_UINT32("width-us", PinGlitchState, width_us, 1),
+    DEFINE_PROP_UINT32("seed", PinGlitchState, seed, 1),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void pin_glitch_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = pin_glitch_realize;
+    dc->user_creatable = true;
+    dc->desc = "Short pulses pulling a pin low (noise, bounce)";
+    device_class_set_props(dc, pin_glitch_properties);
+}
+
+static const TypeInfo pin_glitch_info = {
+    .name = TYPE_PIN_GLITCH,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(PinGlitchState),
+    .instance_init = pin_glitch_init,
+    .class_init = pin_glitch_class_init,
+};
+
+static void pin_glitch_register_types(void)
+{
+    type_register_static(&pin_glitch_info);
+}
+
+type_init(pin_glitch_register_types)
