index 0bcb7eb..0c56efe 100644
--- a/hw/misc/meson.build
+++ b/hw/misc/meson.build
@@ -355,3 +355,4 @@ system_ss.add(when: 'CONFIG_SBSA_REF', if_true: files('sbsa_ec.c'))
 system_ss.add(when: 'CONFIG_LASI', if_true: files('lasi.c'))
 system_ss.add(when: 'CONFIG_SX126X', if_true: files('sx126x.c'))
 system_ss.add(when: 'CONFIG_XTENSA_ESP32S3', if_true: files('power_domain.c', 'bus_noise.c', 'pin_glitch.c'))
+system_ss.add(when: 'CONFIG_ESP_BOARD_PERIPHERALS', if_true: files('icm45686.c'))
diff --git a/tests/qtest/esp32s3-i2c-devices-test.c b/tests/qtest/esp32s3-i2c-devices-test.c
index e0ae347..258f304 100644
--- a/tests/qtest/esp32s3-i2c-devices-test.c
+++ b/tests/qtest/esp32s3-i2c-devices-test.c
@@ -372,6 +372,104 @@ static void test_buttons_and_encoder(void)
     qtest_quit(qts);
 }
 
+/* The ICM-45686, as SlimeVR's softfusion driver sets it up and reads it */
+static void imu_frame(QTestState *qts, uint8_t f[20])
+{
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x14 }, 1, f, 20));          /* FIFO_DATA */
+}
+
+static int16_t le16(const uint8_t *p)
+{
+    return (int16_t)(p[0] | p[1] << 8);
+}
+
+static unsigned imu_count(QTestState *qts)
+{
+    uint8_t r[2];
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x12 }, 1, r, 2));
+    return r[0] | r[1] << 8;
+}
+
+static void imu_flush(QTestState *qts)
+{
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x1D, 0x00 }, 2, NULL, 0));      /* Bypass */
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x1D, 0x5F }, 2, NULL, 0));      /* Stream */
+}
+
+/* The next frame with a new accel sample (every second one) */
+static void imu_accel_frame(QTestState *qts, uint8_t f[20])
+{
+    for (int i = 0; i < 3; i++) {
+        imu_frame(qts, f);
+        if (f[0] & 0x40) {
+            return;
+        }
+    }
+    g_assert_not_reached();
+}
+
+static void test_imu(void)
+{
+    QTestState *qts = board("-device icm45686,bus=i2c0,address=0x68,id=imu");
+    uint8_t r[20];
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x72 }, 1, r, 1));           /* WHO_AM_I */
+    g_assert_cmphex(r[0], ==, 0xE9);
+    g_assert_false(i2c_xfer(qts, 0x69, (uint8_t[]){ 0x72 }, 1, r, 1));          /* Not at 0x69 */
+
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x7F, 0x03 }, 2, NULL, 0));      /* Reset */
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x1C, 0x08 }, 2, NULL, 0));      /* Gyro */
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x1B, 0x09 }, 2, NULL, 0));      /* Accel */
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x1D, 0x5F }, 2, NULL, 0));      /* Stream */
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x21, 0x0F }, 2, NULL, 0));      /* FIFO on */
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x10, 0x0F }, 2, NULL, 0));      /* Sensors on */
+    g_assert_true(i2c_xfer(qts, 0x68, (uint8_t[]){ 0x1B }, 1, r, 1));
+    g_assert_cmphex(r[0], ==, 0x09);
+
+    /* 204.8 frames a second: about 20 in 100 ms */
+    imu_count(qts);
+    qtest_clock_step(qts, 100 * 1000 * 1000);
+    unsigned n = imu_count(qts);
+    g_assert_cmpuint(n, >=, 18);
+    g_assert_cmpuint(n, <=, 23);
+
+    /* Flat and still: +1 g on Z (16384 LSB/g in the top 16 of 20 bits), no rotation */
+    imu_accel_frame(qts, r);
+    g_assert_cmphex(r[0] & 0x60, ==, 0x60);
+    g_assert_cmpint(le16(r + 1), ==, 0);
+    g_assert_cmpint(le16(r + 3), ==, 0);
+    g_assert_cmpint(le16(r + 5), ==, 16384);
+    g_assert_cmpint(le16(r + 11), ==, 0);
+    g_assert_cmpint(le16(r + 13), ==, 0);                                       /* 25 C */
+
+    /* 90 degrees a second about Z: 90 * 131.072 LSB/dps in the gyro's top 16 bits */
+    qom_set(qts, "/machine/peripheral/imu", "gyro-z", "90000");
+    imu_flush(qts);
+    qtest_clock_step(qts, 20 * 1000 * 1000);
+    imu_frame(qts, r);
+    g_assert_cmpint(abs(le16(r + 11) - 11796), <=, 1);
+
+    /* 90 degrees about X, over a second: gravity moves from Z to Y */
