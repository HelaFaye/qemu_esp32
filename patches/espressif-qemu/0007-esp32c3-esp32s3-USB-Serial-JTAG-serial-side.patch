--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -794,7 +794,11 @@ static void esp32s3_machine_init(MachineState *machine)
 
     /* USB Serial JTAG realization */
     {
