diff --git a/include/hw/misc/esp32c3_jtag.h b/include/hw/misc/esp32c3_jtag.h
index 8ac6ebb..d37cd49 100644
--- a/include/hw/misc/esp32c3_jtag.h
+++ b/include/hw/misc/esp32c3_jtag.h
@@ -1,5 +1,11 @@
 /*
- * ESP32-C3 USB Serial JTAG emulation
+ * ESP32-C3 / ESP32-S3 USB Serial/JTAG: the CDC-ACM serial side
+ *
+ * The USB host is a chardev ("chardev" property; the machines give it the -serial after
+ * their UARTs: the 4th on the S3, the 3rd on the C3). With a host attached the
+ * controller sees start-of-frame packets every millisecond, as when plugged into a
+ * computer, and what the firmware writes to endpoint 1 goes out; without one, the
+ * IN FIFO fills and stays full, as on a board with no USB cable.
  *
  * Copyright (c) 2023 Espressif Systems (Shanghai) Co. Ltd.
  *
@@ -12,15 +18,26 @@
 #include "hw/hw.h"
 #include "hw/sysbus.h"
 #include "hw/registerfields.h"
+#include "chardev/char-fe.h"
 
 #define TYPE_ESP32C3_JTAG "misc.esp32c3.usb_serial_jtag"
 #define ESP32C3_JTAG(obj) OBJECT_CHECK(ESP32C3UsbJtagState, (obj), TYPE_ESP32C3_JTAG)
 
 #define ESP32C3_JTAG_REGS_SIZE (0x84)
-
+#define ESP32C3_JTAG_EP1_SIZE  64
 
 typedef struct ESP32C3UsbJtagState {
     SysBusDevice parent_object;
     MemoryRegion iomem;
-} ESP32C3UsbJtagState;
+    CharBackend chr;
+    qemu_irq irq;
+    QEMUTimer *sof_timer;
 
+    uint8_t in_fifo[ESP32C3_JTAG_EP1_SIZE];     /* To the host */
+    uint32_t in_len;
+    uint8_t out_fifo[ESP32C3_JTAG_EP1_SIZE];    /* From the host */
+    uint32_t out_head, out_len;
+    uint32_t int_raw, int_ena;
+    uint32_t conf0, misc_conf, mem_conf, test;
+    uint32_t frame;
+} ESP32C3UsbJtagState;
diff --git a/tests/qtest/esp32s3-usb-serial-jtag-test.c b/tests/qtest/esp32s3-usb-serial-jtag-test.c
new file mode 100644
index 0000000..2c2a8ec
--- /dev/null
+++ b/tests/qtest/esp32s3-usb-serial-jtag-test.c
@@ -0,0 +1,114 @@
+/*
+ * QTest for the ESP32-S3 USB Serial/JTAG's serial side: with a host (the 4th -serial)
+ * frames come every millisecond and endpoint 1 carries bytes both ways; without one
+ * the IN FIFO fills and stays full.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/sockets.h"
+#include "libqtest.h"
+#include <sys/un.h>
+
+#define USJ             0x60038000
+#define EP1             (USJ + 0x00)
+#define EP1_CONF        (USJ + 0x04)
+#define INT_RAW         (USJ + 0x08)
+#define INT_ENA         (USJ + 0x10)
+#define INT_CLR         (USJ + 0x14)
+#define FRAM_NUM        (USJ + 0x24)
+
+#define WR_DONE         BIT(0)
+#define IN_FREE         BIT(1)
+#define OUT_AVAIL       BIT(2)
+#define INT_SOF         BIT(1)
+#define INT_OUT_RECV    BIT(2)
+#define INT_IN_EMPTY    BIT(3)
+
+#define INTMATRIX_STATUS3   0x600C2198      /* Sources 96-127 */
+#define USJ_SOURCE          96
+
+static int host_connect(const char *path)
+{
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    struct sockaddr_un a = { .sun_family = AF_UNIX };
+    g_strlcpy(a.sun_path, path, sizeof(a.sun_path));
+    g_assert_cmpint(connect(fd, (struct sockaddr *)&a, sizeof(a)), ==, 0);
+    return fd;
+}
+
+static void test_with_host(void)
+{
+    g_autofree char *sock = g_strdup_printf("%s/qtest-usj-%d.sock", g_get_tmp_dir(), getpid());
+    g_autofree char *args = g_strdup_printf("-machine esp32s3 -chardev socket,id=usj,path=%s,server=on,wait=off "
+                                            "-serial null -serial null -serial null -serial chardev:usj", sock);
+    QTestState *qts = qtest_init(args);
+    int host = host_connect(sock);
+
+    /* Frames: every millisecond */
+    uint32_t f0 = qtest_readl(qts, FRAM_NUM);
+    qtest_writel(qts, INT_CLR, ~0u);
+    qtest_clock_step(qts, 3 * 1000 * 1000 + 1000);
+    g_assert_cmpint((qtest_readl(qts, FRAM_NUM) - f0) & 0x7FF, ==, 3);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_SOF, ==, INT_SOF);
+
+    /* To the host: bytes, then WR_DONE */
+    g_assert_cmphex(qtest_readl(qts, EP1_CONF) & IN_FREE, ==, IN_FREE);
+    const char *msg = "I (312) main_task: Calling app_main()\n";
+    for (const char *p = msg; *p; p++) {
+        qtest_writel(qts, EP1, *p);
+    }
+    qtest_writel(qts, INT_CLR, INT_IN_EMPTY);
+    qtest_writel(qts, EP1_CONF, WR_DONE);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_IN_EMPTY, ==, INT_IN_EMPTY);
+    char buf[128] = { 0 };
+    size_t got = 0;
+    while (got < strlen(msg)) {
+        ssize_t r = read(host, buf + got, sizeof(buf) - 1 - got);
+        g_assert_cmpint(r, >, 0);
+        got += r;
+    }
+    g_assert_cmpstr(buf, ==, msg);
+
+    /* From the host: an interrupt, then the bytes */
+    qtest_writel(qts, INT_ENA, INT_OUT_RECV);
+    g_assert_cmpint(write(host, "ok", 2), ==, 2);
+    for (int i = 0; i < 100 && !(qtest_readl(qts, EP1_CONF) & OUT_AVAIL); i++) {
+        g_usleep(1000);
+    }
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_OUT_RECV, ==, INT_OUT_RECV);
+    g_assert_true(qtest_readl(qts, INTMATRIX_STATUS3) & BIT(USJ_SOURCE - 96));
+    g_assert_cmphex(qtest_readl(qts, EP1), ==, 'o');
+    g_assert_cmphex(qtest_readl(qts, EP1), ==, 'k');
+    g_assert_cmphex(qtest_readl(qts, EP1_CONF) & OUT_AVAIL, ==, 0);
+
+    close(host);
+    qtest_quit(qts);
+    unlink(sock);
+}
+
+static void test_unplugged(void)
+{
+    QTestState *qts = qtest_init("-machine esp32s3");
+    qtest_writel(qts, INT_CLR, ~0u);
+    qtest_clock_step(qts, 5 * 1000 * 1000);
+    g_assert_cmphex(qtest_readl(qts, INT_RAW) & INT_SOF, ==, 0);   /* No frames */
+    for (int i = 0; i < 64; i++) {
+        qtest_writel(qts, EP1, 'x');
+    }
+    qtest_writel(qts, EP1_CONF, WR_DONE);
+    g_assert_cmphex(qtest_readl(qts, EP1_CONF) & IN_FREE, ==, 0);  /* Stays full */
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/usb-serial-jtag/with_host", test_with_host);
+    qtest_add_func("/esp32s3/usb-serial-jtag/unplugged", test_unplugged);
+    return g_test_run();
+}
