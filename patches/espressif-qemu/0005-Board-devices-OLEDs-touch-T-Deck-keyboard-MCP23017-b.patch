diff --git a/hw/input/gpio_button.c b/hw/input/gpio_button.c
new file mode 100644
index 0000000..7864900
--- /dev/null
+++ b/hw/input/gpio_button.c
@@ -0,0 +1,218 @@
+/*
+ * A push button, switch or rotary encoder on GPIO lines
+ *
+ * A button drives its line while pressed (to 0, or 1 with active-high=on) and releases
+ * it otherwise (-1: the pull resistors decide). The line is an ESP32-S3 pin (pin=N) or
+ * a device's GPIO input (dev=ID, line=NAME, n=N), e.g. an I/O expander's.
+ * Pressed from tests with qom-set "pressed", or from the host keyboard with key=QCODE
+ * (e.g. key=a, key=ret).
+ *
+ * An encoder (encoder=on) has two lines, A at pin/n and B at pin-b/n+1; qom-set "turn"
+ * to N steps (negative: the other way) makes the quadrature edges, one step per 2 ms.
+ *
+ *   -device gpio-button,pin=0,id=boot,key=b
+ *   -device gpio-button,encoder=on,pin=4,pin-b=5,id=knob
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qapi/qapi-types-ui.h"
+#include "qapi/util.h"
+#include "hw/irq.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "hw/gpio/esp32s3_gpio.h"
+#include "ui/input.h"
+#include "qom/object.h"
+
+#define TYPE_GPIO_BUTTON "gpio-button"
+OBJECT_DECLARE_SIMPLE_TYPE(GpioButtonState, GPIO_BUTTON)
+
+#define STEP_NS (500 * SCALE_US)
+
+struct GpioButtonState {
+    DeviceState parent_obj;
+
+    int32_t pin, pin_b;
+    char *dev, *line, *key;
+    int32_t n;
+    bool active_high, encoder;
+
+    qemu_irq a, b;
+    bool pressed;
+    int key_qcode;
+    /* Encoder */
+    int32_t pending;            /* Quarter steps still to make, signed */
+    int phase;                  /* Gray code position 0-3 */
+    QEMUTimer *timer;
+};
+
+static void drive(GpioButtonState *s, qemu_irq line, bool active)
+{
+    qemu_set_irq(line, active ? (s->active_high ? 1 : 0) : -1);
+}
+
+static void set_pressed(Object *obj, bool v, Error **errp)
+{
+    GpioButtonState *s = GPIO_BUTTON(obj);
+    s->pressed = v;
+    drive(s, s->a, v);
+}
+
+static bool get_pressed(Object *obj, Error **errp)
+{
+    return GPIO_BUTTON(obj)->pressed;
+}
+
+/* Quadrature: A leads B one way; 4 edges per detent */
+static void encoder_tick(void *opaque)
+{
+    GpioButtonState *s = GPIO_BUTTON(opaque);
+    if (!s->pending) {
+        return;
+    }
+    s->phase = (s->phase + (s->pending > 0 ? 1 : 3)) % 4;
+    s->pending += s->pending > 0 ? -1 : 1;
+    static const int gray_a[4] = { 0, 1, 1, 0 }, gray_b[4] = { 0, 0, 1, 1 };
+    /* Contacts to ground: a closed contact drives 0 */
+    qemu_set_irq(s->a, gray_a[s->phase] ? 0 : -1);
+    qemu_set_irq(s->b, gray_b[s->phase] ? 0 : -1);
+    if (s->pending) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + STEP_NS);
+    }
+}
+
+static void set_turn(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    GpioButtonState *s = GPIO_BUTTON(obj);
+    int32_t steps;
+    if (!visit_type_int32(v, name, &steps, errp)) {
+        return;
+    }
+    s->pending += steps * 4;
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + STEP_NS);
+}
+
+static void button_input_event(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    GpioButtonState *s = GPIO_BUTTON(dev);
+    if (evt->type == INPUT_EVENT_KIND_KEY) {
+        InputKeyEvent *key = evt->u.key.data;
+        if (qemu_input_key_value_to_qcode(key->key) == s->key_qcode) {
+            set_pressed(OBJECT(s), key->down, NULL);
+        }
+    }
+}
+
+static const QemuInputHandler button_handler = {
+    .name = "GPIO button",
+    .mask = INPUT_EVENT_MASK_KEY,
+    .event = button_input_event,
+};
+
+static qemu_irq resolve_line(GpioButtonState *s, int32_t pin, int idx, Error **errp)
+{
+    if (pin >= 0) {
+        Object *g = object_resolve_path("/machine/soc/gpio", NULL);
+        if (!object_dynamic_cast(g, TYPE_ESP32S3_GPIO) || pin >= ESP32S3_GPIO_PINS) {
+            error_setg(errp, "no ESP32-S3 pin %d", pin);
+            return NULL;
+        }
+        return qdev_get_gpio_in_named(DEVICE(g), ESP32S3_GPIO_PIN_IN, pin);
+    }
+    if (!s->dev) {
+        error_setg(errp, "a button needs pin= or dev=");
+        return NULL;
+    }
+    g_autofree char *path = s->dev[0] == '/' ? g_strdup(s->dev)
+                                             : g_strdup_printf("/machine/peripheral/%s", s->dev);
+    DeviceState *t = (DeviceState *)object_dynamic_cast(object_resolve_path(path, NULL), TYPE_DEVICE);
+    if (!t) {
+        error_setg(errp, "no device '%s' (it must come before the button)", s->dev);
+        return NULL;
+    }
+    const char *line = (s->line && *s->line) ? s->line : NULL;
+    NamedGPIOList *gl;
+    QLIST_FOREACH(gl, &t->gpios, node) {
+        if (g_strcmp0(gl->name, line) == 0 && idx < gl->num_in) {
+            return qdev_get_gpio_in_named(t, line, idx);
+        }
+    }
+    error_setg(errp, "'%s' has no input %s[%d]", s->dev, line ? line : "", idx);
+    return NULL;
+}
+
+static void button_realize(DeviceState *dev, Error **errp)
+{
+    GpioButtonState *s = GPIO_BUTTON(dev);
+
+    s->a = resolve_line(s, s->pin, s->n, errp);
+    if (!s->a) {
+        return;
+    }
+    if (s->encoder) {
+        s->b = resolve_line(s, s->pin >= 0 ? s->pin_b : -1, s->n + 1, errp);
+        if (!s->b) {
+            return;
+        }
+        s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, encoder_tick, s);
+        qemu_set_irq(s->b, -1);
+    }
+    qemu_set_irq(s->a, -1);
+    if (s->key) {
+        s->key_qcode = qapi_enum_parse(&QKeyCode_lookup, s->key, -1, errp);
+        if (s->key_qcode < 0) {
+            return;
+        }
+        qemu_input_handler_register(dev, &button_handler);
+    }
+}
+
+static Property button_properties[] = {
+    DEFINE_PROP_INT32("pin", GpioButtonState, pin, -1),
+    DEFINE_PROP_INT32("pin-b", GpioButtonState, pin_b, -1),
+    DEFINE_PROP_STRING("dev", GpioButtonState, dev),
+    DEFINE_PROP_STRING("line", GpioButtonState, line),
+    DEFINE_PROP_INT32("n", GpioButtonState, n, 0),
+    DEFINE_PROP_STRING("key", GpioButtonState, key),
+    DEFINE_PROP_BOOL("active-high", GpioButtonState, active_high, false),
+    DEFINE_PROP_BOOL("encoder", GpioButtonState, encoder, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void button_instance_init(Object *obj)
+{
+    object_property_add_bool(obj, "pressed", get_pressed, set_pressed);
+    object_property_add(obj, "turn", "int32", NULL, set_turn, NULL, NULL);
+}
+
+static void button_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = button_realize;
+    dc->user_creatable = true;
+    dc->desc = "A button, switch or rotary encoder on GPIO lines";
+    device_class_set_props(dc, button_properties);
+    set_bit(DEVICE_CATEGORY_INPUT, dc->categories);
+}
+
+static const TypeInfo button_info = {
+    .name = TYPE_GPIO_BUTTON,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(GpioButtonState),
+    .instance_init = button_instance_init,
+    .class_init = button_class_init,
+};
+
+static void button_register_types(void)
+{
+    type_register_static(&button_info);
+}
+
+type_init(button_register_types)
diff --git a/hw/input/i2c_touch.c b/hw/input/i2c_touch.c
new file mode 100644
index 0000000..2e026ad
--- /dev/null
+++ b/hw/input/i2c_touch.c
@@ -0,0 +1,335 @@
+/*
+ * Capacitive touch controllers on I2C: GT911 (Goodix), CST816S/T/D (Hynitron), FT6336U
+ * (FocalTech FT6x06 family)
+ *
+ * The touch comes from the absolute pointer (a window's mouse) or, for tests, the QOM
+ * properties "x", "y" (in the controller's coordinates) and "pressed". While touched
+ * the controller makes a new report every 10 ms, and once on release; each report pulses
+ * INT low for 100 us (the "int" GPIO out), except the FT6336 in its default polling mode,
+ * which holds INT low while touched. Wire INT with pin-link dir=out (open-drain=on for an
+ * open drain line).
+ *
+ * GT911: 16-bit register addresses; product ID "911" at 0x8140, resolution at 0x8146,
+ * status 0x814E (bit 7: a report is ready, bits 0-3: points; written 0 to take it),
+ * points from 0x814F, configuration 0x8047-0x8100 (its x/y maxima scale the
+ * coordinates). CST816 and FT6336: 8-bit registers; points at 0x02-0x06, chip IDs at
+ * 0xA7 (CST816) or 0xA3/0xA8 (FT6336).
+ *
+ *   -device gt911,bus=i2c0,address=0x5d,id=touch,width=320,height=240
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/i2c/i2c.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "ui/input.h"
+#include "qom/object.h"
+
+#define TYPE_I2C_TOUCH "i2c-touch"
+OBJECT_DECLARE_SIMPLE_TYPE(I2CTouchState, I2C_TOUCH)
+
+enum { KIND_GT911, KIND_CST816, KIND_FT6336 };
+
+#define REPORT_NS   (10 * SCALE_MS)
+#define PULSE_NS    (100 * SCALE_US)
+
+struct I2CTouchState {
+    I2CSlave parent_obj;
+
+    int kind;
+    qemu_irq irq;
+    QEMUTimer *report_timer, *pulse_timer;
+    QemuInputHandlerState *input;
+
+    uint32_t width, height;     /* Coordinate range */
+    uint32_t chip_id;           /* CST816: 0xB4 S, 0xB5 T, 0xB6 D */
+    bool swap_xy, invert_x, invert_y;
+
+    uint32_t x, y;
+    bool pressed;
+    bool was_pressed;
+
+    /* Register access */
+    uint16_t reg;
+    int addr_bytes;             /* Address bytes still to come in this write */
+    bool writing_addr;
+    uint8_t gt_config[0x8100 - 0x8047 + 1];
+    uint8_t gt_status;
+    uint8_t gt_points[8];
+    uint8_t ft_mode;            /* FT6336 G_MODE: 0 polling, 1 trigger */
+    uint8_t gesture;
+};
+
+static void pulse_end(void *opaque)
+{
+    I2CTouchState *s = I2C_TOUCH(opaque);
+    if (!(s->kind == KIND_FT6336 && s->ft_mode == 0 && s->pressed)) {
+        qemu_set_irq(s->irq, 1);
+    }
+}
+
+static void report(I2CTouchState *s)
+{
+    if (s->kind == KIND_GT911) {
+        uint16_t x = s->x, y = s->y;
+        s->gt_status = 0x80 | (s->pressed ? 1 : 0);
+        uint8_t p[8] = { 0, x & 0xFF, x >> 8, y & 0xFF, y >> 8, 0x20, 0, 0 };
+        memcpy(s->gt_points, p, sizeof(p));
+    }
+    if (s->kind == KIND_FT6336 && s->ft_mode == 0) {
+        qemu_set_irq(s->irq, !s->pressed);      /* Polling mode: low while touched */
+        return;
+    }
+    qemu_set_irq(s->irq, 0);
+    timer_mod(s->pulse_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + PULSE_NS);
+}
+
+static void report_tick(void *opaque)
+{
+    I2CTouchState *s = I2C_TOUCH(opaque);
+    if (s->pressed || s->was_pressed) {
+        report(s);
+    }
+    s->was_pressed = s->pressed;
+    if (s->pressed) {
+        timer_mod(s->report_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + REPORT_NS);
+    }
+}
+
+static void touch_changed(I2CTouchState *s)
+{
+    report_tick(s);
+}
+
+static uint8_t read_reg(I2CTouchState *s, uint16_t r)
+{
+    uint16_t x = s->x, y = s->y;
+    switch (s->kind) {
+    case KIND_GT911:
+        if (r >= 0x8047 && r <= 0x8100) {
+            return s->gt_config[r - 0x8047];
+        }
+        switch (r) {
+        case 0x8140: return '9';
+        case 0x8141: return '1';
+        case 0x8142: return '1';
+        case 0x8143: return 0;
+        case 0x8144: return 0x60;           /* Firmware 0x1060 */
+        case 0x8145: return 0x10;
+        case 0x8146: return s->width & 0xFF;
+        case 0x8147: return s->width >> 8;
+        case 0x8148: return s->height & 0xFF;
+        case 0x8149: return s->height >> 8;
+        case 0x814A: return 0;              /* Vendor */
+        case 0x814E: return s->gt_status;
+        default:
+            if (r >= 0x814F && r < 0x814F + 8) {
+                return s->gt_points[r - 0x814F];
+            }
+            return 0;
+        }
+    case KIND_CST816:
+        switch (r) {
+        case 0x00: return 0;
+        case 0x01: return s->gesture;
+        case 0x02: return s->pressed ? 1 : 0;
+        case 0x03: return (s->pressed ? 0x80 : 0x40) | ((x >> 8) & 0x0F);
+        case 0x04: return x & 0xFF;
+        case 0x05: return (y >> 8) & 0x0F;
+        case 0x06: return y & 0xFF;
+        case 0xA7: return s->chip_id;
+        case 0xA8: return 0x00;
+        case 0xA9: return 0x02;
+        default:   return 0;
+        }
+    default: /* FT6336 */
+        switch (r) {
+        case 0x00: return 0;
+        case 0x01: return s->gesture;
+        case 0x02: return s->pressed ? 1 : 0;
+        case 0x03: return (s->pressed ? 0x80 : 0x40) | ((x >> 8) & 0x0F);
+        case 0x04: return x & 0xFF;
+        case 0x05: return (y >> 8) & 0x0F;
+        case 0x06: return y & 0xFF;
+        case 0x07: return 0x20;
+        case 0x08: return 0x10;
+        case 0x80: return 0x16;
+        case 0xA3: return 0x64;             /* FT6336U */
+        case 0xA4: return s->ft_mode;
+        case 0xA6: return 0x10;
+        case 0xA8: return 0x11;             /* FocalTech */
+        default:   return 0;
+        }
+    }
+}
+
+static void write_reg(I2CTouchState *s, uint16_t r, uint8_t v)
+{
+    if (s->kind == KIND_GT911) {
+        if (r >= 0x8047 && r <= 0x8100) {
+            s->gt_config[r - 0x8047] = v;
+            if (r == 0x804B) {          /* x/y output maxima: the coordinate range */
+                s->width = s->gt_config[1] | s->gt_config[2] << 8;
+                s->height = s->gt_config[3] | s->gt_config[4] << 8;
+            }
+        } else if (r == 0x814E) {
+            s->gt_status = v;
+        }
+    } else if (s->kind == KIND_FT6336 && r == 0xA4) {
+        s->ft_mode = v & 1;
+    }
+}
+
+static int touch_event(I2CSlave *i2c, enum i2c_event event)
+{
+    I2CTouchState *s = I2C_TOUCH(i2c);
+    if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
+        s->addr_bytes = s->kind == KIND_GT911 ? 2 : 1;
+        s->writing_addr = true;
+    }
+    return 0;
+}
+
+static int touch_send(I2CSlave *i2c, uint8_t b)
+{
+    I2CTouchState *s = I2C_TOUCH(i2c);
+    if (s->writing_addr) {
+        s->reg = s->addr_bytes == 2 ? (uint16_t)b << 8 : (s->kind == KIND_GT911 ? (s->reg | b) : b);
+        if (--s->addr_bytes == 0) {
+            s->writing_addr = false;
+        }
+        return 0;
+    }
+    write_reg(s, s->reg++, b);
+    return 0;
+}
+
+static uint8_t touch_recv(I2CSlave *i2c)
+{
+    I2CTouchState *s = I2C_TOUCH(i2c);
+    return read_reg(s, s->reg++);
+}
+
+static void touch_input_event(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    I2CTouchState *s = I2C_TOUCH(dev);
+    if (evt->type == INPUT_EVENT_KIND_ABS) {
+        InputMoveEvent *move = evt->u.abs.data;
+        bool is_x = (move->axis == INPUT_AXIS_X) != s->swap_xy;
+        uint32_t range = is_x ? s->width : s->height;
+        uint32_t v = (uint64_t)move->value * (range - 1) / INPUT_EVENT_ABS_MAX;
+        if (is_x) {
+            s->x = s->invert_x ? range - 1 - v : v;
+        } else {
+            s->y = s->invert_y ? range - 1 - v : v;
+        }
+    } else if (evt->type == INPUT_EVENT_KIND_BTN) {
+        InputBtnEvent *btn = evt->u.btn.data;
+        if (btn->button == INPUT_BUTTON_LEFT && btn->down != s->pressed) {
+            s->pressed = btn->down;
+            touch_changed(s);
+        }
+    }
+}
+
+static const QemuInputHandler touch_handler = {
+    .name = "capacitive touch screen",
+    .mask = INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_ABS,
+    .event = touch_input_event,
+};
+
+static bool get_pressed(Object *obj, Error **errp)
+{
+    return I2C_TOUCH(obj)->pressed;
+}
+
+static void set_pressed(Object *obj, bool v, Error **errp)
+{
+    I2CTouchState *s = I2C_TOUCH(obj);
+    if (v != s->pressed) {
+        s->pressed = v;
+        touch_changed(s);
+    }
+}
+
+static void touch_instance_init(Object *obj)
+{
+    I2CTouchState *s = I2C_TOUCH(obj);
+    const char *t = object_get_typename(obj);
+    s->kind = !strcmp(t, "gt911") ? KIND_GT911 : !strcmp(t, "cst816") ? KIND_CST816 : KIND_FT6336;
+    object_property_add_uint32_ptr(obj, "x", &s->x, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "y", &s->y, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_bool(obj, "pressed", get_pressed, set_pressed);
+}
+
+static void touch_realize(DeviceState *dev, Error **errp)
+{
+    I2CTouchState *s = I2C_TOUCH(dev);
+    qdev_init_gpio_out_named(dev, &s->irq, "int", 1);
+    s->report_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, report_tick, s);
+    s->pulse_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, pulse_end, s);
+    s->input = qemu_input_handler_register(dev, &touch_handler);
+    if (s->kind == KIND_GT911) {
+        s->gt_config[0] = 0x41;                 /* Config version */
+        s->gt_config[1] = s->width & 0xFF;
+        s->gt_config[2] = s->width >> 8;
+        s->gt_config[3] = s->height & 0xFF;
+        s->gt_config[4] = s->height >> 8;
+        s->gt_config[5] = 5;                    /* Touch points */
+        s->gt_config[6] = 0x0D;                 /* INT falling edge, X2Y off */
+    }
+}
+
+static void touch_reset(DeviceState *dev)
+{
+    I2CTouchState *s = I2C_TOUCH(dev);
+    s->gt_status = 0;
+    s->ft_mode = 0;
+    qemu_set_irq(s->irq, 1);
+}
+
+static Property touch_properties[] = {
+    DEFINE_PROP_UINT32("width", I2CTouchState, width, 240),
+    DEFINE_PROP_UINT32("height", I2CTouchState, height, 320),
+    DEFINE_PROP_UINT32("chip-id", I2CTouchState, chip_id, 0xB5),
+    DEFINE_PROP_BOOL("swap-xy", I2CTouchState, swap_xy, false),
+    DEFINE_PROP_BOOL("invert-x", I2CTouchState, invert_x, false),
+    DEFINE_PROP_BOOL("invert-y", I2CTouchState, invert_y, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void touch_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = touch_realize;
+    device_class_set_legacy_reset(dc, touch_reset);
+    device_class_set_props(dc, touch_properties);
+    k->event = touch_event;
+    k->send = touch_send;
+    k->recv = touch_recv;
+    set_bit(DEVICE_CATEGORY_INPUT, dc->categories);
+}
+
+static const TypeInfo touch_types[] = {
+    {
+        .name = TYPE_I2C_TOUCH,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(I2CTouchState),
+        .instance_init = touch_instance_init,
+        .class_init = touch_class_init,
+        .abstract = true,
+    },
+    { .name = "gt911", .parent = TYPE_I2C_TOUCH },
+    { .name = "cst816", .parent = TYPE_I2C_TOUCH },
+    { .name = "ft6336", .parent = TYPE_I2C_TOUCH },
+};
+
+DEFINE_TYPES(touch_types)
