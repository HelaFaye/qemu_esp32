diff --git a/tests/qtest/esp32s3-i2c-devices-test.c b/tests/qtest/esp32s3-i2c-devices-test.c
new file mode 100644
index 0000000..45c1981
--- /dev/null
+++ b/tests/qtest/esp32s3-i2c-devices-test.c
@@ -0,0 +1,279 @@
+/*
+ * QTest for board devices on the ESP32-S3's I2C0: an SSD1306 OLED (Heltec boards), GT911
+ * and CST816 touch (T-Deck, T-Display-S3 Touch), the T-Deck keyboard, an MCP23017 with a
+ * button (gbagate), and buttons and a rotary encoder on chip pins.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qjson.h"
+#include "qapi/error.h"
+#include "libqtest.h"
+
+#define I2C0            0x60013000
+#define I2C_SCL_LOW     (I2C0 + 0x00)
+#define I2C_CTR         (I2C0 + 0x04)
+#define I2C_FIFO_CONF   (I2C0 + 0x18)
+#define I2C_DATA        (I2C0 + 0x1C)
+#define I2C_INT_RAW     (I2C0 + 0x20)
+#define I2C_INT_CLR     (I2C0 + 0x24)
+#define I2C_SCL_HIGH    (I2C0 + 0x38)
+#define I2C_CLK_CONF    (I2C0 + 0x54)
+#define I2C_COMD(n)     (I2C0 + 0x58 + 4 * (n))
+
+#define CMD(op, n, ack_check, ack_val) ((op) << 11 | (ack_val) << 10 | (ack_check) << 8 | (n))
+#define INT_TRANS_COMPLETE  BIT(7)
+#define INT_NACK            BIT(10)
+
+#define GPIO            0x60004000
+#define IN              (GPIO + 0x3C)
+#define IN1             (GPIO + 0x40)
+#define STATUS          (GPIO + 0x44)
+#define STATUS_W1TC     (GPIO + 0x4C)
+#define PIN(n)          (GPIO + 0x74 + 4 * (n))
+#define IOMUX(n)        (0x60009004 + 4 * (n))
+#define FUN_IE          BIT(9)
+#define FUN_PU          BIT(8)
+
+static QTestState *board(const char *devices)
+{
+    g_autofree char *args = g_strdup_printf("-machine esp32s3 %s", devices);
+    QTestState *qts = qtest_init(args);
+    qtest_writel(qts, I2C_CLK_CONF, BIT(21));
+    qtest_writel(qts, I2C_SCL_LOW, 49);         /* 400 kHz */
+    qtest_writel(qts, I2C_SCL_HIGH, 49);
+    qtest_writel(qts, I2C_CTR, BIT(4) | BIT(11));
+    return qts;
+}
+
+/* A write of wn bytes, then (repeated start) a read of rn: as i2c_master_transmit_receive */
+static bool i2c_xfer(QTestState *qts, uint8_t addr, const uint8_t *w, int wn, uint8_t *r, int rn)
+{
+    int c = 0;
+    qtest_writel(qts, I2C_FIFO_CONF, BIT(12) | BIT(13));
+    qtest_writel(qts, I2C_FIFO_CONF, 0);
+    qtest_writel(qts, I2C_COMD(c++), CMD(6, 0, 0, 0));
+    qtest_writel(qts, I2C_DATA, addr << 1);
+    for (int i = 0; i < wn; i++) {
+        qtest_writel(qts, I2C_DATA, w[i]);
+    }
+    qtest_writel(qts, I2C_COMD(c++), CMD(1, 1 + wn, 1, 0));
+    if (rn) {
+        qtest_writel(qts, I2C_COMD(c++), CMD(6, 0, 0, 0));
+        qtest_writel(qts, I2C_DATA, addr << 1 | 1);
+        qtest_writel(qts, I2C_COMD(c++), CMD(1, 1, 1, 0));
+        if (rn > 1) {
+            qtest_writel(qts, I2C_COMD(c++), CMD(3, rn - 1, 0, 0));
+        }
+        qtest_writel(qts, I2C_COMD(c++), CMD(3, 1, 0, 1));
+    }
+    qtest_writel(qts, I2C_COMD(c++), CMD(2, 0, 0, 0));
+    qtest_writel(qts, I2C_INT_CLR, 0x3FFFF);
+    qtest_writel(qts, I2C_CTR, BIT(4) | BIT(5));
+    qtest_clock_step(qts, 1000 * 1000);        /* Plenty at 400 kHz for these few bytes */
+    uint32_t raw = qtest_readl(qts, I2C_INT_RAW);
+    for (int i = 0; i < rn; i++) {
+        r[i] = qtest_readl(qts, I2C_DATA);
+    }
+    return (raw & INT_TRANS_COMPLETE) && !(raw & INT_NACK);
+}
+
+static void qom_set(QTestState *qts, const char *path, const char *prop, const char *json)
+{
+    QDict *r = qtest_qmp(qts, "{'execute': 'qom-set', 'arguments': {'path': %s, 'property': %s, "
+                              "'value': %p}}", path, prop, qobject_from_json(json, &error_abort));
+    g_assert(qdict_haskey(r, "return"));
+    qobject_unref(r);
+}
+
+static uint8_t *screendump(QTestState *qts, const char *dev, int *w, int *h)
+{
+    g_autofree char *path = g_strdup_printf("%s/qtest-%s-%d.ppm", g_get_tmp_dir(), dev, getpid());
+    QDict *r = qtest_qmp(qts, "{'execute': 'screendump', 'arguments': {'filename': %s, 'device': %s}}",
+                         path, dev);
+    g_assert(qdict_haskey(r, "return"));
+    qobject_unref(r);
+    gchar *data;
+    gsize len;
+    g_assert(g_file_get_contents(path, &data, &len, NULL));
+    unlink(path);
+    int maxval, off;
+    g_assert_cmpint(sscanf(data, "P6 %d %d %d%n", w, h, &maxval, &off), ==, 3);
+    uint8_t *px = g_memdup2(data + off + 1, (size_t)*w * *h * 3);
+    g_free(data);
+    return px;
+}
+
+static void test_ssd1306(void)
+{
+    QTestState *qts = board("-device ssd1306,bus=i2c0,address=0x3c,id=oled");
+    /* Adafruit_SSD1306's start (abridged), horizontal addressing over the whole screen */
+    const uint8_t init[] = { 0x00, 0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40, 0x8D, 0x14,
+                             0x20, 0x00, 0xA1, 0xC8, 0xDA, 0x12, 0x81, 0xCF, 0xA6, 0xAF,
+                             0x21, 0x00, 0x7F, 0x22, 0x00, 0x07 };
+    g_assert_true(i2c_xfer(qts, 0x3C, init, sizeof(init), NULL, 0));
+    /* Data: column 0 all lit, column 1 the top pixel, then a dark column */
+    const uint8_t data[] = { 0x40, 0xFF, 0x01, 0x00 };
+    g_assert_true(i2c_xfer(qts, 0x3C, data, sizeof(data), NULL, 0));
+
+    int w, h;
+    uint8_t *px = screendump(qts, "oled", &w, &h);
+    g_assert_cmpint(w, ==, 128);
+    g_assert_cmpint(h, ==, 64);
+    /* Segment remap (A1) and COM scan C8: RAM column 0 is the glass's right, page 0 its
+     * bottom; that's how the Heltec module is mounted so the image is upright */
+#define LIT(x, y) (px[((y) * w + (x)) * 3] > 0x40)
+    for (int y = 56; y < 64; y++) {
+        g_assert_true(LIT(127, y));
+    }
+    g_assert_true(LIT(126, 63));
+    g_assert_false(LIT(126, 62));
+    g_assert_false(LIT(125, 63));
+    g_free(px);
+    qtest_quit(qts);
+}
+
+static void test_touch(void)
+{
+    QTestState *qts = board("-device gt911,bus=i2c0,address=0x5d,id=gt,width=320,height=240 "
+                            "-device esp32s3.pin-link,pin=16,dev=gt,line=int,dir=out "
+                            "-device cst816,bus=i2c0,address=0x15,id=cst,width=170,height=320");
+    uint8_t r[8];
+
+    /* GT911: product ID, resolution */
+    g_assert_true(i2c_xfer(qts, 0x5D, (uint8_t[]){ 0x81, 0x40 }, 2, r, 3));
+    g_assert_cmpmem(r, 3, "911", 3);
+    g_assert_true(i2c_xfer(qts, 0x5D, (uint8_t[]){ 0x81, 0x46 }, 2, r, 4));
+    g_assert_cmpint(r[0] | r[1] << 8, ==, 320);
+    g_assert_cmpint(r[2] | r[3] << 8, ==, 240);
+
+    /* A touch at (100, 200): INT falls, the status says one point, the point is there */
+    qtest_writel(qts, PIN(16), 2 << 7);                     /* Falling edge */
+    qtest_writel(qts, STATUS_W1TC, ~0u);
+    qom_set(qts, "/machine/peripheral/gt", "x", "100");
+    qom_set(qts, "/machine/peripheral/gt", "y", "200");
+    qom_set(qts, "/machine/peripheral/gt", "pressed", "true");
+    qtest_clock_step(qts, 1000 * 1000);
+    g_assert_cmphex(qtest_readl(qts, STATUS) & BIT(16), ==, BIT(16));
+    g_assert_true(i2c_xfer(qts, 0x5D, (uint8_t[]){ 0x81, 0x4E }, 2, r, 6));
+    g_assert_cmphex(r[0], ==, 0x81);
+    g_assert_cmpint(r[2] | r[3] << 8, ==, 100);
+    g_assert_cmpint(r[4] | r[5] << 8, ==, 200);
+    /* Taken: status written 0 */
+    g_assert_true(i2c_xfer(qts, 0x5D, (uint8_t[]){ 0x81, 0x4E, 0x00 }, 3, NULL, 0));
+    g_assert_true(i2c_xfer(qts, 0x5D, (uint8_t[]){ 0x81, 0x4E }, 2, r, 1));
+    g_assert_cmphex(r[0], ==, 0x00);
+    /* Still touched: the next report 10 ms later */
+    qtest_clock_step(qts, 11 * 1000 * 1000);
+    g_assert_true(i2c_xfer(qts, 0x5D, (uint8_t[]){ 0x81, 0x4E }, 2, r, 1));
+    g_assert_cmphex(r[0], ==, 0x81);
+
+    /* CST816: chip ID, then a touch */
+    g_assert_true(i2c_xfer(qts, 0x15, (uint8_t[]){ 0xA7 }, 1, r, 1));
+    g_assert_cmphex(r[0], ==, 0xB5);
+    g_assert_true(i2c_xfer(qts, 0x15, (uint8_t[]){ 0x02 }, 1, r, 5));
+    g_assert_cmphex(r[0], ==, 0);
+    qom_set(qts, "/machine/peripheral/cst", "x", "150");
+    qom_set(qts, "/machine/peripheral/cst", "y", "300");
+    qom_set(qts, "/machine/peripheral/cst", "pressed", "true");
+    g_assert_true(i2c_xfer(qts, 0x15, (uint8_t[]){ 0x02 }, 1, r, 5));
+    g_assert_cmphex(r[0], ==, 1);
+    g_assert_cmpint((r[1] & 0x0F) << 8 | r[2], ==, 150);
+    g_assert_cmpint((r[3] & 0x0F) << 8 | r[4], ==, 300);
+    qtest_quit(qts);
+}
+
+static void test_keyboard(void)
+{
+    QTestState *qts = board("-device tdeck-keyboard,bus=i2c0,address=0x55,id=kbd");
+    uint8_t r[1];
+    g_assert_true(i2c_xfer(qts, 0x55, NULL, 0, r, 1));
+    g_assert_cmphex(r[0], ==, 0);
+    qom_set(qts, "/machine/peripheral/kbd", "keys", "\"hi\\n\"");
+    const char want[] = { 'h', 'i', '\r', 0 };
+    for (int i = 0; i < 4; i++) {
+        g_assert_true(i2c_xfer(qts, 0x55, NULL, 0, r, 1));
+        g_assert_cmphex(r[0], ==, (uint8_t)want[i]);
+    }
+    /* Backlight */
+    g_assert_true(i2c_xfer(qts, 0x55, (uint8_t[]){ 0x01, 200 }, 2, NULL, 0));
+    QDict *resp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': {'path': '/machine/peripheral/kbd', "
+                                 "'property': 'brightness'}}");
+    g_assert_cmpint(qdict_get_int(resp, "return"), ==, 200);
+    qobject_unref(resp);
+    qtest_quit(qts);
+}
+
+static void test_expander(void)
+{
+    QTestState *qts = board("-device mcp23017,bus=i2c0,address=0x20,id=exp "
+                            "-device gpio-button,dev=exp,line=in,n=0,id=btnA "
+                            "-device esp32s3.pin-link,pin=36,dev=exp,line=inta,dir=out,open-drain=on,pull=up");
+    uint8_t r[2];
+    /* gbagate's set up: GPA all inputs with pull-ups, interrupt on change, open drain INT */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x0A, 0x44 }, 2, NULL, 0));     /* IOCON MIRROR|ODR */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x0C, 0xFF, 0xFF }, 3, NULL, 0)); /* GPPU */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x04, 0xFF, 0x00 }, 3, NULL, 0)); /* GPINTEN A */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x12 }, 1, r, 2));
+    g_assert_cmphex(r[0], ==, 0xFF);
+    g_assert_cmphex(qtest_readl(qts, IN1) & BIT(36 - 32), ==, BIT(36 - 32));
+
+    qom_set(qts, "/machine/peripheral/btnA", "pressed", "true");
+    g_assert_cmphex(qtest_readl(qts, IN1) & BIT(36 - 32), ==, 0);              /* INT low */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x0E }, 1, r, 1));           /* INTF */
+    g_assert_cmphex(r[0], ==, 0x01);
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x12 }, 1, r, 1));           /* GPIOA */
+    g_assert_cmphex(r[0], ==, 0xFE);
+    g_assert_cmphex(qtest_readl(qts, IN1) & BIT(36 - 32), ==, BIT(36 - 32));   /* Cleared */
+
+    /* Outputs: GPB0 as an output follows OLATB */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x01, 0xFE }, 2, NULL, 0));     /* IODIRB */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x15, 0x01 }, 2, NULL, 0));     /* OLATB */
+    g_assert_true(i2c_xfer(qts, 0x20, (uint8_t[]){ 0x13 }, 1, r, 1));
+    g_assert_cmphex(r[0] & 1, ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_buttons_and_encoder(void)
+{
+    QTestState *qts = board("-device gpio-button,pin=0,id=boot "
+                            "-device gpio-button,encoder=on,pin=4,pin-b=5,id=knob");
+    qtest_writel(qts, IOMUX(0), FUN_IE | FUN_PU);
+    qtest_writel(qts, IOMUX(4), FUN_IE | FUN_PU);
+    qtest_writel(qts, IOMUX(5), FUN_IE | FUN_PU);
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(0), ==, BIT(0));
+    qom_set(qts, "/machine/peripheral/boot", "pressed", "true");
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(0), ==, 0);
+    qom_set(qts, "/machine/peripheral/boot", "pressed", "false");
+    g_assert_cmphex(qtest_readl(qts, IN) & BIT(0), ==, BIT(0));
+
+    /* One detent clockwise: A falls before B; any-edge interrupts count 2 edges each */
+    qtest_writel(qts, PIN(4), 3 << 7);
+    qtest_writel(qts, PIN(5), 3 << 7);
+    qtest_writel(qts, STATUS_W1TC, ~0u);
+    qom_set(qts, "/machine/peripheral/knob", "turn", "1");
+    qtest_clock_step(qts, 600 * 1000);                      /* The first quarter step */
+    g_assert_cmphex(qtest_readl(qts, IN) & (BIT(4) | BIT(5)), ==, BIT(5));     /* A low, B high */
+    qtest_clock_step(qts, 500 * 1000);
+    g_assert_cmphex(qtest_readl(qts, IN) & (BIT(4) | BIT(5)), ==, 0);          /* Both low */
+    qtest_clock_step(qts, 2 * 1000 * 1000);
+    g_assert_cmphex(qtest_readl(qts, IN) & (BIT(4) | BIT(5)), ==, BIT(4) | BIT(5));  /* Detent */
+    g_assert_cmphex(qtest_readl(qts, STATUS) & (BIT(4) | BIT(5)), ==, BIT(4) | BIT(5));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32s3/i2c-devices/ssd1306", test_ssd1306);
+    qtest_add_func("/esp32s3/i2c-devices/touch", test_touch);
+    qtest_add_func("/esp32s3/i2c-devices/keyboard", test_keyboard);
+    qtest_add_func("/esp32s3/i2c-devices/expander", test_expander);
+    qtest_add_func("/esp32s3/i2c-devices/buttons_and_encoder", test_buttons_and_encoder);
+    return g_test_run();
+}
