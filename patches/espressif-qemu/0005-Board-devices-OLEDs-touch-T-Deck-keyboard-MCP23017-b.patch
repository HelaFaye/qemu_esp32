diff --git a/hw/display/ssd1306.c b/hw/display/ssd1306.c
new file mode 100644
index 0000000..157048f
--- /dev/null
+++ b/hw/display/ssd1306.c
@@ -0,0 +1,298 @@
+/*
+ * SSD1306 and SH1106 monochrome OLED controllers on I2C (128x64 or 128x32)
+ *
+ * After the address, a control byte: Co (bit 7: one byte follows, then another control
+ * byte) and D/C# (bit 6: data, else commands). Commands: display on/off, contrast,
+ * entire display on, inverse, multiplex ratio, display offset, start line, segment remap,
+ * COM scan direction, memory addressing modes (horizontal, vertical, page; SH1106: page
+ * only), column/page windows, page and column start in page mode. GDDRAM is 8 pages of
+ * 128 (SH1106: 132) columns, one bit per pixel, LSB at the top.
+ *
+ *   -device ssd1306,bus=i2c0,address=0x3c[,height=32]     (also sh1106)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/i2c/i2c.h"
+#include "hw/qdev-properties.h"
+#include "ui/console.h"
+#include "qom/object.h"
+
+#define TYPE_SSD1306 "ssd1306"
+#define TYPE_SH1106 "sh1106"
+OBJECT_DECLARE_SIMPLE_TYPE(SSD1306State, SSD1306)
+
+#define COLS_MAX    132
+#define PAGES       8
+
+struct SSD1306State {
+    I2CSlave parent_obj;
+
+    QemuConsole *con;
+    uint32_t width, height;
+    uint32_t color;             /* Lit pixel color (RGB888) */
+    bool sh1106;
+
+    uint8_t ram[PAGES][COLS_MAX];
+    /* The I2C stream */
+    bool first;                 /* Next byte is a control byte */
+    bool single;                /* Co: one byte, then a control byte again */
+    bool data;
+    uint8_t cmd[8];
+    int ncmd, need;
+    /* State */
+    bool on, invert, entire_on, seg_remap, com_remap;
+    uint8_t contrast, mode, mux, offset, start_line;
+    uint8_t col, col_start, col_end, page, page_start, page_end;
+    bool dirty;
+};
+
+static int cmd_len(SSD1306State *s, uint8_t c)
+{
+    if (s->sh1106) {
+        switch (c) {
+        case 0x81: case 0xA8: case 0xD3: case 0xD5: case 0xD9: case 0xDA: case 0xDB:
+        case 0xAD:
+            return 2;
+        default:
+            return 1;
+        }
+    }
+    switch (c) {
+    case 0x81: case 0x20: case 0xA8: case 0xD3: case 0xD5: case 0xD9: case 0xDA:
+    case 0xDB: case 0x8D: case 0xA3:
+        return 2;
+    case 0x21: case 0x22:
+        return 3;
+    case 0x26: case 0x27:
+        return 7;
+    case 0x29: case 0x2A:
+        return 6;
+    default:
+        return 1;
+    }
+}
+
+static void run_cmd(SSD1306State *s)
+{
+    uint8_t c = s->cmd[0];
+
+    if (c <= 0x0F) {
+        s->col = (s->col & 0xF0) | c;
+    } else if (c <= 0x1F) {
+        s->col = (s->col & 0x0F) | ((c & 0x0F) << 4);
+    } else if (c >= 0x40 && c <= 0x7F) {
+        s->start_line = c & 0x3F;
+    } else if (c >= 0xB0 && c <= 0xB7) {
+        s->page = c & 7;
+    } else {
+        switch (c) {
+        case 0x20: s->mode = s->cmd[1] & 3; break;
+        case 0x21: s->col_start = s->col = s->cmd[1] & 0x7F; s->col_end = s->cmd[2] & 0x7F; break;
+        case 0x22: s->page_start = s->page = s->cmd[1] & 7; s->page_end = s->cmd[2] & 7; break;
+        case 0x81: s->contrast = s->cmd[1]; break;
+        case 0xA0: s->seg_remap = false; break;
+        case 0xA1: s->seg_remap = true; break;
+        case 0xA4: s->entire_on = false; break;
+        case 0xA5: s->entire_on = true; break;
+        case 0xA6: s->invert = false; break;
+        case 0xA7: s->invert = true; break;
+        case 0xA8: s->mux = s->cmd[1] & 0x3F; break;
+        case 0xAE: s->on = false; break;
+        case 0xAF: s->on = true; break;
+        case 0xC0: s->com_remap = false; break;
+        case 0xC8: s->com_remap = true; break;
+        case 0xD3: s->offset = s->cmd[1] & 0x3F; break;
+        default: break;     /* Clock, precharge, VCOMH, charge pump, scrolling */
+        }
+    }
+    s->dirty = true;
+}
+
+static void write_data(SSD1306State *s, uint8_t b)
+{
+    int cols = s->sh1106 ? COLS_MAX : 128;
+    if (s->col < cols && s->page < PAGES) {
+        s->ram[s->page][s->col] = b;
+        s->dirty = true;
+    }
+    if (s->sh1106 || s->mode == 2) {            /* Page mode: along the page, no wrap */
+        if (s->col < cols - 1) {
+            s->col++;
+        }
+    } else if (s->mode == 0) {                   /* Horizontal */
+        if (s->col >= s->col_end) {
+            s->col = s->col_start;
+            s->page = s->page >= s->page_end ? s->page_start : s->page + 1;
+        } else {
+            s->col++;
+        }
+    } else {                                     /* Vertical */
+        if (s->page >= s->page_end) {
+            s->page = s->page_start;
+            s->col = s->col >= s->col_end ? s->col_start : s->col + 1;
+        } else {
+            s->page++;
+        }
+    }
+}
+
+static int ssd1306_event(I2CSlave *i2c, enum i2c_event event)
+{
+    SSD1306State *s = SSD1306(i2c);
+    if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
+        s->first = true;
+        s->ncmd = 0;
+    }
+    return 0;
+}
+
+static int ssd1306_send(I2CSlave *i2c, uint8_t b)
+{
+    SSD1306State *s = SSD1306(i2c);
+
+    if (s->first) {
+        s->single = b & 0x80;
+        s->data = b & 0x40;
+        s->first = false;
+        return 0;
+    }
+    if (s->data) {
+        write_data(s, b);
+    } else {
+        if (s->ncmd == 0) {
+            s->need = cmd_len(s, b);
+        }
+        s->cmd[s->ncmd++] = b;
+        if (s->ncmd >= s->need) {
+            run_cmd(s);
+            s->ncmd = 0;
+        }
+    }
+    if (s->single) {
+        s->first = true;
+    }
+    return 0;
+}
+
+static uint8_t ssd1306_recv(I2CSlave *i2c)
+{
+    SSD1306State *s = SSD1306(i2c);
+    return s->on ? 0x03 : 0x43;     /* Status: display off in bit 6 (and the SH1106's id) */
+}
+
+static void ssd1306_update(void *opaque)
+{
+    SSD1306State *s = SSD1306(opaque);
+    DisplaySurface *surface = qemu_console_surface(s->con);
+    if (!s->dirty || !surface) {
+        return;
+    }
+    s->dirty = false;
+
+    /* Contrast dims the lit color a little, as the OLED's current does */
+    uint32_t scale = 128 + s->contrast / 2;
+    uint32_t lit = ((((s->color >> 16) & 0xFF) * scale / 255) << 16) |
+                   ((((s->color >> 8) & 0xFF) * scale / 255) << 8) | ((s->color & 0xFF) * scale / 255);
+    int xoff = s->sh1106 ? 2 : 0;
+    uint8_t *dst = surface_data(surface);
+    int stride = surface_stride(surface);
+
+    for (uint32_t y = 0; y < s->height; y++) {
+        uint32_t *line = (uint32_t *)(dst + y * stride);
+        /* Row y shows COM y (or mirrored), which shows RAM row start_line + offset ... */
+        uint32_t com = s->com_remap ? s->height - 1 - y : y;
+        uint32_t row = (com + s->start_line + s->offset) % 64;
+        for (uint32_t x = 0; x < s->width; x++) {
+            uint32_t col = (s->seg_remap ? 127 - x : x) + xoff;
+            bool px = (s->ram[row / 8][col] >> (row % 8)) & 1;
+            if (s->entire_on) {
+                px = true;
+            }
+            if (s->invert) {
+                px = !px;
+            }
+            line[x] = (s->on && px) ? lit : 0;
+        }
+    }
+    dpy_gfx_update(s->con, 0, 0, s->width, s->height);
+}
+
+static void ssd1306_invalidate(void *opaque)
+{
+    SSD1306(opaque)->dirty = true;
+}
+
+static const GraphicHwOps ssd1306_ops = {
+    .invalidate = ssd1306_invalidate,
+    .gfx_update = ssd1306_update,
+};
+
+static void ssd1306_realize(DeviceState *dev, Error **errp)
+{
+    SSD1306State *s = SSD1306(dev);
+    if (s->height != 64 && s->height != 32) {
+        error_setg(errp, "height must be 64 or 32");
+        return;
+    }
+    s->width = 128;
+    s->sh1106 = !strcmp(object_get_typename(OBJECT(dev)), TYPE_SH1106);
+    s->con = graphic_console_init(dev, 0, &ssd1306_ops, s);
+    qemu_console_resize(s->con, s->width, s->height);
+}
+
+static void ssd1306_reset(DeviceState *dev)
+{
+    SSD1306State *s = SSD1306(dev);
+    memset(s->ram, 0, sizeof(s->ram));
+    s->first = true;
+    s->ncmd = 0;
+    s->on = s->invert = s->entire_on = s->seg_remap = s->com_remap = false;
+    s->contrast = 0x7F;
+    s->mode = 2;                /* Page addressing after reset */
+    s->mux = 63;
+    s->offset = s->start_line = 0;
+    s->col = s->col_start = 0;
+    s->col_end = 127;
+    s->page = s->page_start = 0;
+    s->page_end = 7;
+    s->dirty = true;
+}
+
+static Property ssd1306_properties[] = {
+    DEFINE_PROP_UINT32("height", SSD1306State, height, 64),
+    DEFINE_PROP_UINT32("color", SSD1306State, color, 0xFFFFFF),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void ssd1306_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = ssd1306_realize;
+    device_class_set_legacy_reset(dc, ssd1306_reset);
+    device_class_set_props(dc, ssd1306_properties);
+    k->event = ssd1306_event;
+    k->send = ssd1306_send;
+    k->recv = ssd1306_recv;
+    set_bit(DEVICE_CATEGORY_DISPLAY, dc->categories);
+}
+
+static const TypeInfo ssd1306_types[] = {
+    {
+        .name = TYPE_SSD1306,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(SSD1306State),
+        .class_init = ssd1306_class_init,
+    }, {
+        .name = TYPE_SH1106,
+        .parent = TYPE_SSD1306,
+    },
+};
+
+DEFINE_TYPES(ssd1306_types)
diff --git a/hw/gpio/mcp23017.c b/hw/gpio/mcp23017.c
new file mode 100644
index 0000000..606c879
--- /dev/null
+++ b/hw/gpio/mcp23017.c
@@ -0,0 +1,240 @@
+/*
+ * MCP23017 16-bit I2C GPIO expander (IOCON.BANK = 0 register map)
+ *
+ * Pins GPA0-7 and GPB0-7 are lines 0-15: "in" (driven from outside: 0, 1, or anything
+ * else to release the pin to its pull-up) and "out" (the pin's level when it's an
+ * output). INTA/INTB ("inta", "intb") follow GPINTEN, INTCON, DEFVAL, IOCON.MIRROR,
+ * ODR and INTPOL; reading INTCAP or GPIO clears the interrupt. Sequential reads and
+ * writes go up the registers (IOCON.SEQOP = 0).
+ *
+ *   -device mcp23017,bus=i2c0,address=0x20,id=exp
+ *   -device gpio-button,dev=exp,line=in,n=0,id=btnA       (a button to ground on GPA0)
+ *   -device esp32s3.pin-link,pin=36,dev=exp,line=inta,dir=out,open-drain=on,pull=up
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/i2c/i2c.h"
+#include "hw/irq.h"
+#include "qom/object.h"
+
+#define TYPE_MCP23017 "mcp23017"
+OBJECT_DECLARE_SIMPLE_TYPE(MCP23017State, MCP23017)
+
+enum {
+    IODIR, IPOL, GPINTEN, DEFVAL, INTCON, IOCON, GPPU, INTF, INTCAP, GPIO, OLAT, NREGS
+};
+
+#define IOCON_MIRROR    0x40
+#define IOCON_SEQOP     0x20
+#define IOCON_ODR       0x04
+#define IOCON_INTPOL    0x02
+
+struct MCP23017State {
+    I2CSlave parent_obj;
+
+    qemu_irq out[16];
+    qemu_irq inta, intb;
+    uint16_t reg[NREGS];        /* A in the low byte, B in the high byte */
+    uint16_t ext_driven, ext_level;
+    uint16_t level;             /* Each pin's level */
+    uint8_t ptr;
+    bool addr_next;
+};
+
+static uint16_t pin_levels(MCP23017State *s)
+{
+    uint16_t v = 0;
+    for (int n = 0; n < 16; n++) {
+        bool output = !((s->reg[IODIR] >> n) & 1);
+        int l;
+        if (output) {
+            l = (s->reg[OLAT] >> n) & 1;
+        } else if ((s->ext_driven >> n) & 1) {
+            l = (s->ext_level >> n) & 1;
+        } else {
+            l = (s->reg[GPPU] >> n) & 1;        /* Pulled up, or floating (reads 0) */
+        }
+        v |= l << n;
+    }
+    return v;
+}
+
+static void update_int(MCP23017State *s)
+{
+    bool a = s->reg[INTF] & 0x00FF, b = s->reg[INTF] & 0xFF00;
+    if (s->reg[IOCON] & IOCON_MIRROR) {
+        a = b = a || b;
+    }
+    bool pol = s->reg[IOCON] & IOCON_INTPOL;
+    if (s->reg[IOCON] & IOCON_ODR) {
+        /* Open drain: pulls low when active, else released */
+        qemu_set_irq(s->inta, a ? 0 : 1);
+        qemu_set_irq(s->intb, b ? 0 : 1);
+    } else {
+        qemu_set_irq(s->inta, a ? pol : !pol);
+        qemu_set_irq(s->intb, b ? pol : !pol);
+    }
+}
+
+static void update(MCP23017State *s)
+{
+    uint16_t old = s->level, now = pin_levels(s);
+    s->level = now;
+    for (int n = 0; n < 16; n++) {
+        int bit = 1 << n;
+        if ((old ^ now) & bit) {
+            qemu_set_irq(s->out[n], !!(now & bit));
+        }
+        if (!(s->reg[GPINTEN] & bit) || (s->reg[IODIR] & bit) == 0 || (s->reg[INTF] & bit)) {
+            continue;
+        }
+        bool fire = (s->reg[INTCON] & bit) ? ((now ^ s->reg[DEFVAL]) & bit) : ((old ^ now) & bit);
+        if (fire) {
+            s->reg[INTF] |= bit;
+            s->reg[INTCAP] = now;
+        }
+    }
+    update_int(s);
+}
+
+static uint8_t read_byte(MCP23017State *s, uint8_t a)
+{
+    int r = a >> 1, hi = a & 1;
+    uint16_t v;
+    if (r >= NREGS) {
+        return 0;
+    }
+    switch (r) {
+    case GPIO:
+        v = s->level ^ (s->reg[IPOL] & s->reg[IODIR]);
+        s->reg[INTF] &= hi ? 0x00FF : 0xFF00;      /* Reading the port clears its interrupt */
+        update(s);
+        break;
+    case INTCAP:
+        v = s->reg[INTCAP];
+        s->reg[INTF] &= hi ? 0x00FF : 0xFF00;
+        update(s);
+        break;
+    case IOCON:
+        v = s->reg[IOCON] | s->reg[IOCON] << 8;     /* One register, both addresses */
+        break;
+    default:
+        v = s->reg[r];
+    }
+    return hi ? v >> 8 : v & 0xFF;
+}
+
+static void write_byte(MCP23017State *s, uint8_t a, uint8_t b)
+{
+    int r = a >> 1, hi = a & 1;
+    if (r >= NREGS || r == INTF || r == INTCAP) {
+        return;
+    }
+    if (r == GPIO) {
+        r = OLAT;
+    }
+    if (r == IOCON) {
+        s->reg[IOCON] = b & 0xFE;
+    } else if (hi) {
+        s->reg[r] = (s->reg[r] & 0x00FF) | b << 8;
+    } else {
+        s->reg[r] = (s->reg[r] & 0xFF00) | b;
+    }
+    update(s);
+}
+
+static int mcp_event(I2CSlave *i2c, enum i2c_event event)
+{
+    MCP23017State *s = MCP23017(i2c);
+    if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
+        s->addr_next = true;
+    }
+    return 0;
+}
+
+static int mcp_send(I2CSlave *i2c, uint8_t b)
+{
+    MCP23017State *s = MCP23017(i2c);
+    if (s->addr_next) {
+        s->ptr = b % (NREGS * 2);
+        s->addr_next = false;
+        return 0;
+    }
+    write_byte(s, s->ptr, b);
+    if (!(s->reg[IOCON] & IOCON_SEQOP)) {
+        s->ptr = (s->ptr + 1) % (NREGS * 2);
+    }
+    return 0;
+}
+
+static uint8_t mcp_recv(I2CSlave *i2c)
+{
+    MCP23017State *s = MCP23017(i2c);
+    uint8_t v = read_byte(s, s->ptr);
+    if (!(s->reg[IOCON] & IOCON_SEQOP)) {
+        s->ptr = (s->ptr + 1) % (NREGS * 2);
+    }
+    return v;
+}
+
+static void mcp_pin_in(void *opaque, int n, int level)
+{
+    MCP23017State *s = MCP23017(opaque);
+    if (level == 0 || level == 1) {
+        s->ext_driven |= 1 << n;
+        s->ext_level = (s->ext_level & ~(1 << n)) | (level << n);
+    } else {
+        s->ext_driven &= ~(1 << n);
+    }
+    update(s);
+}
+
+static void mcp_reset(DeviceState *dev)
+{
+    MCP23017State *s = MCP23017(dev);
+    memset(s->reg, 0, sizeof(s->reg));
+    s->reg[IODIR] = 0xFFFF;
+    s->ptr = 0;
+    s->level = pin_levels(s);
+    update_int(s);
+}
+
+static void mcp_realize(DeviceState *dev, Error **errp)
+{
+    MCP23017State *s = MCP23017(dev);
+    qdev_init_gpio_in_named(dev, mcp_pin_in, "in", 16);
+    qdev_init_gpio_out_named(dev, s->out, "out", 16);
+    qdev_init_gpio_out_named(dev, &s->inta, "inta", 1);
+    qdev_init_gpio_out_named(dev, &s->intb, "intb", 1);
+}
+
+static void mcp_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = mcp_realize;
+    device_class_set_legacy_reset(dc, mcp_reset);
+    k->event = mcp_event;
+    k->send = mcp_send;
+    k->recv = mcp_recv;
+}
+
+static const TypeInfo mcp_info = {
+    .name = TYPE_MCP23017,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(MCP23017State),
+    .class_init = mcp_class_init,
+};
+
+static void mcp_register_types(void)
+{
+    type_register_static(&mcp_info);
+}
+
+type_init(mcp_register_types)
