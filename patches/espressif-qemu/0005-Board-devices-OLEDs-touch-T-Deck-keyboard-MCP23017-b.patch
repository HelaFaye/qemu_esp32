diff --git a/hw/input/tdeck_keyboard.c b/hw/input/tdeck_keyboard.c
new file mode 100644
index 0000000..5530d8d
--- /dev/null
+++ b/hw/input/tdeck_keyboard.c
@@ -0,0 +1,196 @@
+/*
+ * LilyGO T-Deck keyboard: an ESP32-C3 running LilyGO's Keyboard_ESP32C3 firmware as an
+ * I2C slave (0x55). A 1-byte read returns the next key's character, 0 when none;
+ * writes 0x01 <duty> and 0x02 <duty> set the backlight now and its Alt+B level.
+ *
+ * Keys come from the host keyboard (a window's) or, for tests, the QOM property "keys":
+ * a string whose characters are queued as keys ("\n" is Enter, 0x08 Backspace). "int"
+ * pulses low for each key queued; the T-Deck doesn't wire it, other boards may.
+ *
+ *   -device tdeck-keyboard,bus=i2c0,address=0x55,id=kbd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/i2c/i2c.h"
+#include "hw/irq.h"
+#include "ui/input.h"
+#include "qom/object.h"
+
+#define TYPE_TDECK_KEYBOARD "tdeck-keyboard"
+OBJECT_DECLARE_SIMPLE_TYPE(TDeckKeyboardState, TDECK_KEYBOARD)
+
+#define QUEUE_LEN 64
+
+struct TDeckKeyboardState {
+    I2CSlave parent_obj;
+
+    qemu_irq irq;
+    QEMUTimer *pulse;
+    uint8_t queue[QUEUE_LEN];
+    int head, count;
+    bool shift;
+    uint8_t cmd;
+    int nbytes;
+    uint8_t brightness, default_brightness;
+};
+
+static void push(TDeckKeyboardState *s, uint8_t c)
+{
+    if (s->count < QUEUE_LEN) {
+        s->queue[(s->head + s->count++) % QUEUE_LEN] = c;
+        qemu_set_irq(s->irq, 0);
+        timer_mod(s->pulse, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 100 * SCALE_US);
+    }
+}
+
+static void pulse_end(void *opaque)
+{
+    qemu_set_irq(TDECK_KEYBOARD(opaque)->irq, 1);
+}
+
+static int kb_event(I2CSlave *i2c, enum i2c_event event)
+{
+    TDeckKeyboardState *s = TDECK_KEYBOARD(i2c);
+    if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
+        s->nbytes = 0;
+    }
+    return 0;
+}
+
+static int kb_send(I2CSlave *i2c, uint8_t b)
+{
+    TDeckKeyboardState *s = TDECK_KEYBOARD(i2c);
+    if (s->nbytes++ == 0) {
+        s->cmd = b;
+    } else if (s->cmd == 0x01) {
+        s->brightness = b;
+    } else if (s->cmd == 0x02) {
+        s->default_brightness = b;
+    }
+    return 0;
+}
+
+static uint8_t kb_recv(I2CSlave *i2c)
+{
+    TDeckKeyboardState *s = TDECK_KEYBOARD(i2c);
+    if (!s->count) {
+        return 0;
+    }
+    uint8_t c = s->queue[s->head];
+    s->head = (s->head + 1) % QUEUE_LEN;
+    s->count--;
+    return c;
+}
+
+/* The host's keys to the characters the keyboard sends */
+static int qcode_char(int q, bool shift)
+{
+    static const char *letters = "abcdefghijklmnopqrstuvwxyz";
+    if (q >= Q_KEY_CODE_A && q <= Q_KEY_CODE_Z) {
+        /* QKeyCode letters are in alphabetical order */
+        int c = letters[q - Q_KEY_CODE_A];
+        return shift ? c - 32 : c;
+    }
+    if (q >= Q_KEY_CODE_1 && q <= Q_KEY_CODE_9) {
+        return shift ? "!@#$%^&*("[q - Q_KEY_CODE_1] : '1' + (q - Q_KEY_CODE_1);
+    }
+    switch (q) {
+    case Q_KEY_CODE_0:          return shift ? ')' : '0';
+    case Q_KEY_CODE_SPC:        return ' ';
+    case Q_KEY_CODE_RET:        return '\r';
+    case Q_KEY_CODE_BACKSPACE:  return 0x08;
+    case Q_KEY_CODE_DOT:        return shift ? '>' : '.';
+    case Q_KEY_CODE_COMMA:      return shift ? '<' : ',';
+    case Q_KEY_CODE_MINUS:      return shift ? '_' : '-';
+    case Q_KEY_CODE_EQUAL:      return shift ? '+' : '=';
+    case Q_KEY_CODE_SLASH:      return shift ? '?' : '/';
+    case Q_KEY_CODE_SEMICOLON:  return shift ? ':' : ';';
+    case Q_KEY_CODE_APOSTROPHE: return shift ? '"' : '\'';
+    case Q_KEY_CODE_ESC:        return 0x1B;
+    default:                    return -1;
+    }
+}
+
+static void kb_input_event(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    TDeckKeyboardState *s = TDECK_KEYBOARD(dev);
+    if (evt->type != INPUT_EVENT_KIND_KEY) {
+        return;
+    }
+    InputKeyEvent *key = evt->u.key.data;
+    int q = qemu_input_key_value_to_qcode(key->key);
+    if (q == Q_KEY_CODE_SHIFT || q == Q_KEY_CODE_SHIFT_R) {
+        s->shift = key->down;
+        return;
+    }
+    if (key->down) {
+        int c = qcode_char(q, s->shift);
+        if (c >= 0) {
+            push(s, c);
+        }
+    }
+}
+
+static const QemuInputHandler kb_handler = {
+    .name = "T-Deck keyboard",
+    .mask = INPUT_EVENT_MASK_KEY,
+    .event = kb_input_event,
+};
+
+static void set_type(Object *obj, const char *str, Error **errp)
+{
+    TDeckKeyboardState *s = TDECK_KEYBOARD(obj);
+    for (const char *p = str; *p; p++) {
+        push(s, *p == '\n' ? '\r' : (uint8_t)*p);
+    }
+}
+
+static void kb_instance_init(Object *obj)
+{
+    object_property_add_str(obj, "keys", NULL, set_type);
+    object_property_add_uint8_ptr(obj, "brightness", &TDECK_KEYBOARD(obj)->brightness,
+                                  OBJ_PROP_FLAG_READ);
+}
+
+static void kb_realize(DeviceState *dev, Error **errp)
+{
+    TDeckKeyboardState *s = TDECK_KEYBOARD(dev);
+    qdev_init_gpio_out_named(dev, &s->irq, "int", 1);
+    s->pulse = timer_new_ns(QEMU_CLOCK_VIRTUAL, pulse_end, s);
+    qemu_input_handler_register(dev, &kb_handler);
+    s->brightness = 127;
+    s->default_brightness = 127;
+}
+
+static void kb_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = kb_realize;
+    k->event = kb_event;
+    k->send = kb_send;
+    k->recv = kb_recv;
+    set_bit(DEVICE_CATEGORY_INPUT, dc->categories);
+}
+
+static const TypeInfo kb_info = {
+    .name = TYPE_TDECK_KEYBOARD,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(TDeckKeyboardState),
+    .instance_init = kb_instance_init,
+    .class_init = kb_class_init,
+};
+
+static void kb_register_types(void)
+{
+    type_register_static(&kb_info);
+}
+
+type_init(kb_register_types)
